# metamodel_version: 1.11.0
BASE <https://w3id.org/anvilproject/acr-harmonized-data-model/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX cam: <https://includedcc.org/common-access-model/>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX snomedct: <http://snomed.info/id/>


cam:PtGlobalID xsd:string

cam:ObGlobalID xsd:string

cam:LsGlobalID xsd:string

cam:OrGlobalID xsd:string

cam:GrGlobalID xsd:string

cam:SdGlobalID xsd:string

cam:DeGlobalID xsd:string

cam:BsGlobalID xsd:string

cam:AdGlobalID xsd:string

cam:DrGlobalID xsd:string

cam:EnGlobalID xsd:string

cam:CoGlobalID xsd:string

cam:DiGlobalID xsd:string

cam:FmGlobalID xsd:string

cam:PdGlobalID xsd:string

cam:MsGlobalID xsd:string

cam:String xsd:string

cam:Integer xsd:integer

cam:Boolean xsd:boolean

cam:Float xsd:float

cam:Double xsd:double

cam:Decimal xsd:decimal

cam:Time xsd:time

cam:Date xsd:date

cam:Datetime xsd:dateTime

cam:DateOrDatetime linkml:DateOrDatetime

cam:Uriorcurie IRI

cam:Curie xsd:string

cam:Uri IRI

cam:Ncname xsd:string

cam:Objectidentifier IRI

cam:Nodeidentifier NONLITERAL

cam:Jsonpointer xsd:string

cam:Jsonpath xsd:string

cam:Sparqlpath xsd:string

cam:AccessPolicy CLOSED {
    (  $cam:AccessPolicy_tes (  cam:data_use_accession @cam:Uriorcurie ? ;
          cam:data_use_permission [ <http://purl.obolibrary.org/obo/DUO_0000004> <http://purl.obolibrary.org/obo/DUO_0000006>
             <http://purl.obolibrary.org/obo/DUO_0000007> <http://purl.obolibrary.org/obo/DUO_0000011>
             <http://purl.obolibrary.org/obo/DUO_0000042> ] ;
          cam:data_use_modifier [ <http://purl.obolibrary.org/obo/DUO_00000044> <http://purl.obolibrary.org/obo/DUO_0000012>
             <http://purl.obolibrary.org/obo/DUO_0000015> <http://purl.obolibrary.org/obo/DUO_0000016>
             <http://purl.obolibrary.org/obo/DUO_0000018> <http://purl.obolibrary.org/obo/DUO_0000019>
             <http://purl.obolibrary.org/obo/DUO_0000020> <http://purl.obolibrary.org/obo/DUO_0000021>
             <http://purl.obolibrary.org/obo/DUO_0000022> <http://purl.obolibrary.org/obo/DUO_0000024>
             <http://purl.obolibrary.org/obo/DUO_0000025> <http://purl.obolibrary.org/obo/DUO_0000026>
             <http://purl.obolibrary.org/obo/DUO_0000027> <http://purl.obolibrary.org/obo/DUO_0000028>
             <http://purl.obolibrary.org/obo/DUO_0000029> <http://purl.obolibrary.org/obo/DUO_0000043>
             <http://purl.obolibrary.org/obo/DUO_0000045> <http://purl.obolibrary.org/obo/DUO_0000046> ] ? ;
          cam:disease_limitation @cam:String ? ;
          cam:access_description @cam:String ? ;
          cam:website @cam:Uri ?
       ) ;
       rdf:type [ cam:AccessPolicy ]
    )
}

cam:ActivityDefinition CLOSED {
    (  $cam:ActivityDefinition_tes (  &cam:Record_tes ;
          rdf:type [ cam:Record ] ? ;
          cam:name @cam:String ? ;
          cam:description @cam:String ? ;
          cam:external_id @cam:Uriorcurie * ;
          cam:access_policy_id @cam:AccessPolicy ? ;
          cam:study_id @cam:Study ?
       ) ;
       rdf:type [ cam:ActivityDefinition ]
    )
}

cam:Aliquot CLOSED {
    (  $cam:Aliquot_tes (  &cam:Record_tes ;
          rdf:type [ cam:Record ] ? ;
          cam:sample_id @cam:Sample ? ;
          cam:availability_status [ snomedct:103328004 snomedct:103329007 ] ? ;
          cam:quantity_number @cam:Float ? ;
          cam:quantity_unit @cam:Concept ? ;
          cam:concentration_number @cam:Float ? ;
          cam:concentration_unit @cam:Concept ? ;
          cam:external_id @cam:Uriorcurie * ;
          cam:access_policy_id @cam:AccessPolicy ? ;
          cam:study_id @cam:Study ?
       ) ;
       rdf:type [ cam:Aliquot ]
    )
}

cam:Any CLOSED {
    (  $cam:Any_tes rdf:type . * ;
       rdf:type [ linkml:Any ] ?
    )
}

