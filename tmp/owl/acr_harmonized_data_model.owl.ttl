cam:ActivityDefinition a owl:Class ;
    rdfs:label "ActivityDefinition" ;
    dcterms:title "Activity Definition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:name ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:name ],
        linkml:ClassDefinition ;
    skos:definition "A definition of an activity in this study, eg, a biospecimen collection, assay, intervention, survey, or assessment." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:DOI a owl:Class ;
    rdfs:label "DOI" ;
    dcterms:title "Digital Object Identifier (DOI)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:bibliographic_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:bibliographic_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:do_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:bibliographic_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:do_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:do_id ],
        linkml:ClassDefinition ;
    skos:definition "A DOI is a permanent reference with metadata about a digital object." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:Encounter a owl:Class ;
    rdfs:label "Encounter" ;
    dcterms:title "Participant Encounter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:age_at_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:encounter_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:age_at_event ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:age_at_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:encounter_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:EncounterDefinition ;
            owl:onProperty cam:encounter_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        linkml:ClassDefinition ;
    skos:definition "An event at which data was collected about a participant, an intervention was made, or information about a participant was recorded." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:File a owl:Class ;
    rdfs:label "File" ;
    dcterms:title "File" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:filename ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:storage_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cam:internal_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:data_category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:internal_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:availability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:format ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:file_extension ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cam:release_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:hash ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumEDAMFormats ;
            owl:onProperty cam:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:file_extension ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:drs_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cam:drs_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:filename ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:release_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:filename ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:file_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:file_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumDataCategory ) ] cam:Concept ) ] ;
            owl:onProperty cam:data_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:drs_uri ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:availability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:data_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Sample ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumEDAMDataTypes ;
            owl:onProperty cam:data_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:storage_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:release_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:storage_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumAvailabilityStatus ;
            owl:onProperty cam:availability ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:file_extension ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:FileHash ;
            owl:onProperty cam:hash ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:file_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:internal_uri ],
        linkml:ClassDefinition ;
    skos:definition "File" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:Publication a owl:Class ;
    rdfs:label "Publication" ;
    dcterms:title "Publication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:website ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:bibliographic_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cam:website ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:website ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:bibliographic_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:bibliographic_reference ],
        linkml:ClassDefinition ;
    skos:definition "Information about a specific publication." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:access_description a owl:DatatypeProperty ;
    rdfs:label "access_description" ;
    dcterms:title "Access Description" ;
    rdfs:range xsd:string ;
    skos:definition "Any additional information to support access requests." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:acknowledgments a owl:DatatypeProperty ;
    rdfs:label "acknowledgments" ;
    dcterms:title "Acknowledgments" ;
    rdfs:range xsd:string ;
    skos:definition "Funding statement and acknowledgments for this study" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:actual_number_of_participants a owl:DatatypeProperty ;
    rdfs:label "actual_number_of_participants" ;
    dcterms:title "Actual Number of Participants" ;
    rdfs:range xsd:integer ;
    skos:definition "Total participants included at this time." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:age_at_assertion a owl:DatatypeProperty ;
    rdfs:label "age_at_assertion" ;
    dcterms:title "Age at assertion" ;
    rdfs:range xsd:integer ;
    skos:definition "The age in days of the Subject when the assertion was made." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:age_at_collection a owl:DatatypeProperty ;
    rdfs:label "age_at_collection" ;
    dcterms:title "Age at Biospecimen Collection" ;
    rdfs:range xsd:float ;
    skos:definition "The age at which this biospecimen was collected in decimal years." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:age_at_first_engagement a owl:DatatypeProperty ;
    rdfs:label "age_at_first_engagement" ;
    dcterms:title "Age at First Participant Engagement" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive -365 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 32507 ] ) ] ) ] ;
    skos:definition "Age in days of Participant at first recorded study event (enrollment, visit, observation, sample collection, survey completion, etc.). Age at enrollment is preferred, if available." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:age_at_last_vital_status a owl:DatatypeProperty ;
    rdfs:label "age_at_last_vital_status" ;
    dcterms:title "Age at Last Vital Status" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive -365 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 32507 ] ) ] ) ] ;
    skos:definition "Age in days when participant's vital status was last recorded" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:age_at_resolution a owl:DatatypeProperty ;
    rdfs:label "age_at_resolution" ;
    dcterms:title "Age at resolution" ;
    rdfs:range xsd:integer ;
    skos:definition "The age in days of the Subject when the asserted state was resolved." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:aliquot_id a owl:ObjectProperty ;
    rdfs:label "aliquot_id" ;
    dcterms:title "Aliquot ID" ;
    rdfs:range cam:Aliquot ;
    skos:definition "Unique identifier for an Aliquot." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:assay_id a owl:ObjectProperty ;
    rdfs:label "assay_id" ;
    dcterms:title "Assay ID" ;
    rdfs:range cam:Assay ;
    skos:definition "The unique identifier for the Assay." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:assay_source a owl:DatatypeProperty ;
    rdfs:label "assay_source" ;
    dcterms:title "Assay Source Text" ;
    rdfs:range xsd:string ;
    skos:definition "The original description of the Assay performed." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:assay_type a owl:ObjectProperty ;
    rdfs:label "assay_type" ;
    dcterms:title "Assay Type" ;
    rdfs:range acr_harmonized_data_model:EnumAssayType ;
    skos:definition "The type of assay performed." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:asserter_type a owl:ObjectProperty ;
    rdfs:label "asserter_type" ;
    dcterms:title "Asserter Type" ;
    rdfs:range acr_harmonized_data_model:EnumAsserterType ;
    skos:definition "The original asserter of this information" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:assertion_id a owl:ObjectProperty ;
    rdfs:label "assertion_id" ;
    dcterms:title "Assertion ID" ;
    rdfs:range cam:SubjectAssertion ;
    skos:definition "INCLUDE Global ID for the Assertion" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:assertion_source_type a owl:ObjectProperty ;
    rdfs:label "assertion_source_type" ;
    dcterms:title "Assertion Source" ;
    rdfs:range acr_harmonized_data_model:EnumDataSourceType ;
    skos:definition "The source of this assertion from the original data" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:availability a owl:ObjectProperty ;
    rdfs:label "availability" ;
    dcterms:title "File Availability" ;
    rdfs:range acr_harmonized_data_model:EnumAvailabilityStatus ;
    skos:definition "Is or was this file available to users?" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:citation_statement a owl:DatatypeProperty ;
    rdfs:label "citation_statement" ;
    dcterms:title "Citation Statement" ;
    rdfs:range xsd:string ;
    skos:definition "Statement that secondary data users should use to acknowledge use of this study or dataset. E.g., \"The results analyzed and <published or shown> here are based in whole or in part upon data generated by the INCLUDE (INvestigation of Co-occurring conditions across the Lifespan to Understand Down syndromeE) Project <insert accession number(s) and/or study DOI(s)>, and were accessed from the INCLUDE Data Hub and <insert other database(s)>.\"" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:concentration_number a owl:DatatypeProperty ;
    rdfs:label "concentration_number" ;
    dcterms:title "Concentration" ;
    rdfs:range xsd:float ;
    skos:definition "What is the concentration of the analyte in the Aliquot?" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:concentration_unit a owl:ObjectProperty ;
    rdfs:label "concentration_unit" ;
    dcterms:title "Concentration Units" ;
    rdfs:range cam:Concept ;
    skos:definition "Units associated with the concentration of the analyte in the Aliquot." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:concept_curie a owl:DatatypeProperty ;
    rdfs:label "concept_curie" ;
    dcterms:title "Concept Curie" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The standardized curie for the term." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:concept_source a owl:DatatypeProperty ;
    rdfs:label "concept_source" ;
    dcterms:title "Concept Source Text" ;
    rdfs:range xsd:string ;
    skos:definition "The source text yielding the standardized concept." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:consanguinity a owl:ObjectProperty ;
    rdfs:label "consanguinity" ;
    rdfs:range acr_harmonized_data_model:EnumPresentAbsent ;
    skos:definition "Is there known or suspected consanguinity in this study family?" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_collection_end a owl:DatatypeProperty ;
    rdfs:label "data_collection_end" ;
    dcterms:title "Data Collection End" ;
    rdfs:range xsd:string ;
    skos:definition "The date that data collection started. May include only a year." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_collection_start a owl:DatatypeProperty ;
    rdfs:label "data_collection_start" ;
    dcterms:title "Data Collection Start" ;
    rdfs:range xsd:string ;
    skos:definition "The date that data collection started. May include only a year." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_type a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    dcterms:title "Data Type" ;
    rdfs:range acr_harmonized_data_model:EnumEDAMDataTypes ;
    skos:definition "The type of data within this file." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_use_accession a owl:DatatypeProperty ;
    rdfs:label "data_use_accession" ;
    dcterms:title "Data Use Accession" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Accession used to provision access to the record, eg, a dbGaP phsID." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_use_modifier a owl:ObjectProperty ;
    rdfs:label "data_use_modifier" ;
    dcterms:title "Data Use Modifier" ;
    rdfs:range acr_harmonized_data_model:EnumDataUseModifier ;
    skos:definition "Additional modifiers that limit data use." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:data_use_permission a owl:ObjectProperty ;
    rdfs:label "data_use_permission" ;
    dcterms:title "Data Use Permission" ;
    rdfs:range acr_harmonized_data_model:EnumDataUsePermission ;
    skos:definition "Broad category of restrictions on data use." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:dataset_id a owl:ObjectProperty ;
    rdfs:label "dataset_id" ;
    dcterms:title "Dataset ID" ;
    rdfs:range cam:Dataset ;
    skos:definition "Unique identifier for a Dataset." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:disease_limitation a owl:DatatypeProperty ;
    rdfs:label "disease_limitation" ;
    dcterms:title "Data Use Disease Limitation" ;
    rdfs:range xsd:string ;
    skos:definition "If the access is limited to a specific disease purpose, it is specified here." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:display a owl:DatatypeProperty ;
    rdfs:label "display" ;
    dcterms:title "Display String" ;
    rdfs:range xsd:string ;
    skos:definition "The friendly display string of the coded term." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:drs_uri a owl:DatatypeProperty ;
    rdfs:label "drs_uri" ;
    dcterms:title "DRS URI" ;
    rdfs:range xsd:anyURI ;
    skos:definition "DRS location to access the data." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    dcterms:title "Email Address" ;
    rdfs:range xsd:string ;
    skos:definition "An email address to reach the entity." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:ethnicity a owl:ObjectProperty ;
    rdfs:label "ethnicity" ;
    dcterms:title "Ethnicity" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumEthnicity acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
    skos:definition "Ethnicity of Participant" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:expected_number_of_participants a owl:DatatypeProperty ;
    rdfs:label "expected_number_of_participants" ;
    dcterms:title "Expected Number of Participants" ;
    rdfs:range xsd:integer ;
    skos:definition "Total expected number of participants to be recruited." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_description a owl:DatatypeProperty ;
    rdfs:label "family_description" ;
    rdfs:range xsd:string ;
    skos:definition "Free text describing the study family, such as potential inheritance or details about consanguinity" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_member_id a owl:ObjectProperty ;
    rdfs:label "family_member_id" ;
    rdfs:range cam:Subject ;
    skos:definition "The family member Subject who is the relationship \"subject\"." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_membership_id a owl:ObjectProperty ;
    rdfs:label "family_membership_id" ;
    dcterms:title "Family Relationship ID" ;
    rdfs:range cam:FamilyMembership ;
    skos:definition "ID for the Family Relationship" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_relationship_id a owl:ObjectProperty ;
    rdfs:label "family_relationship_id" ;
    dcterms:title "Family Relationship ID" ;
    rdfs:range cam:FamilyRelationship ;
    skos:definition "Global ID for the Family Relationship" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_role a owl:ObjectProperty ;
    rdfs:label "family_role" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumFamilyRole ) ] cam:Concept ) ] ;
    skos:definition "The \"role\" of this individual in this family. Could include terms like \"proband\", \"mother\", etc." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_study_focus a owl:DatatypeProperty ;
    rdfs:label "family_study_focus" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The specific focus of the investigation, eg, a condition." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:family_type a owl:ObjectProperty ;
    rdfs:label "family_type" ;
    rdfs:range acr_harmonized_data_model:EnumFamilyType ;
    skos:definition "Describes the 'type' of study family, eg, trio." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:file_extension a owl:DatatypeProperty ;
    rdfs:label "file_extension" ;
    dcterms:title "File Extension" ;
    rdfs:range xsd:string ;
    skos:definition "Typically a 3-4 letter code at the end of a filename that identifies the file format. Empty string for no extension." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:filename a owl:DatatypeProperty ;
    rdfs:label "filename" ;
    dcterms:title "Filename" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the file." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:format a owl:ObjectProperty ;
    rdfs:label "format" ;
    dcterms:title "File Format" ;
    rdfs:range acr_harmonized_data_model:EnumEDAMFormats ;
    skos:definition "The format of the file." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:hash_type a owl:ObjectProperty ;
    rdfs:label "hash_type" ;
    dcterms:title "File Hash Type" ;
    rdfs:range acr_harmonized_data_model:EnumFileHashType ;
    skos:definition "The type of file hash, eg, md5" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:hash_value a owl:DatatypeProperty ;
    rdfs:label "hash_value" ;
    dcterms:title "File Hash Value" ;
    rdfs:range xsd:string ;
    skos:definition "The value of the file hash" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:internal_uri a owl:DatatypeProperty ;
    rdfs:label "internal_uri" ;
    dcterms:title "Internal Staging Location" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI/URL for internal access to the data. May be temporary." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:investigator_title a owl:DatatypeProperty ;
    rdfs:label "investigator_title" ;
    dcterms:title "Investigator Title" ;
    rdfs:range xsd:string ;
    skos:definition "The title of the Investigator, eg, \"Assistant Professor\"" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:laterality a owl:ObjectProperty ;
    rdfs:label "laterality" ;
    dcterms:title "Location Laterality" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumLaterality ) ] cam:Concept ) ] ;
    skos:definition "Laterality that further refine the specific location of biospecimen collection" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:method a owl:ObjectProperty ;
    rdfs:label "method" ;
    dcterms:title "Biospecimen Collection Method" ;
    rdfs:range acr_harmonized_data_model:EnumSampleCollectionMethod ;
    skos:definition "The approach used to collect the biospecimen." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:organism_type a owl:DatatypeProperty ;
    rdfs:label "organism_type" ;
    dcterms:title "Organism Type" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( xsd:anyURI acr_harmonized_data_model:EnumOrganism ) ] xsd:anyURI ) ] ;
    skos:definition "Organism Type, typically from NCBITaxon." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:parent_sample_id a owl:ObjectProperty ;
    rdfs:label "parent_sample_id" ;
    dcterms:title "Parent Sample ID" ;
    rdfs:range cam:Sample ;
    skos:definition "Sample from which this sample is derived" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:parent_study a owl:ObjectProperty ;
    rdfs:label "parent_study" ;
    dcterms:title "Parent Study" ;
    rdfs:range cam:Study ;
    skos:definition "The parent study for this study, if it is a nested study." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:relation a owl:ObjectProperty ;
    rdfs:label "relation" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumFamilyRelation acr_harmonized_data_model:EnumUnknown ) ] cam:Concept ) ] ;
    skos:definition "Code definting the relationship predicate. Relationship of the \"Family Member\" to the \"Subject\", eg, mother of. Ideally uses KIN ontology." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:release_uri a owl:DatatypeProperty ;
    rdfs:label "release_uri" ;
    dcterms:title "Release Location" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI/URL for controlled or open access to the data." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:sample_type a owl:DatatypeProperty ;
    rdfs:label "sample_type" ;
    dcterms:title "Sample Type" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Type of material of which this Sample is comprised. UBERON is recommended." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:selection_criteria a owl:DatatypeProperty ;
    rdfs:label "selection_criteria" ;
    dcterms:title "Selection Criteria" ;
    rdfs:range xsd:string ;
