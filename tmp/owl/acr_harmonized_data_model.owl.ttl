OBI:0003226 a owl:Class ;
    rdfs:label "OBI:0003226" ;
    dcterms:title "total lymphocyte count assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A lymphocyte assay that measures the number of lymphocytes and large unstained cells in a specimen." .

OBI:0003227 a owl:Class ;
    rdfs:label "OBI:0003227" ;
    dcterms:title "total lymphocyte percentage assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A lymphocyte assay that measures the percentage of lymphocytes and large unstained cells in a specimen." .

OBI:0003228 a owl:Class ;
    rdfs:label "OBI:0003228" ;
    dcterms:title "fluorescent immunospot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that detects the presence of cells that secrete a material of interest (analyte). In the assay, a plate is coated with an antibody specific to the analyte of interest. These antibodies capture the analytes secreted by the cells. The analytes are then detected using fluorescent labeled secondary antibodies." .

OBI:0003229 a owl:Class ;
    rdfs:label "OBI:0003229" ;
    dcterms:title "plasma proteomics assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A proteomics profiling assay that detects proteins in a blood plasma specimen." .

OBI:0003230 a owl:Class ;
    rdfs:label "OBI:0003230" ;
    dcterms:title "T cell activation induced marker assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A flow cytometry assay that detects the presence/amount of antigen-specific T cells without the need to identify their cytokine production. Instead, antigen-specific T cells are detected on the basis of upregulation of TCR stimulation-induced surface markers." .

OBI:0003232 a owl:Class ;
    rdfs:label "OBI:0003232" ;
    dcterms:title "cerebrospinal fluid assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a cerebrospinal fluid specimen as evaluant." .

OBI:0003233 a owl:Class ;
    rdfs:label "OBI:0003233" ;
    dcterms:title "endotracheal aspirate assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has an endotracheal aspirate specimen as evaluant." .

OBI:0003234 a owl:Class ;
    rdfs:label "OBI:0003234" ;
    dcterms:title "induced sputum assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has an induced sputum specimen as evaluant." .

OBI:0003235 a owl:Class ;
    rdfs:label "OBI:0003235" ;
    dcterms:title "lung assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a lung specimen as evaluant." .

OBI:0003236 a owl:Class ;
    rdfs:label "OBI:0003236" ;
    dcterms:title "milk assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a milk specimen as evaluant." .

OBI:0003237 a owl:Class ;
    rdfs:label "OBI:0003237" ;
    dcterms:title "feces assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a feces specimen as evaluant." .

OBI:0003238 a owl:Class ;
    rdfs:label "OBI:0003238" ;
    dcterms:title "umbilical cord blood assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has an umbilical cord blood specimen as evaluant." .

OBI:0003239 a owl:Class ;
    rdfs:label "OBI:0003239" ;
    dcterms:title "saliva assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a saliva specimen as evaluant." .

OBI:0003240 a owl:Class ;
    rdfs:label "OBI:0003240" ;
    dcterms:title "cerebrospinal fluid microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a cerebrospinal fluid specimen." .

OBI:0003241 a owl:Class ;
    rdfs:label "OBI:0003241" ;
    dcterms:title "endotracheal tube aspirate microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in an endotracheal aspirate specimen." .

OBI:0003242 a owl:Class ;
    rdfs:label "OBI:0003242" ;
    dcterms:title "induced sputum microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in an induced sputum specimen." .

OBI:0003282 a owl:Class ;
    rdfs:label "OBI:0003282" ;
    dcterms:title "lung microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a lung specimen." .

OBI:0003283 a owl:Class ;
    rdfs:label "OBI:0003283" ;
    dcterms:title "pleural fluid microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a pleural fluid specimen." .

OBI:0003284 a owl:Class ;
    rdfs:label "OBI:0003284" ;
    dcterms:title "umbilical cord blood microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in an umbilical cord blood specimen." .

OBI:0003285 a owl:Class ;
    rdfs:label "OBI:0003285" ;
    dcterms:title "nasopharyngeal or oropharyngeal swab microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a nasopharyngeal or oropharyngeal swab specimen." .

OBI:0003286 a owl:Class ;
    rdfs:label "OBI:0003286" ;
    dcterms:title "urine microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a urine specimen." .

OBI:0003287 a owl:Class ;
    rdfs:label "OBI:0003287" ;
    dcterms:title "multiplex real time polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A real time polymerase chain reaction assay in which multiple DNA sequences are amplified in a single cycle." .

OBI:0003288 a owl:Class ;
    rdfs:label "OBI:0003288" ;
    dcterms:title "multiplex real time reverse-transcription polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A real time reverse-transcription polymerase chain reaction assay in which multiple DNA sequences are amplified in a single cycle." .

OBI:0003290 a owl:Class ;
    rdfs:label "OBI:0003290" ;
    dcterms:title "mosquito membrane feeding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that evaluates host-to-mosquito transmission of a parasite organism by feeding a specimen of host blood infected with the parasite organism to a collection of mosquitoes through a mosquito membrane feeding device and, after a given time, dissecting the mosquitoes and counting the number of parasite organisms within them." .

OBI:0003292 a owl:Class ;
    rdfs:label "OBI:0003292" ;
    dcterms:title "cytometric bead array assay measuring epitope specific granulysin release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects epitope specific granulysin release by T cells." .

OBI:0003293 a owl:Class ;
    rdfs:label "OBI:0003293" ;
    dcterms:title "cytometric bead array assay measuring epitope specific perforin release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects epitope specific perforin release by T cells." .

OBI:0003294 a owl:Class ;
    rdfs:label "OBI:0003294" ;
    dcterms:title "modified acid-fast stain microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A microscopy assay that uses staining to identify acid-fast organisms in a specimen and does not require heating." .

OBI:0003296 a owl:Class ;
    rdfs:label "OBI:0003296" ;
    dcterms:title "antibodies from lymphocyte secretions assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that evaluates a blood specimen for antibodies currently being produced by lymphocytes in the specimen, by separating peripheral blood mononuclear cells, culturing them, and then collecting the supernatant containing the antibodies secreted from those cells." .

OBI:0003297 a owl:Class ;
    rdfs:label "OBI:0003297" ;
    dcterms:title "tyramide signal amplification sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that uses tyramide signal amplification (TSA) to assess distance of DNA regions to a targeted nuclear compartment or protein, typically on a scale of 100-1000 nm." .

OBI:0003298 a owl:Class ;
    rdfs:label "OBI:0003298" ;
    dcterms:title "DNA adenine methyltransferase identification assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay for identifying DNA binding sites for a protein by fusing it to Dam methylase, and expressing it so that bound DNA gets methylated. The methylated DNA can then be isolated and analyzed." .

OBI:0003299 a owl:Class ;
    rdfs:label "OBI:0003299" ;
    dcterms:title "DamID-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA adenine methyltransferase identification (DamID) assay in which DamID-generated DNA fragments undergo high-throughput sequencing to determine a protein's DNA-binding site." .

OBI:0003300 a owl:Class ;
    rdfs:label "OBI:0003300" ;
    dcterms:title "nucleolus-associated domain sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay in which nucleoli are isolated and the DNA associated with them is sequenced to identify nucleoli-associating domains." .

OBI:0003301 a owl:Class ;
    rdfs:label "OBI:0003301" ;
    dcterms:title "DNase Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay in which DNase I is used for digesting DNA fragments rather than a restriction enzyme, which can result in a higher resolution of mapped chromosome contacts." .

OBI:0003302 a owl:Class ;
    rdfs:label "OBI:0003302" ;
    dcterms:title "micro-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay which uses micrococcal nuclease digestion in place of the restriction enzyme digestion step." .

OBI:0003303 a owl:Class ;
    rdfs:label "OBI:0003303" ;
    dcterms:title "single cell combinatorial indexing Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay performed on massively multiplexed single-cell samples." .

OBI:0003304 a owl:Class ;
    rdfs:label "OBI:0003304" ;
    dcterms:title "single nucleus Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay performed on isolated nuclei." .

OBI:0003305 a owl:Class ;
    rdfs:label "OBI:0003305" ;
    dcterms:title "single cell Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay performed on a single cell." .

OBI:0003306 a owl:Class ;
    rdfs:label "OBI:0003306" ;
    dcterms:title "bulk Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay in which the sample that is sequenced is derived from a collection of cells, such as a tissue sample or entire cell culture, and therefore provides results representative of the aggregate of sample cells." .

OBI:0003307 a owl:Class ;
    rdfs:label "OBI:0003307" ;
    dcterms:title "multi-contact Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay that assesses interactions between multiple DNA fragments rather than only pairwise interactions as in traditional Hi-C. The experimental procedure of cross-linking, digestion, and ligation is performed similarly to traditional Hi-C, but after DNA is purified a long-read library is produced in which many ligated fragments may be contained in a single molecule. The library is then sequenced on a long read sequencer." .

OBI:0003309 a owl:Class ;
    rdfs:label "OBI:0003309" ;
    dcterms:title "transposase-mediated analysis of chromatin looping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay designed to detect interacting genomic regions. Rather than the traditional Hi-C approach of digestion and proximity ligation, the procedure involves transposase-mediated insertion of an oligonucleotide linker between the pair of interacting regions." .

OBI:0003310 a owl:Class ;
    rdfs:label "OBI:0003310" ;
    dcterms:title "split-pool recognition of interactions and tag extension assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay designed to detect multi-way interactions between nucleic acids. The procedure involves crosslinking nuclei, and then splitting the lysate among wells in a 96-well or other multi-well plate. A different barcode is ligated to the fragments in each well, and the lysates are pooled together again. This sequence of splitting, tagging, and re-combining is repeated several times so that fragments with the same sequences of barcodes represent fragments that have co-associated throughout the experiment. Finally, a sequencing library is constructed and high-throughput sequencing is performed." .

OBI:0003311 a owl:Class ;
    rdfs:label "OBI:0003311" ;
    dcterms:title "DNA split-pool recognition of interactions and tag extension assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A split-pool recognition of interactions and tag extension (SPRITE) assay that only assays interactions between regions of genomic DNA." .

OBI:0003312 a owl:Class ;
    rdfs:label "OBI:0003312" ;
    dcterms:title "RNA-DNA split-pool recognition of interactions and tag extension assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A split-pool recognition of interactions and tag extension (SPRITE) assay in which RNA in the cross-linked complexes is converted to cDNA before the initial splitting step, allowing analysis of RNA-DNA interactions." .

OBI:0003313 a owl:Class ;
    rdfs:label "OBI:0003313" ;
    dcterms:title "genome architecture mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay designed to analyze 3D chromatin structure without relying on digestion and ligation. The procedure involves cryosectioning samples in random orientation, and then single nuclear profiles are isolated by laser microdissection. Each nuclear profile then undergoes high-throughput sequencing, and subsequent analysis can generate a matrix of inferred proximity between genomic regions." .

OBI:0003314 a owl:Class ;
    rdfs:label "OBI:0003314" ;
    dcterms:title "mapping RNA-genome interactions assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A nuclear ligation assay for probing RNA-DNA interactions in the nucleus. Nuclei are crosslinked, and RNA fragments are ligated to proximal DNA fragments via a special linker molecule. After reverse transcription, high-throughput sequencing is performed." .

OBI:0003315 a owl:Class ;
    rdfs:label "OBI:0003315" ;
    dcterms:title "assay measuring epitope specific amphiregulin production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects amphiregulin production by T cells." .

OBI:0003316 a owl:Class ;
    rdfs:label "OBI:0003316" ;
    dcterms:title "ELISA measuring epitope specific amphiregulin production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzyme-linked immunosorbent assay that detects amphiregulin production by T cells." .

OBI:0003321 a owl:Class ;
    rdfs:label "OBI:0003321" ;
    dcterms:title "venous blood microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A blood microbiology assay that detects a microorganism in a venous blood specimen." .

OBI:0003323 a owl:Class ;
    rdfs:label "OBI:0003323" ;
    dcterms:title "high throughput multiplexed assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope assay that measures the binding of an antibody receptor to an epitope using a high throughput multiplexed assay." .

OBI:0003324 a owl:Class ;
    rdfs:label "OBI:0003324" ;
    dcterms:title "high throughput multiplexed assay measuring binding of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope assay that measures the binding of T cell receptor to an epitope using a high throughput multiplexed assay." .

OBI:0003325 a owl:Class ;
    rdfs:label "OBI:0003325" ;
    dcterms:title "high throughput multiplexed assay measuring binding of a MHC:ligand complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A MHC ligand assay that detects the binding of a ligand to an MHC molecule using a high throughput multiplexed assay." .

OBI:0003326 a owl:Class ;
    rdfs:label "OBI:0003326" ;
    dcterms:title "high throughput multiplexed assay measuring MHC ligand processing and presentation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A MHC ligand assay that determines what ligands are processed and loaded onto MHC molecules by eluting ligands and identifying them using a high throughput multiplexed assay." .

OBI:0003368 a owl:Class ;
    rdfs:label "OBI:0003368" ;
    dcterms:title "detection technique" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay (A) that is part of another assay (B), where the target entities of A and B are disjoint, and the target entity of A is a proxy for the target of assay B." .

OBI:0003372 a owl:Class ;
    rdfs:label "OBI:0003372" ;
    dcterms:title "assay measuring epitope specific lymphotactin production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects lymphotactin production by T cells." .

OBI:0003373 a owl:Class ;
    rdfs:label "OBI:0003373" ;
    dcterms:title "ELISA measuring epitope specific lymphotactin production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzyme-linked immunosorbent assay that detects lymphotactin production by T cells." .

OBI:0003375 a owl:Class ;
    rdfs:label "OBI:0003375" ;
    dcterms:title "patch-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that combines electrophysiological, transcriptomic, and morphological characterization of individual neurons. In this approach, patch-clamp is used to generate an electrophysiological recording of the neuron, then the neuron's cytoplasm and/or nucleus is collected and processed for RNAseq, and finally the cell is simultaneously filled with a dye that allows for subsequent morphological reconstruction." .

OBI:0003376 a owl:Class ;
    rdfs:label "OBI:0003376" ;
    dcterms:title "droplet-based single-cell RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-cell transcription profiling by RNA sequencing assay that analyzes mRNA transcripts from droplets of individual cells. The process involves the following steps: (1) prepare a single-cell suspension from a tissue; (2) co-encapsulate each cell with a distinctly barcoded microparticle (bead) in a nanoliter-scale droplet; (3) lyse cells after they have been isolated in droplets; (4) capture a cell’s mRNAs on its companion microparticle, forming STAMPs (single-cell transcriptomes attached to microparticles); (5) reverse-transcribe, amplify, and sequence." .

OBI:0003377 a owl:Class ;
    rdfs:label "OBI:0003377" ;
    dcterms:title "single-nucleus chromatin accessibility and mRNA expression sequencing 2 assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses combinatorial indexing to generate a library of cDNA and open chromatin gDNA fragments by tagmenting a single nuclei and open chromatin, and encapsulating those in a droplet including both an oligo-dT-containing barcoded bead and a splint oligonucleotide, which links the tagmented gDNA fragments to the bead which capture both mRNAs and open chromatin fragments." .

OBI:0003378 a owl:Class ;
    rdfs:label "OBI:0003378" ;
    dcterms:title "switching mechanism at the 5' end of RNA template sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single cell transcription profiling by RNA sequencing assay wherein cells are lysed and their recovered RNA is hybridized to an oligo(dT) that primes a reverse transcription reaction, the outcome of which are cDNA’s that have PCR handles on both ends. The cDNA's are then amplified using PCR, and the products are sequenced." .

OBI:0003379 a owl:Class ;
    rdfs:label "OBI:0003379" ;
    dcterms:title "switching mechanism at the 5' end of RNA template sequencing 2 assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single cell transcription profiling by RNA sequencing assay that is a variation on the switching mechanism at the 5' end of RNA template sequencing assay (SMARTseq) that allows the generation of full-length cDNA and sequencing libraries by using standard reagents." .

OBI:0003381 a owl:Class ;
    rdfs:label "OBI:0003381" ;
    dcterms:title "placental blood microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A blood microbiology assay that detects microorganisms in a placental blood specimen." .

OBI:0003412 a owl:Class ;
    rdfs:label "OBI:0003412" ;
    dcterms:title "linked-read sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that uses microfluidics to partition and barcode high molecular weight DNA such that short reads derived from fragments of the large piece of DNA can be assembled within the context of the high molecular weight piece of DNA they are derived from, facilitating the use of short read data to sequence and assemble large genomes." .

OBI:0003418 a owl:Class ;
    rdfs:label "OBI:0003418" ;
    dcterms:title "antigen specific antibodies in blood assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that has a blood specimen as evaluant." .

OBI:0003419 a owl:Class ;
    rdfs:label "OBI:0003419" ;
    dcterms:title "antigen specific antibodies in milk assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that has a milk specimen as evaluant." .

OBI:0003422 a owl:Class ;
    rdfs:label "OBI:0003422" ;
    dcterms:title "enzymatic activity level assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which the level of catalytic activity of an enzyme is determined." .

OBI:0003423 a owl:Class ;
    rdfs:label "OBI:0003423" ;
    dcterms:title "5'-nucleotidase activity level assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
