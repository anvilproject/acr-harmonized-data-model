cam:FamilyMembership a owl:Class ;
    rdfs:label "FamilyMembership" ;
    dcterms:title "Family Membership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:family_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:family_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:family_membership_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Family ;
            owl:onProperty cam:family_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:family_membership_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumFamilyRole ) ] cam:Concept ) ] ;
            owl:onProperty cam:family_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:family_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:family_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:family_membership_id ],
        linkml:ClassDefinition ;
    skos:definition "Designates a Subject as a member of a family with a specified role." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:FamilyRelationship a owl:Class ;
    rdfs:label "FamilyRelationship" ;
    dcterms:title "Family Member Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumFamilyRelation acr_harmonized_data_model:EnumUnknown ) ] cam:Concept ) ] ;
            owl:onProperty cam:relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:family_relationship_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:family_member_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:family_member_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:family_member_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:family_relationship_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:family_relationship_id ],
        linkml:ClassDefinition ;
    skos:definition "A relationship between two Subjects. Directed as follows <family_member_id> <relationship> <subject_id> <Mother's id> <KIN:027 \"isBiologicalMotherOf\"> <subject_id>" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:SubjectAssertion a owl:Class ;
    rdfs:label "SubjectAssertion" ;
    dcterms:title "Subject Assertion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cam:Encounter ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:string xsd:string xsd:string ) ] xsd:string ) ] ;
            owl:onProperty cam:assertion_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:value_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:age_at_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:value_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumDataSourceType ;
            owl:onProperty cam:assertion_source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:value_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:age_at_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Concept ;
            owl:onProperty cam:value_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:asserter_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumAsserterType ;
            owl:onProperty cam:asserter_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:value_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty cam:value_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:value_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:age_at_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:value_unit_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:concept_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:concept ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:age_at_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumPresentAbsent ) ] cam:Concept ) ] ;
            owl:onProperty cam:value_concept ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:age_at_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:value_unit_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:value_unit_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:concept_source ],
        [ a owl:Restriction ;
