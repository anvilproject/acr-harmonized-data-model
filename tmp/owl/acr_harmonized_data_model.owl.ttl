    skos:inScheme <https://includedcc.org/common-access-model> .

cam:sex a owl:ObjectProperty ;
    rdfs:label "sex" ;
    dcterms:title "Sex" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumSex acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
    skos:definition "Sex of Participant" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:site a owl:ObjectProperty ;
    rdfs:label "site" ;
