edam:data_2044 a owl:Class ;
    rdfs:label "edam:data_2044" ;
    dcterms:title "Sequence" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "One or more molecular sequences, possibly with associated annotation." .

edam:data_2048 a owl:Class ;
