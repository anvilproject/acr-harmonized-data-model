OBI:0001658 a owl:Class ;
    rdfs:label "OBI:0001658" ;
    dcterms:title "ELISPOT assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
