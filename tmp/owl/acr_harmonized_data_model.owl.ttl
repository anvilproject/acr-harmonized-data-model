    skos:definition "A surface plasmon resonance binding assay that detects the binding of an antigen with an antibody." .

OBI:0001652 a owl:Class ;
    rdfs:label "OBI:0001652" ;
    dcterms:title "immuno staining assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
