OBI:0001017 a owl:Class ;
    rdfs:label "OBI:0001017" ;
    dcterms:title "single-nucleotide-resolution nucleic acid structure mapping assay using chemical probing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay that determines structural information about the RNA species under study using small chemical compounds acting as chemical probes." .

OBI:0001018 a owl:Class ;
