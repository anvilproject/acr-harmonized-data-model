cam:clinical_data_source_type a owl:ObjectProperty ;
    rdfs:label "clinical_data_source_type" ;
    dcterms:title "Clinical Data Source Type" ;
    rdfs:range acr_harmonized_data_model:EnumDataSourceType ;
    skos:definition "Source(s) of data collected from study participants" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:concept a owl:ObjectProperty ;
    rdfs:label "concept" ;
    dcterms:title "Concept" ;
    rdfs:range cam:Concept ;
    skos:definition "The structured term defining the meaning of the assertion." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:external_id a owl:DatatypeProperty ;
    rdfs:label "external_id" ;
    dcterms:title "External Identifiers" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Other identifiers for this entity, eg, from the submitting study or in systems like dbGaP" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:funding_source a owl:DatatypeProperty ;
    rdfs:label "funding_source" ;
    dcterms:title "Funding Source" ;
    rdfs:range xsd:string ;
    skos:definition "The funding source(s) of the study." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:hash a owl:ObjectProperty ;
    rdfs:label "hash" ;
    dcterms:title "File Hash" ;
    rdfs:range cam:FileHash ;
    skos:definition "File hash information" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:participant_lifespan_stage a owl:ObjectProperty ;
    rdfs:label "participant_lifespan_stage" ;
    dcterms:title "Participant Lifespan Stage" ;
    rdfs:range acr_harmonized_data_model:EnumParticipantLifespanStage ;
    skos:definition "Focus age group(s) of the study population" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:principal_investigator a owl:ObjectProperty ;
    rdfs:label "principal_investigator" ;
    dcterms:title "Principal Investigator" ;
    rdfs:range cam:Investigator ;
    skos:definition "The Principal Investigator(s) responsible for the study." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:processing a owl:DatatypeProperty ;
    rdfs:label "processing" ;
    dcterms:title "Sample Processing" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Processing that was applied to the Parent Sample or from the Biospecimen Collection that yielded this distinct sample. OBI is recommended." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:program a owl:DatatypeProperty ;
    rdfs:label "program" ;
    dcterms:title "Program" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( xsd:anyURI acr_harmonized_data_model:EnumProgram ) ] xsd:anyURI ) ] ;
    skos:definition "Funding source(s) for the study" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:race a owl:ObjectProperty ;
    rdfs:label "race" ;
    dcterms:title "Race" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumRace acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
    skos:definition "Race of Participant" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:research_domain a owl:ObjectProperty ;
    rdfs:label "research_domain" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumResearchDomain ) ] cam:Concept ) ] ;
    skos:definition "Main research domain(s) of the study" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:storage_method a owl:DatatypeProperty ;
    rdfs:label "storage_method" ;
    dcterms:title "Sample Storage Method" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Sample storage method, eg, Frozen or with additives. OBI may be suitable, or ChEBI for additives." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:study_design a owl:ObjectProperty ;
    rdfs:label "study_design" ;
    dcterms:title "Study Design" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumStudyDesign ) ] cam:Concept ) ] ;
    skos:definition "Overall design of study, including whether it is longitudinal and whether family members/unrelated controls are also enrolled" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:value_concept a owl:ObjectProperty ;
    rdfs:label "value_concept" ;
    dcterms:title "Value concept" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumPresentAbsent ) ] cam:Concept ) ] ;
    skos:definition "The structured term defining the value of the assertion." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

<https://w3id.org/anvilproject/acr-harmonized-data-model/EnumAsserterType#CAMO%3A0000016> a owl:Class ;
