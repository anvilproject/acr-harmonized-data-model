            owl:onProperty cam:spatial_qualifier ],
        linkml:ClassDefinition ;
    skos:definition "A biospecimen collection event which yields one or more Samples." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:EncounterDefinition a owl:Class ;
