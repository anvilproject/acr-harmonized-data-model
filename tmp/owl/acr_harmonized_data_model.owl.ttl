cam:Subject a owl:Class ;
    rdfs:label "Subject" ;
    dcterms:title "Subject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:organism_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:subject_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:organism_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:anyURI acr_harmonized_data_model:EnumOrganism ) ] xsd:anyURI ) ] ;
            owl:onProperty cam:organism_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumSubjectType acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
            owl:onProperty cam:subject_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_type ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        linkml:ClassDefinition ;
    skos:definition "This entity is the subject about which data or references are recorded. This includes the idea of a human participant in a study, a cell line, an animal model, or any other similar entity." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

