edam:format_3475 a owl:Class ;
    rdfs:label "edam:format_3475" ;
    dcterms:title "TSV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tabular data represented as tab-separated values in a text file." .

edam:format_3477 a owl:Class ;
    rdfs:label "edam:format_3477" ;
    dcterms:title "Cytoscape input file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of the cytoscape input file of gene expression ratios or values are specified over one or more experiments." .

edam:format_3484 a owl:Class ;
    rdfs:label "edam:format_3484" ;
    dcterms:title "ebwt" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Bowtie format for indexed reference genome for \"small\" genomes." .

edam:format_3485 a owl:Class ;
    rdfs:label "edam:format_3485" ;
    dcterms:title "RSF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Rich sequence format." .

edam:format_3486 a owl:Class ;
    rdfs:label "edam:format_3486" ;
    dcterms:title "GCG format variant" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Some format based on the GCG format." .

edam:format_3487 a owl:Class ;
    rdfs:label "edam:format_3487" ;
    dcterms:title "BSML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Bioinformatics Sequence Markup Language format." .

edam:format_3491 a owl:Class ;
    rdfs:label "edam:format_3491" ;
    dcterms:title "ebwtl" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Bowtie format for indexed reference genome for \"large\" genomes." .

edam:format_3499 a owl:Class ;
    rdfs:label "edam:format_3499" ;
    dcterms:title "Ensembl variation file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Ensembl standard format for variation data." .

edam:format_3506 a owl:Class ;
    rdfs:label "edam:format_3506" ;
    dcterms:title "docx" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Microsoft Word format." .

edam:format_3507 a owl:Class ;
    rdfs:label "edam:format_3507" ;
    dcterms:title "Document format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of documents including word processor, spreadsheet and presentation." .

edam:format_3508 a owl:Class ;
    rdfs:label "edam:format_3508" ;
    dcterms:title "PDF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Portable Document Format." .

edam:format_3547 a owl:Class ;
    rdfs:label "edam:format_3547" ;
    dcterms:title "Image format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format used for images and image metadata." .

edam:format_3548 a owl:Class ;
    rdfs:label "edam:format_3548" ;
    dcterms:title "DICOM format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Medical image format corresponding to the Digital Imaging and Communications in Medicine (DICOM) standard." .

edam:format_3549 a owl:Class ;
    rdfs:label "edam:format_3549" ;
    dcterms:title "nii" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An open file format from the Neuroimaging Informatics Technology Initiative (NIfTI) commonly used to store brain imaging data obtained using Magnetic Resonance Imaging (MRI) methods." .

edam:format_3550 a owl:Class ;
    rdfs:label "edam:format_3550" ;
    dcterms:title "mhd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Text-based tagged file format for medical images generated using the MetaImage software package." .

edam:format_3551 a owl:Class ;
    rdfs:label "edam:format_3551" ;
    dcterms:title "nrrd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Nearly Raw Rasta Data format designed to support scientific visualisation and image processing involving N-dimensional raster data." .

edam:format_3554 a owl:Class ;
    rdfs:label "edam:format_3554" ;
    dcterms:title "R file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "File format used for scripts written in the R programming language for execution within the R software environment, typically for statistical computation and graphics." .

edam:format_3555 a owl:Class ;
    rdfs:label "edam:format_3555" ;
    dcterms:title "SPSS" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "File format used for scripts for the Statistical Package for the Social Sciences." .

edam:format_3556 a owl:Class ;
    rdfs:label "edam:format_3556" ;
    dcterms:title "MHTML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MIME HTML format for Web pages, which can include external resources, including images, Flash animations and so on." .

edam:format_3578 a owl:Class ;
    rdfs:label "edam:format_3578" ;
    dcterms:title "IDAT" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Proprietary file format for (raw) BeadArray data used by genomewide profiling platforms from Illumina Inc. This format is output directly from the scanner and stores summary intensities for each probe-type on an array." .

edam:format_3579 a owl:Class ;
    rdfs:label "edam:format_3579" ;
    dcterms:title "JPG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Joint Picture Group file format for lossy graphics file." .

edam:format_3580 a owl:Class ;
    rdfs:label "edam:format_3580" ;
    dcterms:title "rcc" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Reporter Code Count-A data file (.csv) output by the Nanostring nCounter Digital Analyzer, which contains gene sample information, probe information and probe counts." .

edam:format_3581 a owl:Class ;
    rdfs:label "edam:format_3581" ;
    dcterms:title "arff" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ARFF (Attribute-Relation File Format) is an ASCII text file format that describes a list of instances sharing a set of attributes." .

edam:format_3582 a owl:Class ;
    rdfs:label "edam:format_3582" ;
    dcterms:title "afg" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AFG is a single text-based file assembly format that holds read and consensus information together." .

edam:format_3583 a owl:Class ;
    rdfs:label "edam:format_3583" ;
    dcterms:title "bedgraph" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The bedGraph format allows display of continuous-valued data in track format. This display type is useful for probability scores and transcriptome data." .

edam:format_3584 a owl:Class ;
    rdfs:label "edam:format_3584" ;
    dcterms:title "bedstrict" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Browser Extensible Data (BED) format of sequence annotation track that strictly does not contain non-standard fields beyond the first 3 columns." .

edam:format_3585 a owl:Class ;
    rdfs:label "edam:format_3585" ;
    dcterms:title "bed6" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BED file format where each feature is described by chromosome, start, end, name, score, and strand." .

edam:format_3586 a owl:Class ;
    rdfs:label "edam:format_3586" ;
    dcterms:title "bed12" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A BED file where each feature is described by all twelve columns." .

edam:format_3587 a owl:Class ;
    rdfs:label "edam:format_3587" ;
    dcterms:title "chrominfo" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tabular format of chromosome names and sizes used by Galaxy." .

edam:format_3588 a owl:Class ;
    rdfs:label "edam:format_3588" ;
    dcterms:title "customtrack" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Custom Sequence annotation track format used by Galaxy." .

edam:format_3589 a owl:Class ;
    rdfs:label "edam:format_3589" ;
    dcterms:title "csfasta" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Color space FASTA format sequence variant." .

edam:format_3590 a owl:Class ;
    rdfs:label "edam:format_3590" ;
    dcterms:title "HDF5" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "HDF5 is a data model, library, and file format for storing and managing data, based on Hierarchical Data Format (HDF)." .

edam:format_3591 a owl:Class ;
    rdfs:label "edam:format_3591" ;
    dcterms:title "TIFF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A versatile bitmap format." .

edam:format_3592 a owl:Class ;
    rdfs:label "edam:format_3592" ;
    dcterms:title "BMP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Standard bitmap storage format in the Microsoft Windows environment." .

edam:format_3593 a owl:Class ;
    rdfs:label "edam:format_3593" ;
    dcterms:title "im" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "IM is a format used by LabEye and other applications based on the IFUNC image processing library." .

edam:format_3594 a owl:Class ;
    rdfs:label "edam:format_3594" ;
    dcterms:title "pcd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Photo CD format, which is the highest resolution format for images on a CD." .

edam:format_3595 a owl:Class ;
    rdfs:label "edam:format_3595" ;
    dcterms:title "pcx" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PCX is an image file format that uses a simple form of run-length encoding. It is lossless." .

edam:format_3596 a owl:Class ;
    rdfs:label "edam:format_3596" ;
    dcterms:title "ppm" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The PPM format is a lowest common denominator color image file format." .

edam:format_3597 a owl:Class ;
    rdfs:label "edam:format_3597" ;
    dcterms:title "psd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PSD (Photoshop Document) is a proprietary file that allows the user to work with the images' individual layers even after the file has been saved." .

edam:format_3598 a owl:Class ;
    rdfs:label "edam:format_3598" ;
    dcterms:title "xbm" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "X BitMap is a plain text binary image format used by the X Window System used for storing cursor and icon bitmaps used in the X GUI." .

edam:format_3599 a owl:Class ;
    rdfs:label "edam:format_3599" ;
    dcterms:title "xpm" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "X PixMap (XPM) is an image file format used by the X Window System, it is intended primarily for creating icon pixmaps, and supports transparent pixels." .

edam:format_3600 a owl:Class ;
    rdfs:label "edam:format_3600" ;
    dcterms:title "rgb" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "RGB file format is the native raster graphics file format for Silicon Graphics workstations." .

edam:format_3601 a owl:Class ;
    rdfs:label "edam:format_3601" ;
    dcterms:title "pbm" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The PBM format is a lowest common denominator monochrome file format. It serves as the common language of a large family of bitmap image conversion filters." .

edam:format_3602 a owl:Class ;
    rdfs:label "edam:format_3602" ;
    dcterms:title "pgm" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The PGM format is a lowest common denominator grayscale file format." .

edam:format_3603 a owl:Class ;
    rdfs:label "edam:format_3603" ;
    dcterms:title "PNG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PNG is a file format for image compression." .

edam:format_3604 a owl:Class ;
    rdfs:label "edam:format_3604" ;
    dcterms:title "SVG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Scalable Vector Graphics (SVG) is an XML-based vector image format for two-dimensional graphics with support for interactivity and animation." .

edam:format_3605 a owl:Class ;
    rdfs:label "edam:format_3605" ;
    dcterms:title "rast" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Sun Raster is a raster graphics file format used on SunOS by Sun Microsystems." .

edam:format_3606 a owl:Class ;
    rdfs:label "edam:format_3606" ;
    dcterms:title "Sequence quality report format (text)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Textual report format for sequence quality for reports from sequencing machines." .

edam:format_3607 a owl:Class ;
    rdfs:label "edam:format_3607" ;
    dcterms:title "qual" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTQ format subset for Phred sequencing quality score data only (no sequences)." .

edam:format_3608 a owl:Class ;
    rdfs:label "edam:format_3608" ;
    dcterms:title "qualsolexa" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTQ format subset for Phred sequencing quality score data only (no sequences) for Solexa/Illumina 1.0 format." .

edam:format_3609 a owl:Class ;
    rdfs:label "edam:format_3609" ;
    dcterms:title "qualillumina" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTQ format subset for Phred sequencing quality score data only (no sequences) from Illumina 1.5 and before Illumina 1.8." .

edam:format_3610 a owl:Class ;
    rdfs:label "edam:format_3610" ;
    dcterms:title "qualsolid" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTQ format subset for Phred sequencing quality score data only (no sequences) for SOLiD data." .

edam:format_3611 a owl:Class ;
    rdfs:label "edam:format_3611" ;
    dcterms:title "qual454" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTQ format subset for Phred sequencing quality score data only (no sequences) from 454 sequencers." .

edam:format_3612 a owl:Class ;
    rdfs:label "edam:format_3612" ;
    dcterms:title "ENCODE peak format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Human ENCODE peak format." .

edam:format_3613 a owl:Class ;
    rdfs:label "edam:format_3613" ;
    dcterms:title "ENCODE narrow peak format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Human ENCODE narrow peak format." .

edam:format_3614 a owl:Class ;
    rdfs:label "edam:format_3614" ;
    dcterms:title "ENCODE broad peak format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Human ENCODE broad peak format." .

edam:format_3615 a owl:Class ;
    rdfs:label "edam:format_3615" ;
    dcterms:title "bgzip" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Blocked GNU Zip format." .

edam:format_3616 a owl:Class ;
    rdfs:label "edam:format_3616" ;
    dcterms:title "tabix" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "TAB-delimited genome position file index format." .

edam:format_3617 a owl:Class ;
    rdfs:label "edam:format_3617" ;
    dcterms:title "Graph format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for graph data." .

edam:format_3618 a owl:Class ;
    rdfs:label "edam:format_3618" ;
    dcterms:title "xgmml" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML-based format used to store graph descriptions within Galaxy." .

edam:format_3619 a owl:Class ;
    rdfs:label "edam:format_3619" ;
    dcterms:title "sif" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SIF (simple interaction file) Format - a network/pathway format used for instance in cytoscape." .

edam:format_3620 a owl:Class ;
    rdfs:label "edam:format_3620" ;
    dcterms:title "xlsx" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MS Excel spreadsheet format consisting of a set of XML documents stored in a ZIP-compressed file." .

edam:format_3621 a owl:Class ;
    rdfs:label "edam:format_3621" ;
    dcterms:title "SQLite format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format used by the SQLite database." .

edam:format_3622 a owl:Class ;
    rdfs:label "edam:format_3622" ;
    dcterms:title "Gemini SQLite format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format used by the SQLite database conformant to the Gemini schema." .

edam:format_3624 a owl:Class ;
    rdfs:label "edam:format_3624" ;
    dcterms:title "snpeffdb" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An index of a genome database, indexed for use by the snpeff tool." .

edam:format_3626 a owl:Class ;
    rdfs:label "edam:format_3626" ;
    dcterms:title "MAT" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Binary format used by MATLAB files to store workspace variables." .

edam:format_3650 a owl:Class ;
    rdfs:label "edam:format_3650" ;
    dcterms:title "NetCDF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format used by netCDF software library for writing and reading chromatography-MS data files. Also used to store trajectory atom coordinates information, such as the ones obtained by Molecular Dynamics simulations." .

edam:format_3651 a owl:Class ;
    rdfs:label "edam:format_3651" ;
    dcterms:title "MGF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Mascot Generic Format. Encodes multiple MS/MS spectra in a single file." .

edam:format_3652 a owl:Class ;
    rdfs:label "edam:format_3652" ;
    dcterms:title "dta" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Spectral data format file where each spectrum is written to a separate file." .

edam:format_3653 a owl:Class ;
    rdfs:label "edam:format_3653" ;
    dcterms:title "pkl" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Spectral data file similar to dta." .

edam:format_3654 a owl:Class ;
    rdfs:label "edam:format_3654" ;
    dcterms:title "mzXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Common file format for proteomics mass spectrometric data developed at the Seattle Proteome Center/Institute for Systems Biology." .

edam:format_3655 a owl:Class ;
    rdfs:label "edam:format_3655" ;
    dcterms:title "pepXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Open data format for the storage, exchange, and processing of peptide sequence assignments of MS/MS scans, intended to provide a common data output format for many different MS/MS search engines and subsequent peptide-level analyses." .

edam:format_3657 a owl:Class ;
    rdfs:label "edam:format_3657" ;
    dcterms:title "GPML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Graphical Pathway Markup Language (GPML) is an XML format used for exchanging biological pathways." .

edam:format_3665 a owl:Class ;
    rdfs:label "edam:format_3665" ;
    dcterms:title "K-mer countgraph" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A list of k-mers and their occurrences in a dataset. Can also be used as an implicit De Bruijn graph." .

edam:format_3681 a owl:Class ;
    rdfs:label "edam:format_3681" ;
    dcterms:title "mzTab" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzTab is a light-weight, tab-delimited format for mass spectrometry-based proteomics data." .

edam:format_3682 a owl:Class ;
    rdfs:label "edam:format_3682" ;
    dcterms:title "imzML metadata file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "imzML metadata is a data format for mass spectrometry imaging metadata." .

edam:format_3683 a owl:Class ;
    rdfs:label "edam:format_3683" ;
    dcterms:title "qcML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "qcML is an XML format for quality-related data of mass spectrometry and other high-throughput measurements." .

edam:format_3684 a owl:Class ;
    rdfs:label "edam:format_3684" ;
    dcterms:title "PRIDE XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PRIDE XML is an XML format for mass spectra, peptide and protein identifications, and metadata about a corresponding measurement, sample, experiment." .

edam:format_3685 a owl:Class ;
    rdfs:label "edam:format_3685" ;
    dcterms:title "SED-ML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Simulation Experiment Description Markup Language (SED-ML) is an XML format for encoding simulation setups, according to the MIASE (Minimum Information About a Simulation Experiment) requirements." .

edam:format_3686 a owl:Class ;
    rdfs:label "edam:format_3686" ;
    dcterms:title "COMBINE OMEX" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Open Modeling EXchange format (OMEX) is a ZIPped format for encapsulating all information necessary for a modeling and simulation project in systems biology." .

edam:format_3687 a owl:Class ;
    rdfs:label "edam:format_3687" ;
    dcterms:title "ISA-Tab" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ISA-Tab stands for Investigation / Study / Assay (ISA) tab-delimited (Tab) format, and it is comprised of metadata describing observational or experimental scientific studies." .

edam:format_3688 a owl:Class ;
    rdfs:label "edam:format_3688" ;
    dcterms:title "SBtab" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SBtab is a tabular format for biochemical network models." .

edam:format_3689 a owl:Class ;
    rdfs:label "edam:format_3689" ;
    dcterms:title "BCML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Biological Connection Markup Language (BCML) is an XML format for biological pathways." .

edam:format_3690 a owl:Class ;
    rdfs:label "edam:format_3690" ;
    dcterms:title "BDML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Biological Dynamics Markup Language (BDML) is an XML format for quantitative data describing biological dynamics." .

edam:format_3691 a owl:Class ;
    rdfs:label "edam:format_3691" ;
    dcterms:title "BEL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Biological Expression Language (BEL) is a textual format for representing scientific findings in life sciences in a computable form." .

edam:format_3692 a owl:Class ;
    rdfs:label "edam:format_3692" ;
    dcterms:title "SBGN-ML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SBGN-ML is an XML format for Systems Biology Graphical Notation (SBGN) diagrams of biological pathways or networks." .

edam:format_3693 a owl:Class ;
    rdfs:label "edam:format_3693" ;
    dcterms:title "AGP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AGP is a tabular format for a sequence assembly (a contig, a scaffold/supercontig, or a chromosome)." .

edam:format_3696 a owl:Class ;
    rdfs:label "edam:format_3696" ;
    dcterms:title "PS" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PostScript format." .

edam:format_3698 a owl:Class ;
    rdfs:label "edam:format_3698" ;
    dcterms:title "SRA format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SRA archive format (SRA) is the archive format used for input to the NCBI Sequence Read Archive." .

edam:format_3699 a owl:Class ;
    rdfs:label "edam:format_3699" ;
    dcterms:title "VDB" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "VDB ('vertical database') is the native format used for export from the NCBI Sequence Read Archive." .

edam:format_3701 a owl:Class ;
    rdfs:label "edam:format_3701" ;
    dcterms:title "Sequin format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A five-column, tab-delimited table of feature locations and qualifiers for importing annotation into an existing Sequin submission (an NCBI tool for submitting and updating GenBank entries)." .

edam:format_3702 a owl:Class ;
    rdfs:label "edam:format_3702" ;
    dcterms:title "MSF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Proprietary mass-spectrometry format of Thermo Scientific's ProteomeDiscoverer software." .

edam:format_3706 a owl:Class ;
    rdfs:label "edam:format_3706" ;
    dcterms:title "Biodiversity data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for biodiversity data." .

edam:format_3708 a owl:Class ;
    rdfs:label "edam:format_3708" ;
    dcterms:title "ABCD format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Exchange format of the Access to Biological Collections Data (ABCD) Schema; a standard for the access to and exchange of data about specimens and observations (primary biodiversity data)." .

edam:format_3709 a owl:Class ;
    rdfs:label "edam:format_3709" ;
    dcterms:title "GCT/Res format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tab-delimited text files of GenePattern that contain a column for each sample, a row for each gene, and an expression value for each gene in each sample." .

edam:format_3710 a owl:Class ;
    rdfs:label "edam:format_3710" ;
    dcterms:title "WIFF format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Mass spectrum file format from QSTAR and QTRAP instruments (ABI/Sciex)." .

edam:format_3711 a owl:Class ;
    rdfs:label "edam:format_3711" ;
    dcterms:title "X!Tandem XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Output format used by X! series search engines that is based on the XML language BIOML." .

edam:format_3712 a owl:Class ;
    rdfs:label "edam:format_3712" ;
    dcterms:title "Thermo RAW" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Proprietary file format for mass spectrometry data from Thermo Scientific." .

edam:format_3713 a owl:Class ;
    rdfs:label "edam:format_3713" ;
    dcterms:title "Mascot .dat file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "\"Raw\" result file from Mascot database search." .

edam:format_3714 a owl:Class ;
    rdfs:label "edam:format_3714" ;
    dcterms:title "MaxQuant APL peaklist format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of peak list files from Andromeda search engine (MaxQuant) that consist of arbitrarily many spectra." .

edam:format_3725 a owl:Class ;
    rdfs:label "edam:format_3725" ;
    dcterms:title "SBOL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Synthetic Biology Open Language (SBOL) is an XML format for the specification and exchange of biological design information in synthetic biology." .

edam:format_3726 a owl:Class ;
    rdfs:label "edam:format_3726" ;
    dcterms:title "PMML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PMML uses XML to represent mining models. The structure of the models is described by an XML Schema." .

edam:format_3727 a owl:Class ;
    rdfs:label "edam:format_3727" ;
    dcterms:title "OME-TIFF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Image file format used by the Open Microscopy Environment (OME)." .

edam:format_3728 a owl:Class ;
    rdfs:label "edam:format_3728" ;
    dcterms:title "LocARNA PP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The LocARNA PP format combines sequence or alignment information and (respectively, single or consensus) ensemble probabilities into an PP 2.0 record." .

edam:format_3729 a owl:Class ;
    rdfs:label "edam:format_3729" ;
    dcterms:title "dbGaP format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Input format used by the Database of Genotypes and Phenotypes (dbGaP)." .

edam:format_3746 a owl:Class ;
    rdfs:label "edam:format_3746" ;
    dcterms:title "BIOM format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The BIological Observation Matrix (BIOM) is a format for representing biological sample by observation contingency tables in broad areas of comparative omics. The primary use of this format is to represent OTU tables and metagenome tables." .

edam:format_3747 a owl:Class ;
    rdfs:label "edam:format_3747" ;
    dcterms:title "protXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A format for storage, exchange, and processing of protein identifications created from ms/ms-derived peptide sequence data." .

edam:format_3748 a owl:Class ;
    rdfs:label "edam:format_3748" ;
    dcterms:title "Linked data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A linked data format enables publishing structured data as linked data (Linked Data), so that the data can be interlinked and become more useful through semantic queries." .

edam:format_3749 a owl:Class ;
    rdfs:label "edam:format_3749" ;
    dcterms:title "JSON-LD" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "JSON-LD, or JavaScript Object Notation for Linked Data, is a method of encoding Linked Data using JSON." .

edam:format_3750 a owl:Class ;
    rdfs:label "edam:format_3750" ;
    dcterms:title "YAML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "YAML (YAML Ain't Markup Language) is a human-readable tree-structured data serialisation language." .

edam:format_3751 a owl:Class ;
    rdfs:label "edam:format_3751" ;
    dcterms:title "DSV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tabular data represented as values in a text file delimited by some character." .

edam:format_3752 a owl:Class ;
    rdfs:label "edam:format_3752" ;
    dcterms:title "CSV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tabular data represented as comma-separated values in a text file." .

edam:format_3758 a owl:Class ;
    rdfs:label "edam:format_3758" ;
    dcterms:title "SEQUEST .out file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "\"Raw\" result file from SEQUEST database search." .

edam:format_3764 a owl:Class ;
    rdfs:label "edam:format_3764" ;
    dcterms:title "idXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML file format for files containing information about peptide identifications from mass spectrometry data analysis carried out with OpenMS." .

edam:format_3765 a owl:Class ;
    rdfs:label "edam:format_3765" ;
    dcterms:title "KNIME datatable format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data table formatted such that it can be passed/streamed within the KNIME platform." .

edam:format_3770 a owl:Class ;
    rdfs:label "edam:format_3770" ;
    dcterms:title "UniProtKB XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "UniProtKB XML sequence features format is an XML format available for downloading UniProt entries." .

edam:format_3771 a owl:Class ;
    rdfs:label "edam:format_3771" ;
    dcterms:title "UniProtKB RDF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "UniProtKB RDF sequence features format is an RDF format available for downloading UniProt entries (in RDF/XML)." .

edam:format_3772 a owl:Class ;
    rdfs:label "edam:format_3772" ;
    dcterms:title "BioJSON (BioXSD)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioJSON is a BioXSD-schema-based JSON format of sequence-based data and some other common data - sequence records, alignments, feature records, references to resources, and more - optimised for integrative bioinformatics, web applications and APIs, and object-oriented programming." .

edam:format_3773 a owl:Class ;
    rdfs:label "edam:format_3773" ;
    dcterms:title "BioYAML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioYAML is a BioXSD-schema-based YAML format of sequence-based data and some other common data - sequence records, alignments, feature records, references to resources, and more - optimised for integrative bioinformatics, web APIs, human readability and editing, and object-oriented programming." .

edam:format_3774 a owl:Class ;
    rdfs:label "edam:format_3774" ;
    dcterms:title "BioJSON (Jalview)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioJSON is a JSON format of single multiple sequence alignments, with their annotations, features, and custom visualisation and application settings for the Jalview workbench." .

edam:format_3775 a owl:Class ;
    rdfs:label "edam:format_3775" ;
    dcterms:title "GSuite" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GSuite is a tabular format for collections of genome or sequence feature tracks, suitable for integrative multi-track analysis. GSuite contains links to genome/sequence tracks, with additional metadata." .

edam:format_3776 a owl:Class ;
    rdfs:label "edam:format_3776" ;
    dcterms:title "BTrack" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BTrack is an HDF5-based binary format for genome or sequence feature tracks and their collections, suitable for integrative multi-track analysis. BTrack is a binary, compressed alternative to the GTrack and GSuite formats." .

edam:format_3777 a owl:Class ;
    rdfs:label "edam:format_3777" ;
    dcterms:title "MCPD" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The FAO/Bioversity/IPGRI Multi-Crop Passport Descriptors (MCPD) is an international standard format for exchange of germplasm information." .

edam:format_3780 a owl:Class ;
    rdfs:label "edam:format_3780" ;
    dcterms:title "Annotated text format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format of an annotated text, e.g. with recognised entities, concepts, and relations." .

edam:format_3781 a owl:Class ;
    rdfs:label "edam:format_3781" ;
    dcterms:title "PubAnnotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "JSON format of annotated scientific text used by PubAnnotations and other tools." .

edam:format_3782 a owl:Class ;
    rdfs:label "edam:format_3782" ;
    dcterms:title "BioC" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioC is a standardised XML format for sharing and integrating text data and annotations." .

edam:format_3783 a owl:Class ;
    rdfs:label "edam:format_3783" ;
    dcterms:title "PubTator format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Native textual export format of annotated scientific text from PubTator." .

edam:format_3784 a owl:Class ;
    rdfs:label "edam:format_3784" ;
    dcterms:title "Open Annotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A format of text annotation using the linked-data Open Annotation Data Model, serialised typically in RDF or JSON-LD." .

edam:format_3785 a owl:Class ;
    rdfs:label "edam:format_3785" ;
    dcterms:title "BioNLP Shared Task format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A family of similar formats of text annotation, used by BRAT and other tools, known as BioNLP Shared Task format (BioNLP 2009 Shared Task on Event Extraction, BioNLP Shared Task 2011, BioNLP Shared Task 2013), BRAT format, BRAT standoff format, and similar." .

edam:format_3787 a owl:Class ;
    rdfs:label "edam:format_3787" ;
    dcterms:title "Query language" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A query language (format) for structured database queries." .

edam:format_3788 a owl:Class ;
    rdfs:label "edam:format_3788" ;
    dcterms:title "SQL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SQL (Structured Query Language) is the de-facto standard query language (format of queries) for querying and manipulating data in relational databases." .

edam:format_3789 a owl:Class ;
    rdfs:label "edam:format_3789" ;
    dcterms:title "XQuery" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XQuery (XML Query) is a query language (format of queries) for querying and manipulating structured and unstructured data, usually in the form of XML, text, and with vendor-specific extensions for other data formats (JSON, binary, etc.)." .

edam:format_3790 a owl:Class ;
    rdfs:label "edam:format_3790" ;
    dcterms:title "SPARQL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SPARQL (SPARQL Protocol and RDF Query Language) is a semantic query language for querying and manipulating data stored in Resource Description Framework (RDF) format." .

edam:format_3804 a owl:Class ;
    rdfs:label "edam:format_3804" ;
    dcterms:title "xsd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for XML Schema." .

edam:format_3811 a owl:Class ;
    rdfs:label "edam:format_3811" ;
    dcterms:title "XMFA" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XMFA format stands for eXtended Multi-FastA format and is used to store collinear sub-alignments that constitute a single genome alignment." .

edam:format_3812 a owl:Class ;
    rdfs:label "edam:format_3812" ;
    dcterms:title "GEN" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The GEN file format contains genetic data and describes SNPs." .

edam:format_3813 a owl:Class ;
    rdfs:label "edam:format_3813" ;
    dcterms:title "SAMPLE file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The SAMPLE file format contains information about each individual i.e. individual IDs, covariates, phenotypes and missing data proportions, from a GWAS study." .

edam:format_3814 a owl:Class ;
    rdfs:label "edam:format_3814" ;
    dcterms:title "SDF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SDF is one of a family of chemical-data file formats developed by MDL Information Systems; it is intended especially for structural information." .

edam:format_3815 a owl:Class ;
    rdfs:label "edam:format_3815" ;
    dcterms:title "Molfile" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An MDL Molfile is a file format for holding information about the atoms, bonds, connectivity and coordinates of a molecule." .

edam:format_3816 a owl:Class ;
    rdfs:label "edam:format_3816" ;
    dcterms:title "Mol2" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Complete, portable representation of a SYBYL molecule. ASCII file which contains all the information needed to reconstruct a SYBYL molecule." .

edam:format_3817 a owl:Class ;
    rdfs:label "edam:format_3817" ;
    dcterms:title "latex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "format for the LaTeX document preparation system." .

edam:format_3818 a owl:Class ;
    rdfs:label "edam:format_3818" ;
    dcterms:title "ELAND format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tab-delimited text file format used by Eland - the read-mapping program distributed by Illumina with its sequencing analysis pipeline - which maps short Solexa sequence reads to the human reference genome." .

edam:format_3819 a owl:Class ;
    rdfs:label "edam:format_3819" ;
    dcterms:title "Relaxed PHYLIP Interleaved" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Phylip multiple alignment sequence format, less stringent than PHYLIP format." .

edam:format_3820 a owl:Class ;
    rdfs:label "edam:format_3820" ;
    dcterms:title "Relaxed PHYLIP Sequential" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Phylip multiple alignment sequence format, less stringent than PHYLIP sequential format (format_1998)." .

edam:format_3821 a owl:Class ;
    rdfs:label "edam:format_3821" ;
    dcterms:title "VisML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Default XML format of VisANT, containing all the network information." .

edam:format_3822 a owl:Class ;
    rdfs:label "edam:format_3822" ;
    dcterms:title "GML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GML (Graph Modeling Language) is a text file format supporting network data with a very easy syntax. It is used by Graphlet, Pajek, yEd, LEDA and NetworkX." .

edam:format_3823 a owl:Class ;
    rdfs:label "edam:format_3823" ;
    dcterms:title "FASTG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "FASTG is a format for faithfully representing genome assemblies in the face of allelic polymorphism and assembly uncertainty." .

edam:format_3824 a owl:Class ;
    rdfs:label "edam:format_3824" ;
    dcterms:title "NMR data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for raw data from a nuclear magnetic resonance (NMR) spectroscopy experiment." .

edam:format_3825 a owl:Class ;
    rdfs:label "edam:format_3825" ;
    dcterms:title "nmrML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "nmrML is an MSI supported XML-based open access format for metabolomics NMR raw and processed spectral data. It is accompanies by an nmrCV (controlled vocabulary) to allow ontology-based annotations." .

edam:format_3826 a owl:Class ;
    rdfs:label "edam:format_3826" ;
    dcterms:title "proBAM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition ". proBAM is an adaptation of BAM (format_2572), which was extended to meet specific requirements entailed by proteomics data." .

edam:format_3827 a owl:Class ;
    rdfs:label "edam:format_3827" ;
    dcterms:title "proBED" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition ". proBED is an adaptation of BED (format_3003), which was extended to meet specific requirements entailed by proteomics data." .

edam:format_3828 a owl:Class ;
    rdfs:label "edam:format_3828" ;
    dcterms:title "Raw microarray data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for raw microarray data." .

edam:format_3829 a owl:Class ;
    rdfs:label "edam:format_3829" ;
    dcterms:title "GPR" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GenePix Results (GPR) text file format developed by Axon Instruments that is used to save GenePix Results data." .

edam:format_3830 a owl:Class ;
    rdfs:label "edam:format_3830" ;
    dcterms:title "ARB" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Binary format used by the ARB software suite." .

edam:format_3832 a owl:Class ;
    rdfs:label "edam:format_3832" ;
    dcterms:title "consensusXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "OpenMS format for grouping features in one map or across several maps." .

edam:format_3833 a owl:Class ;
    rdfs:label "edam:format_3833" ;
    dcterms:title "featureXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "OpenMS format for quantitation results (LC/MS features)." .

edam:format_3834 a owl:Class ;
    rdfs:label "edam:format_3834" ;
    dcterms:title "mzData" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Now deprecated data format of the HUPO Proteomics Standards Initiative. Replaced by mzML (format_3244)." .

edam:format_3835 a owl:Class ;
    rdfs:label "edam:format_3835" ;
    dcterms:title "TIDE TXT" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format supported by the Tide tool for identifying peptides from tandem mass spectra." .

edam:format_3836 a owl:Class ;
    rdfs:label "edam:format_3836" ;
    dcterms:title "BLAST XML v2 results format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format as produced by the NCBI Blast package v2." .

edam:format_3838 a owl:Class ;
    rdfs:label "edam:format_3838" ;
    dcterms:title "pptx" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Microsoft Powerpoint format." .

edam:format_3839 a owl:Class ;
    rdfs:label "edam:format_3839" ;
    dcterms:title "ibd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ibd is a data format for mass spectrometry imaging data." .

edam:format_3841 a owl:Class ;
    rdfs:label "edam:format_3841" ;
    dcterms:title "NLP format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format used in Natural Language Processing." .

edam:format_3843 a owl:Class ;
    rdfs:label "edam:format_3843" ;
    dcterms:title "BEAST" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML input file format for BEAST Software (Bayesian Evolutionary Analysis Sampling Trees)." .

edam:format_3844 a owl:Class ;
    rdfs:label "edam:format_3844" ;
    dcterms:title "Chado-XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Chado-XML format is a direct mapping of the Chado relational schema into XML." .

edam:format_3845 a owl:Class ;
    rdfs:label "edam:format_3845" ;
    dcterms:title "HSAML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An alignment format generated by PRANK/PRANKSTER consisting of four elements: newick, nodes, selection and model." .

edam:format_3846 a owl:Class ;
    rdfs:label "edam:format_3846" ;
    dcterms:title "InterProScan XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Output xml file from the InterProScan sequence analysis application." .

edam:format_3847 a owl:Class ;
    rdfs:label "edam:format_3847" ;
    dcterms:title "KGML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The KEGG Markup Language (KGML) is an exchange format of the KEGG pathway maps, which is converted from internally used KGML+ (KGML+SVG) format." .

edam:format_3848 a owl:Class ;
    rdfs:label "edam:format_3848" ;
    dcterms:title "PubMed XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for collected entries from bibliographic databases MEDLINE and PubMed." .

edam:format_3849 a owl:Class ;
    rdfs:label "edam:format_3849" ;
    dcterms:title "MSAML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A set of XML compliant markup components for describing multiple sequence alignments." .

edam:format_3850 a owl:Class ;
    rdfs:label "edam:format_3850" ;
    dcterms:title "OrthoXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "OrthoXML is designed broadly to allow the storage and comparison of orthology data from any ortholog database. It establishes a structure for describing orthology relationships while still allowing flexibility for database-specific information to be encapsulated in the same format." .

edam:format_3851 a owl:Class ;
    rdfs:label "edam:format_3851" ;
    dcterms:title "PSDML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tree structure of Protein Sequence Database Markup Language generated using Matra software." .

edam:format_3852 a owl:Class ;
    rdfs:label "edam:format_3852" ;
    dcterms:title "SeqXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SeqXML is an XML Schema to describe biological sequences, developed by the Stockholm Bioinformatics Centre." .

edam:format_3853 a owl:Class ;
    rdfs:label "edam:format_3853" ;
    dcterms:title "UniParc XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for the UniParc database." .

edam:format_3854 a owl:Class ;
    rdfs:label "edam:format_3854" ;
    dcterms:title "UniRef XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for the UniRef reference clusters." .

edam:format_3857 a owl:Class ;
    rdfs:label "edam:format_3857" ;
    dcterms:title "CWL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Common Workflow Language (CWL) format for description of command-line tools and workflows." .

edam:format_3858 a owl:Class ;
    rdfs:label "edam:format_3858" ;
    dcterms:title "Waters RAW" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Proprietary file format for mass spectrometry data from Waters." .

edam:format_3859 a owl:Class ;
    rdfs:label "edam:format_3859" ;
    dcterms:title "JCAMP-DX" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A standardized file format for data exchange in mass spectrometry, initially developed for infrared spectrometry." .

edam:format_3862 a owl:Class ;
    rdfs:label "edam:format_3862" ;
    dcterms:title "NLP annotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An NLP format used for annotated textual documents." .

edam:format_3863 a owl:Class ;
    rdfs:label "edam:format_3863" ;
    dcterms:title "NLP corpus format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "NLP format used by a specific type of corpus (collection of texts)." .

edam:format_3864 a owl:Class ;
    rdfs:label "edam:format_3864" ;
    dcterms:title "mirGFF3" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mirGFF3 is a common format for microRNA data resulting from small-RNA RNA-Seq workflows." .

edam:format_3865 a owl:Class ;
    rdfs:label "edam:format_3865" ;
    dcterms:title "RNA annotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A \"placeholder\" concept for formats of annotated RNA data, including e.g. microRNA and RNA-Seq data." .

edam:format_3866 a owl:Class ;
    rdfs:label "edam:format_3866" ;
    dcterms:title "Trajectory format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "File format to store trajectory information for a 3D structure ." .

edam:format_3867 a owl:Class ;
    rdfs:label "edam:format_3867" ;
    dcterms:title "Trajectory format (binary)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Binary file format to store trajectory information for a 3D structure ." .

edam:format_3868 a owl:Class ;
    rdfs:label "edam:format_3868" ;
    dcterms:title "Trajectory format (text)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Textual file format to store trajectory information for a 3D structure ." .

edam:format_3873 a owl:Class ;
    rdfs:label "edam:format_3873" ;
    dcterms:title "HDF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "HDF is the name of a set of file formats and libraries designed to store and organize large amounts of numerical data, originally developed at the National Center for Supercomputing Applications at the University of Illinois." .

edam:format_3874 a owl:Class ;
    rdfs:label "edam:format_3874" ;
    dcterms:title "PCAzip" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PCAZip format is a binary compressed file to store atom coordinates based on Essential Dynamics (ED) and Principal Component Analysis (PCA)." .

edam:format_3875 a owl:Class ;
    rdfs:label "edam:format_3875" ;
    dcterms:title "XTC" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Portable binary format for trajectories produced by GROMACS package." .

edam:format_3876 a owl:Class ;
    rdfs:label "edam:format_3876" ;
    dcterms:title "TNG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Trajectory Next Generation (TNG) is a format for storage of molecular simulation data. It is designed and implemented by the GROMACS development group, and it is called to be the substitute of the XTC format." .

edam:format_3877 a owl:Class ;
    rdfs:label "edam:format_3877" ;
    dcterms:title "XYZ" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The XYZ chemical file format is widely supported by many programs, although many slightly different XYZ file formats coexist (Tinker XYZ, UniChem XYZ, etc.). Basic information stored for each atom in the system are x, y and z coordinates and atom element/atomic number." .

edam:format_3878 a owl:Class ;
    rdfs:label "edam:format_3878" ;
    dcterms:title "mdcrd" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AMBER trajectory (also called mdcrd), with 10 coordinates per line and format F8.3 (fixed point notation with field width 8 and 3 decimal places)." .

edam:format_3879 a owl:Class ;
    rdfs:label "edam:format_3879" ;
    dcterms:title "Topology format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of topology files; containing the static information of a structure molecular system that is needed for a molecular simulation." .

edam:format_3880 a owl:Class ;
    rdfs:label "edam:format_3880" ;
    dcterms:title "GROMACS top" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GROMACS MD package top textual files define an entire structure system topology, either directly, or by including itp files." .

edam:format_3881 a owl:Class ;
    rdfs:label "edam:format_3881" ;
    dcterms:title "AMBER top" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AMBER Prmtop file (version 7) is a structure topology text file divided in several sections designed to be parsed easily using simple Fortran code. Each section contains particular topology information, such as atom name, charge, mass, angles, dihedrals, etc." .

edam:format_3882 a owl:Class ;
    rdfs:label "edam:format_3882" ;
    dcterms:title "PSF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "X-Plor Protein Structure Files (PSF) are structure topology files used by NAMD and CHARMM molecular simulations programs. PSF files contain six main sections of interest: atoms, bonds, angles, dihedrals, improper dihedrals (force terms used to maintain planarity) and cross-terms." .

edam:format_3883 a owl:Class ;
    rdfs:label "edam:format_3883" ;
    dcterms:title "GROMACS itp" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GROMACS itp files (include topology) contain structure topology information, and are typically included in GROMACS topology files (GROMACS top). Itp files are used to define individual (or multiple) components of a topology as a separate file. This is particularly useful if there is a molecule that is used frequently, and also reduces the size of the system topology file, splitting it in different parts." .

edam:format_3884 a owl:Class ;
    rdfs:label "edam:format_3884" ;
    dcterms:title "FF parameter format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of force field parameter files, which store the set of parameters (charges, masses, radii, bond lengths, bond dihedrals, etc.) that are essential for the proper description and simulation of a molecular system." .

edam:format_3885 a owl:Class ;
    rdfs:label "edam:format_3885" ;
    dcterms:title "BinPos" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Scripps Research Institute BinPos format is a binary formatted file to store atom coordinates." .

edam:format_3886 a owl:Class ;
    rdfs:label "edam:format_3886" ;
    dcterms:title "RST" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AMBER coordinate/restart file with 6 coordinates per line and decimal format F12.7 (fixed point notation with field width 12 and 7 decimal places)." .

edam:format_3887 a owl:Class ;
    rdfs:label "edam:format_3887" ;
    dcterms:title "CHARMM rtf" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of CHARMM Residue Topology Files (RTF), which define groups by including the atoms, the properties of the group, and bond and charge information." .

edam:format_3888 a owl:Class ;
    rdfs:label "edam:format_3888" ;
    dcterms:title "AMBER frcmod" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AMBER frcmod (Force field Modification) is a file format to store any modification to the standard force field needed for a particular molecule to be properly represented in the simulation." .

edam:format_3889 a owl:Class ;
    rdfs:label "edam:format_3889" ;
    dcterms:title "AMBER off" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AMBER Object File Format library files (OFF library files) store residue libraries (forcefield residue parameters)." .

edam:format_3906 a owl:Class ;
    rdfs:label "edam:format_3906" ;
    dcterms:title "NMReDATA" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MReData is a text based data standard for processed NMR data. It is relying on SDF molecule data and allows to store assignments of NMR peaks to molecule features. The NMR-extracted data (or \"NMReDATA\") includes: Chemical shift,scalar coupling, 2D correlation, assignment, etc." .

edam:format_3909 a owl:Class ;
    rdfs:label "edam:format_3909" ;
    dcterms:title "BpForms" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BpForms is a string format for concretely representing the primary structures of biopolymers, including DNA, RNA, and proteins that include non-canonical nucleic and amino acids. See https://www.bpforms.org for more information." .

edam:format_3910 a owl:Class ;
    rdfs:label "edam:format_3910" ;
    dcterms:title "trr" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of trr files that contain the trajectory of a simulation experiment used by GROMACS." .

edam:format_3911 a owl:Class ;
    rdfs:label "edam:format_3911" ;
    dcterms:title "msh" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Mash sketch is a format for sequence / sequence checksum information. To make a sketch, each k-mer in a sequence is hashed, which creates a pseudo-random identifier. By sorting these hashes, a small subset from the top of the sorted list can represent the entire sequence." .

edam:format_3913 a owl:Class ;
    rdfs:label "edam:format_3913" ;
    dcterms:title "Loom" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The Loom file format is based on HDF5, a standard for storing large numerical datasets. The Loom format is designed to efficiently hold large omics datasets. Typically, such data takes the form of a large matrix of numbers, along with metadata for the rows and columns." .

edam:format_3915 a owl:Class ;
    rdfs:label "edam:format_3915" ;
    dcterms:title "Zarr" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The Zarr format is an implementation of chunked, compressed, N-dimensional arrays for storing data." .

edam:format_3916 a owl:Class ;
    rdfs:label "edam:format_3916" ;
    dcterms:title "MTX" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The Matrix Market matrix (MTX) format stores numerical or pattern matrices in a dense (array format) or sparse (coordinate format) representation." .

edam:format_3951 a owl:Class ;
    rdfs:label "edam:format_3951" ;
    dcterms:title "BcForms" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BcForms is a format for abstractly describing the molecular structure (atoms and bonds) of macromolecular complexes as a collection of subunits and crosslinks. Each subunit can be described with BpForms (http://edamontology.org/format_3909) or SMILES (http://edamontology.org/data_2301). BcForms uses an ontology of crosslinks to abstract the chemical details of crosslinks from the descriptions of complexes (see https://bpforms.org/crosslink.html)." .

edam:format_3956 a owl:Class ;
    rdfs:label "edam:format_3956" ;
    dcterms:title "N-Quads" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "N-Quads is a line-based, plain text format for encoding an RDF dataset. It includes information about the graph each triple belongs to." .

edam:format_3969 a owl:Class ;
    rdfs:label "edam:format_3969" ;
    dcterms:title "Vega" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Vega is a visualization grammar, a declarative language for creating, saving, and sharing interactive visualization designs. With Vega, you can describe the visual appearance and interactive behavior of a visualization in a JSON format, and generate web-based views using Canvas or SVG." .

edam:format_3970 a owl:Class ;
    rdfs:label "edam:format_3970" ;
    dcterms:title "Vega-lite" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Vega-Lite is a high-level grammar of interactive graphics. It provides a concise JSON syntax for rapidly generating visualizations to support analysis. Vega-Lite specifications can be compiled to Vega specifications." .

edam:format_3971 a owl:Class ;
    rdfs:label "edam:format_3971" ;
    dcterms:title "NeuroML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A model description language for computational neuroscience." .

edam:format_3972 a owl:Class ;
    rdfs:label "edam:format_3972" ;
    dcterms:title "BNGL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioNetGen is a format for the specification and simulation of rule-based models of biochemical systems, including signal transduction, metabolic, and genetic regulatory networks." .

edam:format_3973 a owl:Class ;
    rdfs:label "edam:format_3973" ;
    dcterms:title "Docker image" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A Docker image is a file, comprised of multiple layers, that is used to execute code in a Docker container. An image is essentially built from the instructions for a complete and executable version of an application, which relies on the host OS kernel." .

edam:format_3975 a owl:Class ;
    rdfs:label "edam:format_3975" ;
    dcterms:title "GFA 1" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Graphical Fragment Assembly captures sequence graphs as the product of an assembly, a representation of variation in genomes, splice graphs in genes, or even overlap between reads from long-read sequencing technology." .

edam:format_3976 a owl:Class ;
    rdfs:label "edam:format_3976" ;
    dcterms:title "GFA 2" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Graphical Fragment Assembly captures sequence graphs as the product of an assembly, a representation of variation in genomes, splice graphs in genes, or even overlap between reads from long-read sequencing technology. GFA2 is an update of GFA1 which is not compatible with GFA1." .

edam:format_3977 a owl:Class ;
    rdfs:label "edam:format_3977" ;
    dcterms:title "ObjTables" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ObjTables is a toolkit for creating reusable datasets that are both human and machine-readable, combining the ease of spreadsheets (e.g., Excel workbooks) with the rigor of schemas (classes, their attributes, the type of each attribute, and the possible relationships between instances of classes). ObjTables consists of a format for describing schemas for spreadsheets, numerous data types for science, a syntax for indicating the class and attribute represented by each table and column in a workbook, and software for using schemas to rigorously validate, merge, split, compare, and revision datasets." .

edam:format_3978 a owl:Class ;
    rdfs:label "edam:format_3978" ;
    dcterms:title "CONTIG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The CONTIG format used for output of the SOAPdenovo alignment program. It contains contig sequences generated without using mate pair information." .

edam:format_3979 a owl:Class ;
    rdfs:label "edam:format_3979" ;
    dcterms:title "WEGO" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "WEGO native format used by the Web Gene Ontology Annotation Plot application.   Tab-delimited format with gene names and others GO IDs (columns) with one annotation record per line." .

edam:format_3980 a owl:Class ;
    rdfs:label "edam:format_3980" ;
    dcterms:title "RPKM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tab-delimited format for gene expression levels table, calculated as Reads Per Kilobase per Million (RPKM) mapped reads." .

edam:format_3981 a owl:Class ;
    rdfs:label "edam:format_3981" ;
    dcterms:title "TAR format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "TAR archive file format generated by the Unix-based utility tar." .

edam:format_3982 a owl:Class ;
    rdfs:label "edam:format_3982" ;
    dcterms:title "CHAIN" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The CHAIN format describes a pairwise alignment that allow gaps in both sequences simultaneously and is used by the UCSC Genome Browser." .

edam:format_3983 a owl:Class ;
    rdfs:label "edam:format_3983" ;
    dcterms:title "NET" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The NET file format is used to describe the data that underlie the net alignment annotations in the UCSC Genome Browser." .

edam:format_3984 a owl:Class ;
    rdfs:label "edam:format_3984" ;
    dcterms:title "QMAP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of QMAP files generated for methylation data from an internal BGI pipeline." .

edam:format_3985 a owl:Class ;
    rdfs:label "edam:format_3985" ;
    dcterms:title "gxformat2" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An emerging format for high-level Galaxy workflow description." .

edam:format_3986 a owl:Class ;
    rdfs:label "edam:format_3986" ;
    dcterms:title "WMV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The proprietary native video format of various Microsoft programs such as Windows Media Player." .

edam:format_3987 a owl:Class ;
    rdfs:label "edam:format_3987" ;
    dcterms:title "ZIP format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ZIP is an archive file format that supports lossless data compression." .

edam:format_3988 a owl:Class ;
    rdfs:label "edam:format_3988" ;
    dcterms:title "LSM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Zeiss' proprietary image format based on TIFF." .

edam:format_3989 a owl:Class ;
    rdfs:label "edam:format_3989" ;
    dcterms:title "GZIP format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GNU zip compressed file format common to Unix-based operating systems." .

edam:format_3990 a owl:Class ;
    rdfs:label "edam:format_3990" ;
    dcterms:title "AVI" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Audio Video Interleaved (AVI) format is a multimedia container format for AVI files, that allows synchronous audio-with-video playback." .

edam:format_3991 a owl:Class ;
    rdfs:label "edam:format_3991" ;
    dcterms:title "TrackDB" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A declaration file format for UCSC browsers track dataset display characteristics." .

edam:format_3992 a owl:Class ;
    rdfs:label "edam:format_3992" ;
    dcterms:title "CIGAR format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Compact Idiosyncratic Gapped Alignment Report format is a compressed (run-length encoded) pairwise alignment format. It is useful for representing long (e.g. genomic) pairwise alignments." .

edam:format_3993 a owl:Class ;
    rdfs:label "edam:format_3993" ;
    dcterms:title "Stereolithography format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "STL is a file format native to the stereolithography CAD software created by 3D Systems. The format is used to save and share surface-rendered 3D images and also for 3D printing." .

edam:format_3994 a owl:Class ;
    rdfs:label "edam:format_3994" ;
    dcterms:title "U3D" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "U3D (Universal 3D) is a compressed file format and data structure for 3D computer graphics. It contains 3D model information such as triangle meshes, lighting, shading, motion data, lines and points with color and structure." .

edam:format_3995 a owl:Class ;
    rdfs:label "edam:format_3995" ;
    dcterms:title "Texture file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Bitmap image format used for storing textures." .

edam:format_3996 a owl:Class ;
    rdfs:label "edam:format_3996" ;
    dcterms:title "Python script" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for scripts writtenin Python - a widely used high-level programming language for general-purpose programming." .

edam:format_3997 a owl:Class ;
    rdfs:label "edam:format_3997" ;
    dcterms:title "MPEG-4" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A digital multimedia container format most commonly used to store video and audio." .

edam:format_3998 a owl:Class ;
    rdfs:label "edam:format_3998" ;
    dcterms:title "Perl script" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for scripts written in Perl - a family of high-level, general-purpose, interpreted, dynamic programming languages." .

edam:format_3999 a owl:Class ;
    rdfs:label "edam:format_3999" ;
    dcterms:title "R script" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for scripts written in the R language - an open source programming language and software environment for statistical computing and graphics that is supported by the R Foundation for Statistical Computing." .

edam:format_4000 a owl:Class ;
    rdfs:label "edam:format_4000" ;
    dcterms:title "R markdown" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A file format for making dynamic documents (R Markdown scripts) with the R language." .

edam:format_4002 a owl:Class ;
    rdfs:label "edam:format_4002" ;
    dcterms:title "pickle" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format used by Python pickle module for serializing and de-serializing a Python object structure." .

edam:format_4003 a owl:Class ;
    rdfs:label "edam:format_4003" ;
    dcterms:title "NumPy format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The standard binary file format used by NumPy - a fundamental package for scientific computing with Python - for persisting a single arbitrary NumPy array on disk. The format stores all of the shape and dtype information necessary to reconstruct the array correctly." .

edam:format_4004 a owl:Class ;
    rdfs:label "edam:format_4004" ;
    dcterms:title "SimTools repertoire file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of repertoire (archive) files that can be read by SimToolbox (a MATLAB toolbox for structured illumination fluorescence microscopy) or alternatively extracted with zip file archiver software." .

edam:format_4005 a owl:Class ;
    rdfs:label "edam:format_4005" ;
    dcterms:title "Configuration file format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A configuration file used by various programs to store settings that are specific to their respective software." .

edam:format_4006 a owl:Class ;
    rdfs:label "edam:format_4006" ;
    dcterms:title "Zstandard format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format used by the Zstandard real-time compression algorithm." .

edam:format_4007 a owl:Class ;
    rdfs:label "edam:format_4007" ;
    dcterms:title "MATLAB script" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The file format for MATLAB scripts or functions." .

edam:format_4015 a owl:Class ;
    rdfs:label "edam:format_4015" ;
    dcterms:title "PEtab" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A data format for specifying parameter estimation problems in systems biology." .

edam:format_4018 a owl:Class ;
    rdfs:label "edam:format_4018" ;
    dcterms:title "gVCF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Genomic Variant Call Format (gVCF) is a version of VCF that includes not only the positions that are variant when compared to a reference genome, but also the non-variant positions as ranges, including metrics of confidence that the positions in the range are actually non-variant e.g. minimum read-depth and genotype quality." .

edam:format_4023 a owl:Class ;
    rdfs:label "edam:format_4023" ;
    dcterms:title "cml" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Chemical Markup Language (CML) is an XML-based format for encoding detailed information about a wide range of chemical concepts." .

edam:format_4024 a owl:Class ;
    rdfs:label "edam:format_4024" ;
    dcterms:title "cif" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Crystallographic Information File (CIF) is a data exchange standard file format for Crystallographic Information and related Structural Science data." .

edam:format_4025 a owl:Class ;
    rdfs:label "edam:format_4025" ;
    dcterms:title "BioSimulators format for the specifications of biosimulation tools" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for describing the capabilities of a biosimulation tool including the modeling frameworks, simulation algorithms, and modeling formats that it supports, as well as metadata such as a list of the interfaces, programming languages, and operating systems supported by the tool; a link to download the tool; a list of the authors of the tool; and the license to the tool." .

edam:format_4026 a owl:Class ;
    rdfs:label "edam:format_4026" ;
    dcterms:title "BioSimulators standard for command-line interfaces for biosimulation tools" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Outlines the syntax and semantics of the input and output arguments for command-line interfaces for biosimulation tools." .

edam:format_4035 a owl:Class ;
    rdfs:label "edam:format_4035" ;
    dcterms:title "PQR" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format derived from the standard PDB format, which enables user to incorporate parameters for charge and radius to the existing PDB data file." .

edam:format_4036 a owl:Class ;
    rdfs:label "edam:format_4036" ;
    dcterms:title "PDBQT" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format used in AutoDock 4 for storing atomic coordinates, partial atomic charges and AutoDock atom types for both receptors and ligands." .

edam:format_4039 a owl:Class ;
    rdfs:label "edam:format_4039" ;
    dcterms:title "MSP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MSP is a data format for mass spectrometry data." .

edam:format_4041 a owl:Class ;
    rdfs:label "edam:format_4041" ;
    dcterms:title "maDMP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "maDMP stands for machine-actionable data management plan, a standard for DMPs developed by the Research Data Alliance (RDA)." .

edam:format_4048 a owl:Class ;
    rdfs:label "edam:format_4048" ;
    dcterms:title "Nextflow" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Nextflow is a workflow system for creating scalable, portable, and reproducible workflows." .

edam:format_4049 a owl:Class ;
    rdfs:label "edam:format_4049" ;
    dcterms:title "Snakemake" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The Snakemake workflow management system is a tool to create reproducible and scalable data analyses." .

edam:format_4050 a owl:Class ;
    rdfs:label "edam:format_4050" ;
    dcterms:title "SDRF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Sample and Data Relationship File for a proteomics experiment." .

edam:format_4058 a owl:Class ;
    rdfs:label "edam:format_4058" ;
    dcterms:title "mzTab-M" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzTab-M is a light-weight, tab-delimited format for mass spectrometry-based chemical profiling data, including metabolomics." .

edam:format_4059 a owl:Class ;
    rdfs:label "edam:format_4059" ;
    dcterms:title "mzTab-L" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzTab-L is a light-weight, tab-delimited format for mass spectrometry-based lipidomics data. It is a compatible version of mzTab-M, with additional rules and information standard (reporting guidelines)." .

edam:format_4066 a owl:Class ;
    rdfs:label "edam:format_4066" ;
    dcterms:title "ISA-Tab Investigation file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ISA-Tab Investigation file (i_Investigation.txt) contains metadata describing the overall goals, means, and context of an investigation/experiment, including references to associated Study and Assay files." .

edam:format_4067 a owl:Class ;
    rdfs:label "edam:format_4067" ;
    dcterms:title "ISA-Tab Study file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ISA-Tab Study file (s_*.txt) contains sample metadata describing the subjects under study, their sources, characteristics, sampling methodology, and any treatments or manipulations applied." .

edam:format_4068 a owl:Class ;
    rdfs:label "edam:format_4068" ;
    dcterms:title "ISA-Tab Assay file" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ISA-Tab Assay file (a_*.txt) contains assay metadata describing test steps and analytical measurements performed on the sample material, including measurement types, technology used, and references to raw and derived data files." .

edam:format_4069 a owl:Class ;
    rdfs:label "edam:format_4069" ;
    dcterms:title "ISA-JSON" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ISA-JSON stands for Investigation / Study / Assay (ISA) JavaScript Object Notation (JSON) format, and it is comprised of metadata describing observational or experimental scientific studies." .

edam:format_4070 a owl:Class ;
    rdfs:label "edam:format_4070" ;
    dcterms:title "mwTab" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mwTab is a tab-delimited text format developed by the Metabolomics Workbench to facilitate programmatic processing of metabolomics data and metadata suitable for submission to the repository." .

edam:format_4071 a owl:Class ;
    rdfs:label "edam:format_4071" ;
    dcterms:title "MHD" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MHD (MetabolomicsHub Common Data Model) is a JSON-based format providing a standardised, FAIR-compliant data model for the exchange, discovery, and reuse of metabolomics dataset metadata across international repositories." .

edam:format_4072 a owl:Class ;
    rdfs:label "edam:format_4072" ;
    dcterms:title "MHD announcement" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The MHD announcement file is a JSON-based format used to notify MetabolomicsHub of new or updated dataset submissions, serving as a manifest or notification file within the MHD data flow." .

edam:format_4073 a owl:Class ;
    rdfs:label "edam:format_4073" ;
    dcterms:title "MetaboLights MAF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MetaboLights MAF (Metabolite Annotation File) is a tab-separated file format used to report metabolites identified or annotated in a metabolomics study, including compound identifiers, chemical structure representations, mass-to-charge ratios, retention times, and per-sample quantitative measurements." .

edam:topic_0077 a owl:Class ;
    rdfs:label "edam:topic_0077" ;
    dcterms:title "Nucleic acids" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The processing and analysis of nucleic acid sequence, structural and other data." .

edam:topic_0078 a owl:Class ;
    rdfs:label "edam:topic_0078" ;
    dcterms:title "Proteins" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Archival, processing and analysis of protein data, typically molecular sequence and structural data." .

edam:topic_0080 a owl:Class ;
    rdfs:label "edam:topic_0080" ;
    dcterms:title "Sequence analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The archival, processing and analysis of molecular sequences (monomer composition of polymers) including molecular sequence data resources, sequence sites, alignments, motifs and profiles." .

edam:topic_0081 a owl:Class ;
    rdfs:label "edam:topic_0081" ;
    dcterms:title "Structure analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The curation, processing, analysis and prediction of data about the structure of biological molecules, typically proteins and nucleic acids and other macromolecules." .

edam:topic_0082 a owl:Class ;
    rdfs:label "edam:topic_0082" ;
    dcterms:title "Structure prediction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The prediction of molecular structure, including the prediction, modelling, recognition or design of protein secondary or tertiary structure or other structural features, and the folding of nucleic acid molecules and the prediction or design of nucleic acid (typically RNA) sequences with specific conformations." .

edam:topic_0084 a owl:Class ;
    rdfs:label "edam:topic_0084" ;
    dcterms:title "Phylogeny" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of evolutionary relationships amongst organisms." .

edam:topic_0085 a owl:Class ;
    rdfs:label "edam:topic_0085" ;
    dcterms:title "Functional genomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of gene or protein functions and their interactions in totality in a given organism, tissue, cell etc." .

edam:topic_0089 a owl:Class ;
    rdfs:label "edam:topic_0089" ;
    dcterms:title "Ontology and terminology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The conceptualisation, categorisation and nomenclature (naming) of entities or phenomena within biology or bioinformatics. This includes formal ontologies, controlled vocabularies, structured glossary, symbols and terminology or other related resource." .

edam:topic_0091 a owl:Class ;
    rdfs:label "edam:topic_0091" ;
    dcterms:title "Bioinformatics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The archival, curation, processing and analysis of complex biological data." .

edam:topic_0092 a owl:Class ;
    rdfs:label "edam:topic_0092" ;
    dcterms:title "Data visualisation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Rendering (drawing on a computer screen) or visualisation of molecular sequences, structures or other biomolecular data." .

edam:topic_0097 a owl:Class ;
    rdfs:label "edam:topic_0097" ;
    dcterms:title "Nucleic acid structure analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The archival, curation, processing and analysis of nucleic acid structural information, such as whole structures, structural features and alignments, and associated annotation." .

edam:topic_0099 a owl:Class ;
    rdfs:label "edam:topic_0099" ;
    dcterms:title "RNA" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "RNA sequences and structures." .

edam:topic_0102 a owl:Class ;
    rdfs:label "edam:topic_0102" ;
    dcterms:title "Mapping" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The mapping of complete (typically nucleotide) sequences. Mapping (in the sense of short read alignment, or more generally, just alignment) has application in RNA-Seq analysis (mapping of transcriptomics reads), variant discovery (e.g. mapping of exome capture), and re-sequencing (mapping of WGS reads)." .

edam:topic_0108 a owl:Class ;
    rdfs:label "edam:topic_0108" ;
    dcterms:title "Protein expression" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The translation of mRNA into protein and subsequent protein processing in the cell." .

edam:topic_0114 a owl:Class ;
    rdfs:label "edam:topic_0114" ;
    dcterms:title "Gene structure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Gene structure, regions which make an RNA product and features such as promoters, coding regions, gene fusion, splice sites etc." .

edam:topic_0121 a owl:Class ;
    rdfs:label "edam:topic_0121" ;
    dcterms:title "Proteomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Proteomics is in the narrow sense (sensu stricto) the application of methods to separate, characterise, identify, and quantify all proteins (the proteome) - or a substantial set of proteins - that are present in a sample. Proteomics in the broad sense is the science of proteins and peptides on the large scale." .

edam:topic_0122 a owl:Class ;
    rdfs:label "edam:topic_0122" ;
    dcterms:title "Structural genomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The elucidation of the three dimensional structure for all (available) proteins in a given organism." .

edam:topic_0123 a owl:Class ;
    rdfs:label "edam:topic_0123" ;
    dcterms:title "Protein properties" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of the physical and biochemical properties of peptides and proteins, for example the hydrophobic, hydrophilic and charge properties of a protein." .

edam:topic_0128 a owl:Class ;
    rdfs:label "edam:topic_0128" ;
    dcterms:title "Protein interactions" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein-protein, protein-DNA/RNA and protein-ligand interactions, including analysis of known interactions and prediction of putative interactions." .

edam:topic_0130 a owl:Class ;
    rdfs:label "edam:topic_0130" ;
    dcterms:title "Protein folding, stability and design" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein stability, folding (in 3D space) and protein sequence-structure-function relationships. This includes for example study of inter-atomic or inter-residue interactions in protein (3D) structures, the effect of mutation, and the design of proteins with specific properties, typically by designing changes (via site-directed mutagenesis) to an existing protein." .

edam:topic_0140 a owl:Class ;
    rdfs:label "edam:topic_0140" ;
    dcterms:title "Protein targeting and localisation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of how proteins are transported within and without the cell, including signal peptides, protein subcellular localisation and export." .

edam:topic_0152 a owl:Class ;
    rdfs:label "edam:topic_0152" ;
    dcterms:title "Carbohydrates" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Carbohydrates, typically including structural information." .

edam:topic_0153 a owl:Class ;
    rdfs:label "edam:topic_0153" ;
    dcterms:title "Lipidomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Lipids and their structures." .

edam:topic_0154 a owl:Class ;
    rdfs:label "edam:topic_0154" ;
    dcterms:title "Small molecules" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Small molecules of biological significance, typically archival, curation, processing and analysis of structural information." .

edam:topic_0157 a owl:Class ;
    rdfs:label "edam:topic_0157" ;
    dcterms:title "Sequence composition, complexity and repeats" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The archival, processing and analysis of the basic character composition of molecular sequences, for example character or word frequency, ambiguity, complexity, particularly regions of low complexity, and repeats or the repetitive nature of molecular sequences." .

edam:topic_0160 a owl:Class ;
    rdfs:label "edam:topic_0160" ;
    dcterms:title "Sequence sites, features and motifs" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The archival, detection, prediction and analysis of positional features such as functional and other key sites, in molecular sequences and the conserved patterns (motifs, profiles etc.) that may be used to describe them." .

edam:topic_0166 a owl:Class ;
    rdfs:label "edam:topic_0166" ;
    dcterms:title "Protein structural motifs and surfaces" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Structural features or common 3D motifs within protein structures, including the surface of a protein structure, such as biological interfaces with other molecules." .

edam:topic_0176 a owl:Class ;
    rdfs:label "edam:topic_0176" ;
    dcterms:title "Molecular dynamics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study and simulation of molecular (typically protein) conformation using a computational model of physical forces and computer simulation." .

edam:topic_0194 a owl:Class ;
    rdfs:label "edam:topic_0194" ;
    dcterms:title "Phylogenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The integrated study of evolutionary relationships and whole genome data, for example, in the analysis of species trees, horizontal gene transfer and evolutionary reconstruction." .

edam:topic_0196 a owl:Class ;
    rdfs:label "edam:topic_0196" ;
    dcterms:title "Sequence assembly" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The assembly of fragments of a DNA sequence to reconstruct the original sequence." .

edam:topic_0199 a owl:Class ;
    rdfs:label "edam:topic_0199" ;
    dcterms:title "Genetic variation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Stable, naturally occurring mutations in a nucleotide sequence including alleles, naturally occurring mutations such as single base nucleotide substitutions, deletions and insertions, RFLPs and other polymorphisms." .

edam:topic_0202 a owl:Class ;
    rdfs:label "edam:topic_0202" ;
    dcterms:title "Pharmacology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of drugs and their effects or responses in living systems." .

edam:topic_0203 a owl:Class ;
    rdfs:label "edam:topic_0203" ;
    dcterms:title "Gene expression" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The analysis of levels and patterns of synthesis of gene products (proteins and functional RNA) including interpretation in functional terms of gene expression data." .

edam:topic_0204 a owl:Class ;
    rdfs:label "edam:topic_0204" ;
    dcterms:title "Gene regulation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The regulation of gene expression." .

edam:topic_0208 a owl:Class ;
    rdfs:label "edam:topic_0208" ;
    dcterms:title "Pharmacogenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The influence of genotype on drug response, for example by correlating gene expression or single-nucleotide polymorphisms with drug efficacy or toxicity." .

edam:topic_0209 a owl:Class ;
    rdfs:label "edam:topic_0209" ;
    dcterms:title "Medicinal chemistry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The design and chemical synthesis of bioactive molecules, for example drugs or potential drug compounds, for medicinal purposes." .

edam:topic_0218 a owl:Class ;
    rdfs:label "edam:topic_0218" ;
    dcterms:title "Natural language processing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The processing and analysis of natural language, such as scientific literature in English, in order to extract data and information, or to enable human-computer interaction." .

edam:topic_0219 a owl:Class ;
    rdfs:label "edam:topic_0219" ;
    dcterms:title "Data curation and archival" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Data curation and archival includes the preservation of data in a repository, archive, or a deposition database; and curation of data and metadata, database accessions, annotation, and data provenance." .

edam:topic_0593 a owl:Class ;
    rdfs:label "edam:topic_0593" ;
    dcterms:title "NMR" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "An analytical technique that exploits the magenetic properties of certain atomic nuclei to provide information on the structure, dynamics, reaction state and chemical environment of molecules." .

edam:topic_0601 a owl:Class ;
    rdfs:label "edam:topic_0601" ;
    dcterms:title "Protein modifications" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein chemical modifications, e.g. post-translational modifications." .

edam:topic_0602 a owl:Class ;
    rdfs:label "edam:topic_0602" ;
    dcterms:title "Molecular interactions, pathways and networks" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Molecular interactions, biological pathways, networks and other models." .

edam:topic_0605 a owl:Class ;
    rdfs:label "edam:topic_0605" ;
    dcterms:title "Informatics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study and practice of information processing and use of computer information systems." .

edam:topic_0607 a owl:Class ;
    rdfs:label "edam:topic_0607" ;
    dcterms:title "Laboratory information management" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Laboratory management and resources, for example, catalogues of biological resources for use in the lab including cell lines, viruses, plasmids, phages, DNA probes and primers and so on." .

edam:topic_0610 a owl:Class ;
    rdfs:label "edam:topic_0610" ;
    dcterms:title "Ecology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The ecological and environmental sciences and especially the application of information technology (ecoinformatics)." .

edam:topic_0611 a owl:Class ;
    rdfs:label "edam:topic_0611" ;
    dcterms:title "Electron microscopy" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of matter by studying the interference pattern from firing electrons at a sample, to analyse structures at resolutions higher than can be achieved using light." .

edam:topic_0621 a owl:Class ;
    rdfs:label "edam:topic_0621" ;
    dcterms:title "Model organisms" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A specific organism, or group of organisms, used to study a particular aspect of biology." .

edam:topic_0622 a owl:Class ;
    rdfs:label "edam:topic_0622" ;
    dcterms:title "Genomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Whole genomes of one or more organisms, or genomes in general, such as meta-information on genomes, genome projects, gene names etc." .

edam:topic_0623 a owl:Class ;
    rdfs:label "edam:topic_0623" ;
    dcterms:title "Gene and protein families" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Particular gene(s), gene family or other gene group or system and their encoded proteins.Primarily the classification of proteins (from sequence or structural data) into clusters, groups, families etc., curation of a particular protein or protein family, or any other proteins that have been classified as members of a common group." .

edam:topic_0625 a owl:Class ;
    rdfs:label "edam:topic_0625" ;
    dcterms:title "Genotype and phenotype" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of genetic constitution of a living entity, such as an individual, and organism, a cell and so on, typically with respect to a particular observable phenotypic traits, or resources concerning such traits, which might be an aspect of biochemistry, physiology, morphology, anatomy, development and so on." .

edam:topic_0632 a owl:Class ;
    rdfs:label "edam:topic_0632" ;
    dcterms:title "Probes and primers" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Molecular probes (e.g. a peptide probe or DNA microarray probe) or PCR primers and hybridisation oligos in a nucleic acid sequence." .

edam:topic_0634 a owl:Class ;
    rdfs:label "edam:topic_0634" ;
    dcterms:title "Pathology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Diseases, including diseases in general and the genes, gene variations and proteins involved in one or more specific diseases." .

edam:topic_0637 a owl:Class ;
    rdfs:label "edam:topic_0637" ;
    dcterms:title "Taxonomy" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Organism classification, identification and naming." .

edam:topic_0654 a owl:Class ;
    rdfs:label "edam:topic_0654" ;
    dcterms:title "DNA" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNA sequences and structure, including processes such as methylation and replication." .

edam:topic_0659 a owl:Class ;
    rdfs:label "edam:topic_0659" ;
    dcterms:title "Functional, regulatory and non-coding RNA" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Non-coding or functional RNA sequences, including regulatory RNA sequences, ribosomal RNA (rRNA) and transfer RNA (tRNA)." .

edam:topic_0736 a owl:Class ;
    rdfs:label "edam:topic_0736" ;
    dcterms:title "Protein folds and structural domains" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein tertiary structural domains and folds in a protein or polypeptide chain." .

edam:topic_0749 a owl:Class ;
    rdfs:label "edam:topic_0749" ;
    dcterms:title "Transcription factors and regulatory sites" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Proteins that bind to DNA and control transcription of DNA to mRNA (transcription factors) and also transcriptional regulatory sites, elements and regions (such as promoters, enhancers, silencers and boundary elements / insulators) in nucleotide sequences." .

edam:topic_0769 a owl:Class ;
    rdfs:label "edam:topic_0769" ;
    dcterms:title "Workflows" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Biological or biomedical analytical workflows or pipelines." .

edam:topic_0780 a owl:Class ;
    rdfs:label "edam:topic_0780" ;
    dcterms:title "Plant biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Plants, e.g. information on a specific plant genome including molecular sequences, genes and annotation." .

edam:topic_0781 a owl:Class ;
    rdfs:label "edam:topic_0781" ;
    dcterms:title "Virology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Study of viruses, e.g. sequence and structural data, interactions of viral proteins, or a viral genome including molecular sequences, genes and annotation." .

edam:topic_0797 a owl:Class ;
    rdfs:label "edam:topic_0797" ;
    dcterms:title "Comparative genomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study (typically comparison) of the sequence, structure or function of multiple genomes." .

edam:topic_0798 a owl:Class ;
    rdfs:label "edam:topic_0798" ;
    dcterms:title "Mobile genetic elements" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Mobile genetic elements, such as transposons, Plasmids, Bacteriophage elements and Group II introns." .

edam:topic_0804 a owl:Class ;
    rdfs:label "edam:topic_0804" ;
    dcterms:title "Immunology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of information technology to immunology such as immunological processes, immunological genes, proteins and peptide ligands, antigens and so on." .

edam:topic_0820 a owl:Class ;
    rdfs:label "edam:topic_0820" ;
    dcterms:title "Membrane and lipoproteins" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Lipoproteins (protein-lipid assemblies), and proteins or region of a protein that spans or are associated with a membrane." .

edam:topic_0821 a owl:Class ;
    rdfs:label "edam:topic_0821" ;
    dcterms:title "Enzymes" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Proteins that catalyze chemical reaction, the kinetics of enzyme-catalysed reactions, enzyme nomenclature etc." .

edam:topic_1317 a owl:Class ;
    rdfs:label "edam:topic_1317" ;
    dcterms:title "Structural biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The molecular structure of biological molecules, particularly macromolecules such as proteins and nucleic acids." .

edam:topic_1775 a owl:Class ;
    rdfs:label "edam:topic_1775" ;
    dcterms:title "Function analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of gene and protein function including the prediction of functional properties of a protein." .

edam:topic_2229 a owl:Class ;
    rdfs:label "edam:topic_2229" ;
    dcterms:title "Cell biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Cells, such as key genes and proteins involved in the cell cycle." .

edam:topic_2258 a owl:Class ;
    rdfs:label "edam:topic_2258" ;
    dcterms:title "Cheminformatics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of information technology to chemistry in biological research environment." .

edam:topic_2259 a owl:Class ;
    rdfs:label "edam:topic_2259" ;
    dcterms:title "Systems biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The holistic modelling and analysis of complex biological systems and the interactions therein." .

edam:topic_2269 a owl:Class ;
    rdfs:label "edam:topic_2269" ;
    dcterms:title "Statistics and probability" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of statistical methods to biological problems." .

edam:topic_2275 a owl:Class ;
    rdfs:label "edam:topic_2275" ;
    dcterms:title "Molecular modelling" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The construction, analysis, evaluation, refinement etc. of models of a molecules properties or behaviour, including the modelling the structure of proteins in complex with small molecules or other macromolecules (docking)." .

edam:topic_2533 a owl:Class ;
    rdfs:label "edam:topic_2533" ;
    dcterms:title "DNA mutation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNA mutation." .

edam:topic_2640 a owl:Class ;
    rdfs:label "edam:topic_2640" ;
    dcterms:title "Oncology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of cancer, for example, genes and proteins implicated in cancer." .

edam:topic_2814 a owl:Class ;
    rdfs:label "edam:topic_2814" ;
    dcterms:title "Protein structure analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein secondary or tertiary structural data and/or associated annotation." .

edam:topic_2815 a owl:Class ;
    rdfs:label "edam:topic_2815" ;
    dcterms:title "Human biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of human beings in general, including the human genome and proteome." .

edam:topic_2828 a owl:Class ;
    rdfs:label "edam:topic_2828" ;
    dcterms:title "X-ray diffraction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of matter and their structure by means of the diffraction of X-rays, typically the diffraction pattern caused by the regularly spaced atoms of a crystalline sample." .

edam:topic_2830 a owl:Class ;
    rdfs:label "edam:topic_2830" ;
    dcterms:title "Immunoproteins and antigens" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Immunity-related proteins and their ligands." .

edam:topic_2840 a owl:Class ;
    rdfs:label "edam:topic_2840" ;
    dcterms:title "Toxicology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Toxins and the adverse effects of these chemical substances on living organisms." .

edam:topic_2885 a owl:Class ;
    rdfs:label "edam:topic_2885" ;
    dcterms:title "DNA polymorphism" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNA polymorphism." .

edam:topic_3047 a owl:Class ;
    rdfs:label "edam:topic_3047" ;
    dcterms:title "Molecular biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The molecular basis of biological activity, particularly the macromolecules (e.g. proteins and nucleic acids) that are essential to life." .

edam:topic_3050 a owl:Class ;
    rdfs:label "edam:topic_3050" ;
    dcterms:title "Biodiversity" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The degree of variation of life forms within a given ecosystem, biome or an entire planet." .

edam:topic_3053 a owl:Class ;
    rdfs:label "edam:topic_3053" ;
    dcterms:title "Genetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of genes, genetic variation and heredity in living organisms." .

edam:topic_3055 a owl:Class ;
    rdfs:label "edam:topic_3055" ;
    dcterms:title "Quantitative genetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The genes and genetic mechanisms such as Mendelian inheritance that underly continuous phenotypic traits (such as height or weight)." .

edam:topic_3056 a owl:Class ;
    rdfs:label "edam:topic_3056" ;
    dcterms:title "Population genetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The distribution of allele frequencies in a population of organisms and its change subject to evolutionary processes including natural selection, genetic drift, mutation and gene flow." .

edam:topic_3063 a owl:Class ;
    rdfs:label "edam:topic_3063" ;
    dcterms:title "Medical informatics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of information technology to health, disease and biomedicine." .

edam:topic_3064 a owl:Class ;
    rdfs:label "edam:topic_3064" ;
    dcterms:title "Developmental biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "How organisms grow and develop." .

edam:topic_3065 a owl:Class ;
    rdfs:label "edam:topic_3065" ;
    dcterms:title "Embryology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The development of organisms between the one-cell stage (typically the zygote) and the end of the embryonic stage." .

edam:topic_3067 a owl:Class ;
    rdfs:label "edam:topic_3067" ;
    dcterms:title "Anatomy" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The form and function of the structures of living organisms." .

edam:topic_3068 a owl:Class ;
    rdfs:label "edam:topic_3068" ;
    dcterms:title "Literature and language" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The scientific literature, language processing, reference information, and documentation." .

edam:topic_3070 a owl:Class ;
    rdfs:label "edam:topic_3070" ;
    dcterms:title "Biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of life and living organisms, including their morphology, biochemistry, physiology, development, evolution, and so on." .

edam:topic_3071 a owl:Class ;
    rdfs:label "edam:topic_3071" ;
    dcterms:title "Data management" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Data management comprises the practices and principles of taking care of data, other than analysing them. This includes for example taking care of the associated metadata, data formats, storage, preservation/archiving, access, and legal aspects related to using and sharing data." .

edam:topic_3077 a owl:Class ;
    rdfs:label "edam:topic_3077" ;
    dcterms:title "Data acquisition" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The acquisition of data, typically measurements of physical systems using any type of sampling system, or by another other means." .

edam:topic_3120 a owl:Class ;
    rdfs:label "edam:topic_3120" ;
    dcterms:title "Protein variants" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Protein sequence variants produced e.g. from alternative splicing, alternative promoter usage, alternative initiation and ribosomal frameshifting." .

edam:topic_3125 a owl:Class ;
    rdfs:label "edam:topic_3125" ;
    dcterms:title "DNA binding sites" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Nucleic acids binding to some other molecule." .

edam:topic_3127 a owl:Class ;
    rdfs:label "edam:topic_3127" ;
    dcterms:title "DNA replication and recombination" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNA replication or recombination." .

edam:topic_3168 a owl:Class ;
    rdfs:label "edam:topic_3168" ;
    dcterms:title "Sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The determination of complete (typically nucleotide) sequences, including those of genomes (full genome sequencing, de novo sequencing and resequencing), amplicons and transcriptomes." .

edam:topic_3169 a owl:Class ;
    rdfs:label "edam:topic_3169" ;
    dcterms:title "ChIP-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The analysis of protein-DNA interactions where chromatin immunoprecipitation (ChIP) is used in combination with massively parallel DNA sequencing to identify the binding sites of DNA-associated proteins." .

edam:topic_3170 a owl:Class ;
    rdfs:label "edam:topic_3170" ;
    dcterms:title "RNA-Seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A topic concerning high-throughput sequencing of cDNA to measure the RNA content (transcriptome) of a sample, for example, to investigate how different alleles of a gene are expressed, detect post-transcriptional mutations or identify gene fusions." .

edam:topic_3172 a owl:Class ;
    rdfs:label "edam:topic_3172" ;
    dcterms:title "Metabolomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The systematic study of metabolites, the chemical processes they are involved, and the chemical fingerprints of specific cellular processes in a whole cell, tissue, organ or organism." .

edam:topic_3173 a owl:Class ;
    rdfs:label "edam:topic_3173" ;
    dcterms:title "Epigenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of the epigenetic modifications of a whole cell, tissue, organism etc." .

edam:topic_3174 a owl:Class ;
    rdfs:label "edam:topic_3174" ;
    dcterms:title "Metagenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of genetic material recovered from environmental samples, and associated environmental data." .

edam:topic_3175 a owl:Class ;
    rdfs:label "edam:topic_3175" ;
    dcterms:title "Structural variation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Variation in chromosome structure including microscopic and submicroscopic types of variation such as deletions, duplications, copy-number variants, insertions, inversions and translocations." .

edam:topic_3176 a owl:Class ;
    rdfs:label "edam:topic_3176" ;
    dcterms:title "DNA packaging" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNA-histone complexes (chromatin), organisation of chromatin into nucleosomes and packaging into higher-order structures." .

edam:topic_3179 a owl:Class ;
    rdfs:label "edam:topic_3179" ;
    dcterms:title "ChIP-on-chip" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experimental techniques that combine chromatin immunoprecipitation ('ChIP') with microarray ('chip'). ChIP-on-chip is used for high-throughput study protein-DNA interactions." .

edam:topic_3277 a owl:Class ;
    rdfs:label "edam:topic_3277" ;
    dcterms:title "Sample collections" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
