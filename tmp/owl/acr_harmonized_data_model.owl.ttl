    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that uses a disease exacerbation in vivo intervention experiment." .

OBI:0001718 a owl:Class ;
