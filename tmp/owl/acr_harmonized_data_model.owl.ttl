edam:data_1525 a owl:Class ;
    rdfs:label "edam:data_1525" ;
    dcterms:title "Protein crystallizability" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
