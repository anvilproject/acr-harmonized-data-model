        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:concentration_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Concept ;
            owl:onProperty cam:concentration_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:quantity_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:quantity_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:quantity_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:aliquot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:aliquot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty cam:concentration_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:concentration_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:concentration_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:availability_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Sample ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:aliquot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:concentration_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty cam:quantity_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:quantity_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumAvailabilityStatus ;
            owl:onProperty cam:availability_status ],
        linkml:ClassDefinition ;
    skos:definition "A specific tube or amount of a biospecimen associated with a Sample." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:Assay a owl:Class ;
    rdfs:label "Assay" ;
    dcterms:title "Assay" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:assay_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:assay_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:assay_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:assay_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:ActivityDefinition ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:activity_definition_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Sample ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumAssayType ;
            owl:onProperty cam:assay_type ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:assay_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:assay_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:File ;
            owl:onProperty cam:file_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:file_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:assay_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:sample_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:assay_id ],
        linkml:ClassDefinition ;
    skos:definition "A specific assay that was performed on given subject(s) or sample(s)." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
