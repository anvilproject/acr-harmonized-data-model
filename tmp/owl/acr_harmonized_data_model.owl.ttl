OBI:0001659 a owl:Class ;
    rdfs:label "OBI:0001659" ;
    dcterms:title "flow cytometry assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A flow cytometry assay that detects the binding of an antigen with an antibody." .

OBI:0001660 a owl:Class ;
    rdfs:label "OBI:0001660" ;
    dcterms:title "intracellular material detection assay measuring epitope specific granzyme A release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
