edam:format_3467 a owl:Class ;
    rdfs:label "edam:format_3467" ;
    dcterms:title "GIF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Graphics Interchange Format." .

edam:format_3468 a owl:Class ;
    rdfs:label "edam:format_3468" ;
    dcterms:title "xls" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
