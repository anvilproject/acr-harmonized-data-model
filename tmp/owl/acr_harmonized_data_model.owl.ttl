edam:format_2554 a owl:Class ;
    rdfs:label "edam:format_2554" ;
    dcterms:title "Alignment format (text)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Text format for molecular sequence alignment information." .

edam:format_2555 a owl:Class ;
