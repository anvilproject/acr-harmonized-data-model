OBI:0001190 a owl:Class ;
    rdfs:label "OBI:0001190" ;
    dcterms:title "epitope treatment experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An epitope intervention experiment that tests the ability of inducing an epitope immune response to treat an existing disease  in the host." .

