edam:data_2024 a owl:Class ;
    rdfs:label "edam:data_2024" ;
    dcterms:title "Enzyme kinetics data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
