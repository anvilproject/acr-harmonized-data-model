OBI:0001719 a owl:Class ;
    rdfs:label "OBI:0001719" ;
    dcterms:title "assay measuring the association constant [KA] of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope binding constant determination assay that measures the association constant KA." .

OBI:0001721 a owl:Class ;
    rdfs:label "OBI:0001721" ;
