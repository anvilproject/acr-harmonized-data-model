    dcterms:title "competitive inhibition of binding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay that detects the inhibition of binding between 2 material entities known to form a complex by the addition of a third material entity of interest. Inhibition of binding between the 2 materials reflects binding by the third material." .

