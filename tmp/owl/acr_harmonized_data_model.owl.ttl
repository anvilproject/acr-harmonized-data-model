@prefix CHMO: <http://purl.obolibrary.org/obo/CHMO_> .
@prefix DUO: <http://purl.obolibrary.org/obo/DUO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix acr_harmonized_data_model: <https://w3id.org/anvilproject/acr-harmonized-data-model/> .
@prefix cam: <https://includedcc.org/common-access-model/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edam: <http://edamontology.org> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mesh: <http://id.nlm.nih.gov/mesh/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shex: <http://www.w3.org/ns/shex#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix snomedct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

xsd:boolean a rdfs:Datatype .

xsd:date a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:double a rdfs:Datatype .

xsd:time a rdfs:Datatype .

shex:iri a rdfs:Datatype .

shex:nonLiteral a rdfs:Datatype .

cam:Any a owl:Class ;
    rdfs:label "Any" ;
    rdfs:subClassOf linkml:ClassDefinition ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:Demographics a owl:Class ;
    rdfs:label "Demographics" ;
    dcterms:title "Demographics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumSex acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
            owl:onProperty cam:sex ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Subject ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:sex ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumRace acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
            owl:onProperty cam:race ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:race ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:age_at_first_engagement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:age_at_last_vital_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive -365 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 32507 ] ) ] ) ] ;
            owl:onProperty cam:age_at_first_engagement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:vital_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumVitalStatus acr_harmonized_data_model:EnumUnknown ) ] cam:Concept ) ] ;
            owl:onProperty cam:vital_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumEthnicity acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
            owl:onProperty cam:ethnicity ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive -365 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 32507 ] ) ] ) ] ;
            owl:onProperty cam:age_at_last_vital_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:age_at_first_engagement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:age_at_last_vital_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:ethnicity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:sex ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:ethnicity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:vital_status ],
        linkml:ClassDefinition ;
    skos:definition "Basic participant demographics summary" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:StudyMetadata a owl:Class ;
    rdfs:label "StudyMetadata" ;
    dcterms:title "Study Metadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:selection_criteria ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:actual_number_of_participants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:study_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:actual_number_of_participants ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumParticipantLifespanStage ;
            owl:onProperty cam:participant_lifespan_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cam:expected_number_of_participants ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumStudyDesign ) ] cam:Concept ) ] ;
            owl:onProperty cam:study_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:VirtualBiorepository ;
            owl:onProperty cam:vbr_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Study ;
            owl:onProperty cam:study_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:participant_lifespan_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumDataSourceType ;
            owl:onProperty cam:clinical_data_source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:selection_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:expected_number_of_participants ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumDataCategory ) ] cam:Concept ) ] ;
            owl:onProperty cam:data_category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:selection_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:clinical_data_source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:study_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:study_design ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:research_domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:vbr_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:expected_number_of_participants ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:actual_number_of_participants ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:data_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumResearchDomain ) ] cam:Concept ) ] ;
            owl:onProperty cam:research_domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:vbr_id ],
        linkml:ClassDefinition ;
    skos:definition "Additional features about studies that may not apply to all studies" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

<https://w3id.org/anvilproject/acr-harmonized-data-model> a owl:Ontology ;
    rdfs:label "acr-harmonized-data-model" ;
    dcterms:license "MIT" ;
    dcterms:title "acr-harmonized-data-model" ;
    rdfs:seeAlso <https://anvilproject.github.io/acr-harmonized-data-model> ;
    skos:definition "LinkML Schema for ACR Harmonized Data. This model under development is intended to capture useful cross-study data in the AnVIL data repository." .

linkml:DateOrDatetime a rdfs:Datatype .

cam:Aliquot a owl:Class ;
    rdfs:label "Aliquot" ;
    dcterms:title "Aliquot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:availability_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom cam:Concept ;
            owl:onProperty cam:quantity_unit ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
