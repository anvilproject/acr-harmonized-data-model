    dcterms:title "Geriatric medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine dealing with the diagnosis, treatment and prevention of disease in older people, and the problems specific to aging." .

edam:topic_3400 a owl:Class ;
    rdfs:label "edam:topic_3400" ;
    dcterms:title "Allergy, clinical immunology and immunotherapeutics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Health issues related to the immune system and their prevention, diagnosis and management." .

edam:topic_3401 a owl:Class ;
    rdfs:label "edam:topic_3401" ;
    dcterms:title "Pain medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The prevention of pain and the evaluation, treatment and rehabilitation of persons in pain." .

edam:topic_3402 a owl:Class ;
    rdfs:label "edam:topic_3402" ;
    dcterms:title "Anaesthesiology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Anaesthesia and anaesthetics." .

edam:topic_3403 a owl:Class ;
    rdfs:label "edam:topic_3403" ;
    dcterms:title "Critical care medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The multidisciplinary that cares for patients with acute, life-threatening illness or injury." .

edam:topic_3404 a owl:Class ;
    rdfs:label "edam:topic_3404" ;
    dcterms:title "Dermatology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with prevention, diagnosis and treatment of disorders of the skin, scalp, hair and nails." .

edam:topic_3405 a owl:Class ;
    rdfs:label "edam:topic_3405" ;
    dcterms:title "Dentistry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study, diagnosis, prevention and treatments of disorders of the oral cavity, maxillofacial area and adjacent structures." .

edam:topic_3406 a owl:Class ;
    rdfs:label "edam:topic_3406" ;
    dcterms:title "Ear, nose and throat medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the prevention, diagnosis, and treatment of disorders of the ear, nose and throat." .

edam:topic_3407 a owl:Class ;
    rdfs:label "edam:topic_3407" ;
    dcterms:title "Endocrinology and metabolism" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine dealing with diseases of endocrine organs, hormone systems, their target organs, and disorders of the pathways of glucose and lipid metabolism." .

edam:topic_3408 a owl:Class ;
    rdfs:label "edam:topic_3408" ;
    dcterms:title "Haematology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the blood, blood-forming organs and blood diseases." .

edam:topic_3409 a owl:Class ;
    rdfs:label "edam:topic_3409" ;
    dcterms:title "Gastroenterology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with disorders of the oesophagus, stomach, duodenum, jejenum, ileum, large intestine, sigmoid colon and rectum." .

edam:topic_3410 a owl:Class ;
    rdfs:label "edam:topic_3410" ;
    dcterms:title "Gender medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of the biological and physiological differences between males and females and how they effect differences in disease presentation and management." .

edam:topic_3411 a owl:Class ;
    rdfs:label "edam:topic_3411" ;
    dcterms:title "Gynaecology and obstetrics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the health of the female reproductive system, pregnancy and birth." .

edam:topic_3412 a owl:Class ;
    rdfs:label "edam:topic_3412" ;
    dcterms:title "Hepatic and biliary medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the liver, gallbladder, bile ducts and bile." .

edam:topic_3414 a owl:Class ;
    rdfs:label "edam:topic_3414" ;
    dcterms:title "Trauma medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that treats body wounds or shock produced by sudden physical injury, as from violence or accident." .

edam:topic_3415 a owl:Class ;
    rdfs:label "edam:topic_3415" ;
    dcterms:title "Medical toxicology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the diagnosis, management and prevention of poisoning and other adverse health effects caused by medications, occupational and environmental toxins, and biological agents." .

edam:topic_3416 a owl:Class ;
    rdfs:label "edam:topic_3416" ;
    dcterms:title "Musculoskeletal medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the prevention, diagnosis, and treatment of disorders of the muscle, bone and connective tissue. It incorporates aspects of orthopaedics, rheumatology, rehabilitation medicine and pain medicine." .

edam:topic_3417 a owl:Class ;
    rdfs:label "edam:topic_3417" ;
    dcterms:title "Ophthalmology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with disorders of the eye, including eyelid, optic nerve/visual pathways and occular muscles." .

edam:topic_3418 a owl:Class ;
    rdfs:label "edam:topic_3418" ;
    dcterms:title "Paediatrics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the medical care of infants, children and adolescents." .

edam:topic_3419 a owl:Class ;
    rdfs:label "edam:topic_3419" ;
    dcterms:title "Psychiatry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of medicine that deals with the management of mental illness, emotional disturbance and abnormal behaviour." .

edam:topic_3420 a owl:Class ;
    rdfs:label "edam:topic_3420" ;
    dcterms:title "Reproductive health" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The health of the reproductive processes, functions and systems at all stages of life." .

edam:topic_3421 a owl:Class ;
    rdfs:label "edam:topic_3421" ;
    dcterms:title "Surgery" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The use of operative, manual and instrumental techniques on a patient to investigate and/or treat a pathological condition or help improve bodily function or appearance." .

edam:topic_3422 a owl:Class ;
    rdfs:label "edam:topic_3422" ;
    dcterms:title "Urology and nephrology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branches of medicine and physiology focussing on the function and disorders of the urinary system in males and females, the reproductive system in males, and the kidney." .

edam:topic_3423 a owl:Class ;
    rdfs:label "edam:topic_3423" ;
    dcterms:title "Complementary medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Medical therapies that fall beyond the scope of conventional medicine but may be used alongside it in the treatment of disease and ill health." .

edam:topic_3444 a owl:Class ;
    rdfs:label "edam:topic_3444" ;
    dcterms:title "MRI" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Techniques that uses magnetic fields and radiowaves to form images, typically to investigate the anatomy and physiology of the human body." .

edam:topic_3448 a owl:Class ;
    rdfs:label "edam:topic_3448" ;
    dcterms:title "Neutron diffraction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of matter by studying the diffraction pattern from firing neutrons at a sample, typically to determine atomic and/or magnetic structure." .

edam:topic_3452 a owl:Class ;
    rdfs:label "edam:topic_3452" ;
    dcterms:title "Tomography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Imaging in sections (sectioning), through the use of a wave-generating device (tomograph) that generates an image (a tomogram)." .

edam:topic_3473 a owl:Class ;
    rdfs:label "edam:topic_3473" ;
    dcterms:title "Data mining" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The discovery of patterns in large data sets and the extraction and trasnsformation of those patterns into a useful format." .

edam:topic_3474 a owl:Class ;
    rdfs:label "edam:topic_3474" ;
    dcterms:title "Machine learning" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A topic concerning the application of artificial intelligence methods to algorithms, in order to create methods that can learn from data in order to generate an output, rather than relying on explicitly encoded information only." .

edam:topic_3489 a owl:Class ;
    rdfs:label "edam:topic_3489" ;
    dcterms:title "Database management" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The general handling of data stored in digital archives such as databases, databanks, web portals, and other data resources." .

edam:topic_3500 a owl:Class ;
    rdfs:label "edam:topic_3500" ;
    dcterms:title "Zoology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Animals, e.g. information on a specific animal genome including molecular sequences, genes and annotation." .

edam:topic_3510 a owl:Class ;
    rdfs:label "edam:topic_3510" ;
    dcterms:title "Protein sites, features and motifs" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The biology, archival, detection, prediction and analysis of positional features such as functional and other key sites, in protein sequences and the conserved patterns (motifs, profiles etc.) that may be used to describe them." .

edam:topic_3511 a owl:Class ;
    rdfs:label "edam:topic_3511" ;
    dcterms:title "Nucleic acid sites, features and motifs" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The biology, archival, detection, prediction and analysis of positional features such as functional and other key sites, in nucleic acid sequences and the conserved patterns (motifs, profiles etc.) that may be used to describe them." .

edam:topic_3512 a owl:Class ;
    rdfs:label "edam:topic_3512" ;
    dcterms:title "Gene transcripts" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Transcription of DNA into RNA and features of a messenger RNA (mRNA) molecules including precursor RNA, primary (unprocessed) transcript and fully processed molecules." .

edam:topic_3516 a owl:Class ;
    rdfs:label "edam:topic_3516" ;
    dcterms:title "Genotyping experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Genotype experiment including case control, population, and family studies. These might use array based methods and re-sequencing methods." .

edam:topic_3517 a owl:Class ;
    rdfs:label "edam:topic_3517" ;
    dcterms:title "GWAS study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Genome-wide association study experiments." .

edam:topic_3518 a owl:Class ;
    rdfs:label "edam:topic_3518" ;
    dcterms:title "Microarray experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Microarray experiments including conditions, protocol, sample:data relationships etc." .

edam:topic_3519 a owl:Class ;
    rdfs:label "edam:topic_3519" ;
    dcterms:title "PCR experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "PCR experiments, e.g. quantitative real-time PCR." .

edam:topic_3520 a owl:Class ;
    rdfs:label "edam:topic_3520" ;
    dcterms:title "Proteomics experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Proteomics experiments." .

edam:topic_3523 a owl:Class ;
    rdfs:label "edam:topic_3523" ;
    dcterms:title "RNAi experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experiment in which the expression of a specific gene is post-transcriptionally knocked down or silenced by means of a small RNA (sRNA) causing the degradation of the gene transcript (mRNA), and thus preventing the production of the corresponding protein." .

edam:topic_3524 a owl:Class ;
    rdfs:label "edam:topic_3524" ;
    dcterms:title "Simulation experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Biological computational model experiments (simulation), for example the minimum information required in order to permit its correct interpretation and reproduction." .

edam:topic_3534 a owl:Class ;
    rdfs:label "edam:topic_3534" ;
    dcterms:title "Protein binding sites" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Binding sites in proteins, including cleavage sites (for a proteolytic enzyme or agent), key residues involved in protein folding, catalytic residues (active site) of an enzyme, ligand-binding (non-catalytic) residues of a protein, such as sites that bind metal, prosthetic groups or lipids, RNA and DNA-binding proteins and binding sites etc." .

edam:topic_3538 a owl:Class ;
    rdfs:label "edam:topic_3538" ;
    dcterms:title "Protein disordered structure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Disordered structure in a protein." .

edam:topic_3542 a owl:Class ;
    rdfs:label "edam:topic_3542" ;
    dcterms:title "Protein secondary structure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Secondary structure (predicted or real) of a protein, including super-secondary structure." .

edam:topic_3569 a owl:Class ;
    rdfs:label "edam:topic_3569" ;
    dcterms:title "Applied mathematics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of mathematics to specific problems in science, typically by the formulation and analysis of mathematical models." .

edam:topic_3570 a owl:Class ;
    rdfs:label "edam:topic_3570" ;
    dcterms:title "Pure mathematics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of abstract mathematical concepts." .

edam:topic_3571 a owl:Class ;
    rdfs:label "edam:topic_3571" ;
    dcterms:title "Data governance" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Data governance is the control of data entry and maintenance to ensure the data meets defined standards, qualities, or constraints." .

edam:topic_3572 a owl:Class ;
    rdfs:label "edam:topic_3572" ;
    dcterms:title "Data quality management" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The quality, integrity, and cleaning up of data." .

edam:topic_3573 a owl:Class ;
    rdfs:label "edam:topic_3573" ;
    dcterms:title "Freshwater biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of organisms in freshwater ecosystems." .

edam:topic_3574 a owl:Class ;
    rdfs:label "edam:topic_3574" ;
    dcterms:title "Human genetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of inheritance in human beings." .

edam:topic_3575 a owl:Class ;
    rdfs:label "edam:topic_3575" ;
    dcterms:title "Tropical medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Health problems that are prevalent in tropical and subtropical regions." .

edam:topic_3576 a owl:Class ;
    rdfs:label "edam:topic_3576" ;
    dcterms:title "Medical biotechnology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Biotechnology applied to the medical sciences and the development of medicines." .

edam:topic_3577 a owl:Class ;
    rdfs:label "edam:topic_3577" ;
    dcterms:title "Personalised medicine" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "An approach to medicine whereby decisions, practices and are tailored to the individual patient based on their predicted response or risk of disease." .

edam:topic_3656 a owl:Class ;
    rdfs:label "edam:topic_3656" ;
    dcterms:title "Immunoprecipitation experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experimental techniques to purify a protein-DNA crosslinked complex. Usually sequencing follows e.g. in the techniques ChIP-chip, ChIP-seq and MeDIP-seq." .

edam:topic_3673 a owl:Class ;
    rdfs:label "edam:topic_3673" ;
    dcterms:title "Whole genome sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Laboratory technique to sequence the complete DNA sequence of an organism's genome at a single time." .

edam:topic_3674 a owl:Class ;
    rdfs:label "edam:topic_3674" ;
    dcterms:title "Methylated DNA immunoprecipitation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Laboratory technique to sequence the methylated regions in DNA." .

edam:topic_3676 a owl:Class ;
    rdfs:label "edam:topic_3676" ;
    dcterms:title "Exome sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Laboratory technique to sequence all the protein-coding regions in a genome, i.e., the exome." .

edam:topic_3678 a owl:Class ;
    rdfs:label "edam:topic_3678" ;
    dcterms:title "Experimental design and studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The design of an experiment intended to test a hypothesis, and describe or explain empirical data obtained under various experimental conditions." .

edam:topic_3679 a owl:Class ;
    rdfs:label "edam:topic_3679" ;
    dcterms:title "Animal study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The design of an experiment involving non-human animals." .

edam:topic_3697 a owl:Class ;
    rdfs:label "edam:topic_3697" ;
    dcterms:title "Microbial ecology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The ecology of microorganisms including their relationship with one another and their environment." .

edam:topic_3794 a owl:Class ;
    rdfs:label "edam:topic_3794" ;
    dcterms:title "RNA immunoprecipitation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "An antibody-based technique used to map in vivo RNA-protein interactions." .

edam:topic_3796 a owl:Class ;
    rdfs:label "edam:topic_3796" ;
    dcterms:title "Population genomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Large-scale study (typically comparison) of DNA sequences of populations." .

edam:topic_3810 a owl:Class ;
    rdfs:label "edam:topic_3810" ;
    dcterms:title "Agricultural science" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Multidisciplinary study, research and development within the field of agriculture." .

edam:topic_3837 a owl:Class ;
    rdfs:label "edam:topic_3837" ;
    dcterms:title "Metagenomic sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Approach which samples, in parallel, all genes in all organisms present in a given sample, e.g. to provide insight into biodiversity and function." .

edam:topic_3855 a owl:Class ;
    rdfs:label "edam:topic_3855" ;
    dcterms:title "Environmental sciences" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Study of the environment, the interactions between its physical, chemical, and biological components and it's effect on life. Also how humans impact upon the environment, and how we can manage and utilise natural resources." .

edam:topic_3892 a owl:Class ;
    rdfs:label "edam:topic_3892" ;
    dcterms:title "Biomolecular simulation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study and simulation of molecular conformations using a computational model and computer simulations." .

edam:topic_3895 a owl:Class ;
    rdfs:label "edam:topic_3895" ;
    dcterms:title "Synthetic biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of multi-disciplinary science and technology for the construction of artificial biological systems for diverse applications." .

edam:topic_3912 a owl:Class ;
    rdfs:label "edam:topic_3912" ;
    dcterms:title "Genetic engineering" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The application of biotechnology to directly manipulate an organism's genes." .

edam:topic_3922 a owl:Class ;
    rdfs:label "edam:topic_3922" ;
    dcterms:title "Proteogenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A field of biological research focused on the discovery and identification of peptides, typically by comparing mass spectra against a protein database." .

edam:topic_3923 a owl:Class ;
    rdfs:label "edam:topic_3923" ;
    dcterms:title "Genome resequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Laboratory experiment to identify the differences between a specific genome (of an individual) and a reference genome (developed typically from many thousands of individuals). WGS re-sequencing is used as golden standard to detect variations compared to a given reference genome, including small variants (SNP and InDels) as well as larger genome re-organisations (CNVs, translocations, etc.)." .

edam:topic_3930 a owl:Class ;
    rdfs:label "edam:topic_3930" ;
    dcterms:title "Immunogenetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A biomedical field that bridges immunology and genetics, to study the genetic basis of the immune system." .

edam:topic_3931 a owl:Class ;
    rdfs:label "edam:topic_3931" ;
    dcterms:title "Chemometrics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Interdisciplinary science focused on extracting information from chemical systems by data analytical approaches, for example multivariate statistics, applied mathematics, and computer science." .

edam:topic_3934 a owl:Class ;
    rdfs:label "edam:topic_3934" ;
    dcterms:title "Cytometry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Cytometry is the measurement of the characteristics of cells." .

edam:topic_3939 a owl:Class ;
    rdfs:label "edam:topic_3939" ;
    dcterms:title "Metabolic engineering" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Biotechnology approach that seeks to optimize cellular genetic and regulatory processes in order to increase the cells' production of a certain substance." .

edam:topic_3940 a owl:Class ;
    rdfs:label "edam:topic_3940" ;
    dcterms:title "Chromosome conformation capture" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Molecular biology methods used to analyze the spatial organization of chromatin in a cell." .

edam:topic_3941 a owl:Class ;
    rdfs:label "edam:topic_3941" ;
    dcterms:title "Metatranscriptomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of microbe gene expression within natural environments (i.e. the metatranscriptome)." .

edam:topic_3943 a owl:Class ;
    rdfs:label "edam:topic_3943" ;
    dcterms:title "Paleogenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The reconstruction and analysis of genomic information in extinct species." .

edam:topic_3944 a owl:Class ;
    rdfs:label "edam:topic_3944" ;
    dcterms:title "Cladistics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The biological classification of organisms by categorizing them in groups (\"clades\") based on their most recent common ancestor." .

edam:topic_3945 a owl:Class ;
    rdfs:label "edam:topic_3945" ;
    dcterms:title "Molecular evolution" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of the process and mechanism of change of biomolecules such as DNA, RNA, and proteins across generations." .

edam:topic_3948 a owl:Class ;
    rdfs:label "edam:topic_3948" ;
    dcterms:title "Immunoinformatics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Immunoinformatics is the field of computational biology that deals with the study of immunoloogical questions. Immunoinformatics is at the interface between immunology and computer science. It takes advantage of computational, statistical, mathematical approaches and enhances the understanding of immunological knowledge." .

edam:topic_3954 a owl:Class ;
    rdfs:label "edam:topic_3954" ;
    dcterms:title "Echography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A diagnostic imaging technique based on the application of ultrasound." .

edam:topic_3955 a owl:Class ;
    rdfs:label "edam:topic_3955" ;
    dcterms:title "Fluxomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experimental approaches to determine the rates of metabolic reactions - the metabolic fluxes - within a biological entity." .

edam:topic_3957 a owl:Class ;
    rdfs:label "edam:topic_3957" ;
    dcterms:title "Protein interaction experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "An experiment for studying protein-protein interactions." .

edam:topic_3958 a owl:Class ;
    rdfs:label "edam:topic_3958" ;
    dcterms:title "Copy number variation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A DNA structural variation, specifically a duplication or deletion event, resulting in sections of the genome to be repeated, or the number of repeats in the genome to vary between individuals." .

edam:topic_3959 a owl:Class ;
    rdfs:label "edam:topic_3959" ;
    dcterms:title "Cytogenetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The branch of genetics concerned with the relationships between chromosomes and cellular behaviour, especially during mitosis and meiosis." .

edam:topic_3966 a owl:Class ;
    rdfs:label "edam:topic_3966" ;
    dcterms:title "Vaccinology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The design of vaccines to protect against a particular pathogen, including antigens, delivery systems, and adjuvants to elicit a predictable immune response against specific epitopes." .

edam:topic_3967 a owl:Class ;
    rdfs:label "edam:topic_3967" ;
    dcterms:title "Immunomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of immune system as a whole, its regulation and response to pathogens using genome-wide approaches." .

edam:topic_3974 a owl:Class ;
    rdfs:label "edam:topic_3974" ;
    dcterms:title "Epistasis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Epistasis can be defined as the ability of the genotype at one locus to supersede the phenotypic effect of a mutation at another locus. This interaction between genes can occur at different level: gene expression, protein levels, etc..." .

edam:topic_4010 a owl:Class ;
    rdfs:label "edam:topic_4010" ;
    dcterms:title "Open science" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Open science encompasses the practices of making scientific research transparent and participatory, and its outputs publicly accessible." .

edam:topic_4011 a owl:Class ;
    rdfs:label "edam:topic_4011" ;
    dcterms:title "Data rescue" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Data rescue denotes digitalisation, formatting, archival, and publication of data that were not available in accessible or usable form. Examples are data from private archives, data inside publications, or in paper records stored privately or publicly." .

edam:topic_4012 a owl:Class ;
    rdfs:label "edam:topic_4012" ;
    dcterms:title "FAIR data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "FAIR data is scientific data that meets the principles of being findable, accessible, interoperable, and reusable." .

edam:topic_4013 a owl:Class ;
    rdfs:label "edam:topic_4013" ;
    dcterms:title "Antimicrobial resistance" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Microbial mechanisms for protecting microorganisms against antimicrobial agents." .

edam:topic_4014 a owl:Class ;
    rdfs:label "edam:topic_4014" ;
    dcterms:title "Electroencephalography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The monitoring method for measuring electrical activity in the brain." .

edam:topic_4016 a owl:Class ;
    rdfs:label "edam:topic_4016" ;
    dcterms:title "Electrocardiography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The monitoring method for measuring electrical activity in the heart." .

edam:topic_4017 a owl:Class ;
    rdfs:label "edam:topic_4017" ;
    dcterms:title "Cryogenic electron microscopy" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "A method for studying biomolecules and other structures at very low (cryogenic) temperature using electron microscopy." .

edam:topic_4019 a owl:Class ;
    rdfs:label "edam:topic_4019" ;
    dcterms:title "Biosciences" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Biosciences, or life sciences, include fields of study related to life, living beings, and biomolecules." .

edam:topic_4020 a owl:Class ;
    rdfs:label "edam:topic_4020" ;
    dcterms:title "Carbon cycle" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The carbon cycle is the biogeochemical pathway of carbon moving through the different parts of the Earth (such as ocean, atmosphere, soil), or eventually another planet." .

edam:topic_4021 a owl:Class ;
    rdfs:label "edam:topic_4021" ;
    dcterms:title "Multiomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Multiomics concerns integration of data from multiple omics (e.g. transcriptomics, proteomics, epigenomics)." .

edam:topic_4027 a owl:Class ;
    rdfs:label "edam:topic_4027" ;
    dcterms:title "Ribosome Profiling" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "With ribosome profiling, ribosome-protected mRNA fragments are analyzed with RNA-seq techniques leading to a genome-wide measurement of the translation landscape." .

edam:topic_4028 a owl:Class ;
    rdfs:label "edam:topic_4028" ;
    dcterms:title "Single-cell sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Combined with NGS (Next Generation Sequencing) technologies, single-cell sequencing allows the study of genetic information (DNA, RNA, epigenome...) at a single cell level. It is often used for differential analysis and gene expression profiling." .

edam:topic_4029 a owl:Class ;
    rdfs:label "edam:topic_4029" ;
    dcterms:title "Acoustics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of mechanical waves in liquids, solids, and gases." .

edam:topic_4030 a owl:Class ;
    rdfs:label "edam:topic_4030" ;
    dcterms:title "Microfluidics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Interdisplinary study of behavior, precise control, and manipulation of low (microlitre) volume fluids in constrained space." .

edam:topic_4037 a owl:Class ;
    rdfs:label "edam:topic_4037" ;
    dcterms:title "Genomic imprinting" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Genomic imprinting is a gene regulation mechanism by which a subset of genes are expressed from one of the two parental chromosomes only. Imprinted genes are organized in clusters, their silencing/activation of the imprinted loci involves epigenetic marks (DNA methylation, etc) and so-called imprinting control regions (ICR). It has been described in mammals, but also plants and insects." .

edam:topic_4038 a owl:Class ;
    rdfs:label "edam:topic_4038" ;
    dcterms:title "Metabarcoding" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Metabarcoding is the barcoding of (environmental) DNA or RNA to identify multiple taxa from the same sample." .

edam:topic_4044 a owl:Class ;
    rdfs:label "edam:topic_4044" ;
    dcterms:title "Data protection" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Data protection is a topic concerning data that should be protected from disclosure, damage, or unauthorised access, due to its sensitive nature." .

edam:topic_4045 a owl:Class ;
    rdfs:label "edam:topic_4045" ;
    dcterms:title "Cybersecurity" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Cybersecurity is a topic comprising the approaches and technologies that enable the protection of computer systems, networks and programs from digital attacks. It ensures the availability, integrity, and confidentiality of processed and stored information." .

edam:topic_4046 a owl:Class ;
    rdfs:label "edam:topic_4046" ;
    dcterms:title "Version control" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Version control is a technology for consistent management, storing, and sharing of evolving versions of digital artefacts, such as computer programs, scripts, documents, data, or media files." .

edam:topic_4047 a owl:Class ;
    rdfs:label "edam:topic_4047" ;
    dcterms:title "Software management" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Software management comprises the practices and principles of taking care of software and software-based or software-like services, other than programming and maintenance. This includes for example taking care of the associated information and documentation, and the processes of contribution, validation, release/publication, or deployment." .

edam:topic_4051 a owl:Class ;
    rdfs:label "edam:topic_4051" ;
    dcterms:title "ChIP-exo" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Chromatin immunoprecipitation-based exeperiment similar to ChIP-seq, with an additional experimental step using an exonuclease to increase the resolution of protein binding site identification." .

edam:topic_4052 a owl:Class ;
    rdfs:label "edam:topic_4052" ;
    dcterms:title "Hi-C" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "High-throughput genomic and epigenomic technique that capture chromatin conformation, allowing a genome-wide identification of chromatin interactions and structure." .

edam:topic_4053 a owl:Class ;
    rdfs:label "edam:topic_4053" ;
    dcterms:title "ATAC-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Assay for Transposase-Accessible Chromatin with high throughput sequencing. This technique is designed for the genome-wide detection of open chromatin regions." .

edam:topic_4054 a owl:Class ;
    rdfs:label "edam:topic_4054" ;
    dcterms:title "miRNA silencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experiment in which the expression of a given gene is knocked down by means of a micro RNA (miRNA) causing the degradation of the gene transcript (mRNA)." .

edam:topic_4055 a owl:Class ;
    rdfs:label "edam:topic_4055" ;
    dcterms:title "siRNA experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Experiment in which the expression of a given gene is knocked down by means of a small interfering RNA (siRNA) causing the degradation of the gene transcript (mRNA)." .

edam:topic_4056 a owl:Class ;
    rdfs:label "edam:topic_4056" ;
    dcterms:title "Long-read sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Long-read sequencing is a sequencing method that produces reads thousands to millions of base pairs long, allowing for better resolution of complex regions, structural variants, and full-length transcripts." .

edam:topic_4057 a owl:Class ;
    rdfs:label "edam:topic_4057" ;
    dcterms:title "Short-read sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Short-read sequencing is a high-throughput sequencing method that generates millions of short nucleotide fragments, typically 50–300 base pairs in length." .

edam:topic_4060 a owl:Class ;
    rdfs:label "edam:topic_4060" ;
    dcterms:title "Metaproteomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Metaproteomics is the profiling of proteins in a sample that contains material from multiple species or strains of organisms." .

edam:topic_4061 a owl:Class ;
    rdfs:label "edam:topic_4061" ;
    dcterms:title "Bisulfite sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Bisulfite sequencing is a sequencing technique used to determine DNA methylation patterns by treating DNA with bisulfite, which converts unmethylated cytosines to uracils while leaving methylated cytosines unchanged." .

edam:topic_4062 a owl:Class ;
    rdfs:label "edam:topic_4062" ;
    dcterms:title "Bulk RNA barcoding and sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Bulk RNA barcoding and sequencing (BRB-seq) is a highly mutliplexed bulk RNA-Seq technique where each RNA sample gets a barcode, and many samples are sequenced together." .

edam:topic_4063 a owl:Class ;
    rdfs:label "edam:topic_4063" ;
    dcterms:title "DNase sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "DNase sequencing is a technique used to identify regions of open chromatin by sequencing DNA fragments generated after treatment with DNase I, which preferentially cuts accessible DNA." .

edam:topic_4064 a owl:Class ;
    rdfs:label "edam:topic_4064" ;
    dcterms:title "MicroRNA sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Specific sequencing of small RNAs using a variant of RNA-seq, with an additional fragment size selection step." .

edam:topic_4065 a owl:Class ;
    rdfs:label "edam:topic_4065" ;
    dcterms:title "Exposomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Exposomics is the systematic and comprehensive study of the exposome and the associated biological responses (exposure-phenotype interaction). Exposome is the totality of environmental exposures, that is, the cumulative (e.g. life-long) totality of contacts between external factors (e.g. chemical agents) and a living organism, a population, or a biological taxon." .

mesh:D000068397 a owl:Class ;
    rdfs:label "mesh:D000068397" ;
    dcterms:title "Clinical Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on the results of a research study to evaluate interventions or exposures on biomedical or health-related outcomes.  The two main types of clinical studies are interventional studies (clinical trials) and observational studies. While most clinical studies concern humans, this publication type may be used for clinical veterinary articles meeting the requisites for humans." .

mesh:D000073843 a owl:Class ;
    rdfs:label "mesh:D000073843" ;
    dcterms:title "Equivalence Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Trial that aims to show a new treatment is no better and no worse than the standard treatment." .

mesh:D000076362 a owl:Class ;
    rdfs:label "mesh:D000076362" ;
    dcterms:title "Adaptive Clinical Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Clinical study in which a prospectively planned opportunity is included to modify trial designs and hypotheses based on analysis of data from subjects in the study." .

mesh:D000077522 a owl:Class ;
    rdfs:label "mesh:D000077522" ;
    dcterms:title "Clinical Trial, Veterinary" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work in which animal participants are assigned to receive one or more interventions so that researchers can evaluate the interventions on biomedical or health-related outcomes. The assignments are determined by the study protocol." .

mesh:D000078182 a owl:Class ;
    rdfs:label "mesh:D000078182" ;
    dcterms:title "Systematic Review" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A review of primary literature in health and health policy that attempts to identify, appraise, and synthesize all the empirical evidence that meets specified eligibility criteria to answer a given research question.  Its conduct uses explicit methods aimed at minimizing bias in order to produce more reliable findings regarding the effects of interventions for prevention, treatment, and rehabilitation that can be used to inform decision making." .

mesh:D000078323 a owl:Class ;
    rdfs:label "mesh:D000078323" ;
    dcterms:title "Observational Study, Veterinary" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Reports on studies of the results of a clinical study in which animal subjects may receive diagnostic, therapeutic, or other types of interventions, where the investigator does not assign participants to specific interventions." .

mesh:D000078325 a owl:Class ;
    rdfs:label "mesh:D000078325" ;
    dcterms:title "Clinical Trial Protocol" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "The written description of a clinical study. It contains the study's objectives, design, and methods including subject target and/or enrollment criteria. It may also present relevant scientific background and statistical information." .

mesh:D000081262 a owl:Class ;
    rdfs:label "mesh:D000081262" ;
    dcterms:title "Randomized Controlled Trial, Veterinary" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on a clinical trial with animal subjects that involves at least one test treatment and one control treatment, concurrent enrollment and follow-up of the test- and control-treated groups, and in which the treatments to be administered are selected by a random process, such as the use of a random-numbers table." .

mesh:D000098368 a owl:Class ;
    rdfs:label "mesh:D000098368" ;
    dcterms:title "Human Challenge Trials" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Trials in which participants are intentionally challenged (whether or not they have been vaccinated) with exposure to an infectious disease organism." .

mesh:D000098583 a owl:Class ;
    rdfs:label "mesh:D000098583" ;
    dcterms:title "Scoping Review" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Review to identify knowledge gaps, scope a body of literature, clarify concepts or to investigate research conduct." .

mesh:D000099094 a owl:Class ;
    rdfs:label "mesh:D000099094" ;
    dcterms:title "Network Meta-Analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Works consisting of meta-analysis of randomized trials in which estimates of comparative treatment effects are visualized and interpreted from a network of interventions that may or may not have been evaluated directly against each other. Common considerations in network meta-analysis include conceptual and statistical heterogeneity and incoherence." .

mesh:D002363 a owl:Class ;
    rdfs:label "mesh:D002363" ;
    dcterms:title "Case Reports" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Clinical presentations that may be followed by evaluative studies that eventually lead to a diagnosis." .

mesh:D003160 a owl:Class ;
    rdfs:label "mesh:D003160" ;
    dcterms:title "Comparative Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Comparison of outcomes, results, responses, etc for different techniques, therapeutic approaches or other inputs." .

mesh:D003430 a owl:Class ;
    rdfs:label "mesh:D003430" ;
    dcterms:title "Cross-Sectional Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies in which the presence or absence of disease or other health-related variables are determined in each member of the study population or in a representative sample at one particular time. This contrasts with LONGITUDINAL STUDIES which are followed over a period of time." .

mesh:D005500 a owl:Class ;
    rdfs:label "mesh:D005500" ;
    dcterms:title "Follow-Up Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies in which individuals or populations are followed to assess the outcome of exposures, procedures, or effects of a characteristic, e.g., occurrence of disease." .

mesh:D008137 a owl:Class ;
    rdfs:label "mesh:D008137" ;
    dcterms:title "Longitudinal Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies in which variables relating to an individual or group of individuals are assessed over a period of time." .

mesh:D011446 a owl:Class ;
    rdfs:label "mesh:D011446" ;
    dcterms:title "Prospective Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Observation of a population for a sufficient number of persons over a sufficient number of years to generate incidence or mortality rates subsequent to the selection of the study group." .

mesh:D012189 a owl:Class ;
    rdfs:label "mesh:D012189" ;
    dcterms:title "Retrospective Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies used to test etiologic hypotheses in which inferences about an exposure to putative causal factors are derived from data relating to characteristics of persons under study or to events or experiences in their past. The essential feature is that some of the persons under study have the disease or outcome of interest and their characteristics are compared with those of unaffected persons." .

mesh:D015331 a owl:Class ;
    rdfs:label "mesh:D015331" ;
    dcterms:title "Cohort Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies in which subsets of a defined population are identified. These groups may or may not be exposed to factors hypothesized to influence the probability of the occurrence of a particular disease or other outcome. Cohorts are defined populations which, as a whole, are followed in an attempt to determine distinguishing subgroup characteristics." .

mesh:D015528 a owl:Class ;
    rdfs:label "mesh:D015528" ;
    dcterms:title "HIV Seroprevalence" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Studies of the number of cases where human immunodeficiency virus (HIV) is present in a specific population at a designated time. The presence in a given individual is determined by the finding of HIV antibodies in the serum (HIV SEROPOSITIVITY)." .

mesh:D016022 a owl:Class ;
    rdfs:label "mesh:D016022" ;
    dcterms:title "Case-Control Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Comparisons that start with the identification of persons with the disease or outcome of interest and a control (comparison, referent) group without the disease or outcome of interest. The relationship of an attribute is examined by comparing both groups with regard to the frequency or levels of outcome over time." .

mesh:D016036 a owl:Class ;
    rdfs:label "mesh:D016036" ;
    dcterms:title "Seroepidemiologic Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "EPIDEMIOLOGIC STUDIES based on the detection through serological testing of characteristic change in the serum level of specific ANTIBODIES. Latent subclinical infections and carrier states can thus be detected in addition to clinically overt cases." .

mesh:D016426 a owl:Class ;
    rdfs:label "mesh:D016426" ;
    dcterms:title "Scientific Integrity Review" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work consisting of reports by the United States Office of Research Integrity, identifying questionable research published in articles or books. Notification of the questionable data is carried in the NIH Guide for Grants and Contracts." .

mesh:D016429 a owl:Class ;
    rdfs:label "mesh:D016429" ;
    dcterms:title "Clinical Conference" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work that consists of a conference of physicians on their observations of a patient at the bedside, regarding the physical state, laboratory and other diagnostic findings, clinical manifestations, results of current therapy, etc. A clinical conference usually ends with a confirmation or correction of clinical findings by a pathological diagnosis performed by a pathologist. Clinical conference is often referred to as a clinico-pathological conference." .

mesh:D016430 a owl:Class ;
    rdfs:label "mesh:D016430" ;
    dcterms:title "Clinical Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on the results of a clinical study in which participants are assigned to receive one or more interventions so that researchers can evaluate the interventions on biomedical or health-related outcomes. The assignments are determined by the study protocol. Participants may receive diagnostic, therapeutic, or other types of interventions. For clinical trials on  veterinary animals see CLINICAL TRIAL, VETERINARY. Clinical Trials was used for both humans and non-humans prior to 2019." .

mesh:D016446 a owl:Class ;
    rdfs:label "mesh:D016446" ;
    dcterms:title "Consensus Development Conference" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Official statements of the findings or recommendations expressing the outcome of a meeting convened to evaluate current thought and research on a subject of interest." .

mesh:D016447 a owl:Class ;
    rdfs:label "mesh:D016447" ;
    dcterms:title "Consensus Development Conference, NIH" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Official statements of the finding or recommendations expressing the outcome from a conference sponsored by NIH." .

mesh:D016448 a owl:Class ;
    rdfs:label "mesh:D016448" ;
    dcterms:title "Multicenter Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on a study executed by several cooperating institutions." .

mesh:D016449 a owl:Class ;
    rdfs:label "mesh:D016449" ;
    dcterms:title "Randomized Controlled Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on a clinical trial that involves at least one test treatment and one control treatment, concurrent enrollment and follow-up of the test- and control-treated groups, and in which the treatments to be administered are selected by a random process, such as the use of a random-numbers table." .

mesh:D017418 a owl:Class ;
    rdfs:label "mesh:D017418" ;
    dcterms:title "Meta-Analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Works consisting of studies using a quantitative method of combining the results of independent studies (usually drawn from the published literature) and synthesizing summaries and conclusions which may be used to evaluate therapeutic effectiveness, plan new studies, etc. It is often an overview of clinical trials. It is usually called a meta-analysis by the author or sponsoring body and should be differentiated from reviews of literature." .

mesh:D017426 a owl:Class ;
    rdfs:label "mesh:D017426" ;
    dcterms:title "Clinical Trial, Phase I" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work that is the report of a pre-planned, usually controlled, clinical study of the safety and efficacy of diagnostic, therapeutic, or prophylactic drugs, devices, or techniques based on a small number of healthy persons and conducted over the period of about a year in either the United States or a foreign country." .

mesh:D017427 a owl:Class ;
    rdfs:label "mesh:D017427" ;
    dcterms:title "Clinical Trial, Phase II" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work that is a report of a pre-planned, usually controlled, clinical study of the safety and efficacy of diagnostic, therapeutic, or prophylactic drugs, devices, or techniques based on several hundred volunteers, including a limited number of patients, and conducted over a period of about two years in either the United States or a foreign country." .

mesh:D017428 a owl:Class ;
    rdfs:label "mesh:D017428" ;
    dcterms:title "Clinical Trial, Phase III" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work that is a report of a pre-planned, usually controlled, clinical study of the safety and efficacy of diagnostic, therapeutic, or prophylactic drugs, devices, or techniques after phase II trials. A large enough group of patients is studied and closely monitored by physicians for adverse response to long-term exposure, over a period of about three years in either the United States or a foreign country." .

mesh:D017429 a owl:Class ;
    rdfs:label "mesh:D017429" ;
    dcterms:title "Clinical Trial, Phase IV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work that is a report of a planned post-marketing study of diagnostic, therapeutic, or prophylactic drugs, devices, or techniques that have been approved for general sale after clinical trials, phases I, II, and III. These studies, conducted in the United States or a foreign country, often garner additional data about the safety and efficacy of a product." .

mesh:D018486 a owl:Class ;
    rdfs:label "mesh:D018486" ;
    dcterms:title "Twin Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Work consisting of reporting using a method of detecting genetic causes in human traits and genetic factors in behavior using sets of twins." .

mesh:D018848 a owl:Class ;
    rdfs:label "mesh:D018848" ;
    dcterms:title "Controlled Clinical Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on a clinical trial involving one or more test treatments, at least one control treatment, specified outcome measures for evaluating the studied intervention, and a bias-free method for assigning patients to the test treatment. The treatment may be drugs, devices, or procedures studied for diagnostic, therapeutic, or prophylactic effectiveness. Control measures include placebos, active medicine, no-treatment, dosage forms and regimens, historical comparisons, etc. When randomization using mathematical techniques, such as the use of a random numbers table, is employed to assign patients to test or control treatments, the trial is characterized as a RANDOMIZED CONTROLLED TRIAL." .

mesh:D023361 a owl:Class ;
    rdfs:label "mesh:D023361" ;
    dcterms:title "Validation Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Works consisting of research using processes by which the reliability and relevance of a procedure for a specific purpose are established." .

mesh:D023362 a owl:Class ;
    rdfs:label "mesh:D023362" ;
    dcterms:title "Evaluation Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Works consisting of studies determining the effectiveness or utility of processes, personnel, and equipment." .

mesh:D063588 a owl:Class ;
    rdfs:label "mesh:D063588" ;
    dcterms:title "National Longitudinal Study of Adolescent Health" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Longitudinal study of a nationally representative sample of adolescents in grades 7-12 in the United States during the 1994-95 school year. The Add Health cohort has been followed into young adulthood. (from http://www.cpc.unc.edu/projects/addhealth accessed 08/2012)" .

mesh:D064888 a owl:Class ;
    rdfs:label "mesh:D064888" ;
    dcterms:title "Observational Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A work that reports on the results of a clinical study in which participants may receive diagnostic, therapeutic, or other types of interventions, but the investigator does not assign participants to specific interventions (as in an interventional study)." .

mesh:D065007 a owl:Class ;
    rdfs:label "mesh:D065007" ;
    dcterms:title "Pragmatic Clinical Trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "Randomized clinical trials that compare interventions in clinical settings and which look at a range of effectiveness outcomes and impacts." .

mesh:D065186 a owl:Class ;
    rdfs:label "mesh:D065186" ;
    dcterms:title "Interrupted Time Series Analysis" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A study that uses observations at multiple time points before and after an intervention (the interruption), in an attempt to detect whether the intervention has had an effect significantly greater than any underlying trend over time." .

mesh:D065187 a owl:Class ;
    rdfs:label "mesh:D065187" ;
    dcterms:title "Controlled Before-After Studies" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A study in which observations are made before and after an intervention, both in a group that receives the intervention and in a control group that does not." .

mesh:D065386 a owl:Class ;
    rdfs:label "mesh:D065386" ;
    dcterms:title "Historically Controlled Study" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumStudyDesign,
        linkml:PermissibleValue ;
    skos:definition "A study that compares a group of participants receiving an intervention with a similar group from the past who did not." .

CHMO:0000087 a owl:Class ;
    rdfs:label "CHMO:0000087" ;
    dcterms:title "fluorescence microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "Any type of light microscopy assay where the specimen can be made to fluoresce (emit energy as visible light) by illuminating it with light of specific wavelengths. These specimens are called fluorophores." .

CHMO:0000089 a owl:Class ;
    rdfs:label "CHMO:0000089" ;
    dcterms:title "confocal fluorescence microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "Microscopy where the specimen can be made to fluoresce (emit energy as visible light) by scanning a gas (Ar or Kr) laser spot of specific wavelength over its surface and using a spatial pinhole to eliminate out-of-focus fluorescence." .

CHMO:0000102 a owl:Class ;
    rdfs:label "CHMO:0000102" ;
    dcterms:title "light microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "Microscopy where the specimen is illuminated with visible light and a system of lenses is used to produce an image." .

CHMO:0000701 a owl:Class ;
    rdfs:label "CHMO:0000701" ;
    dcterms:title "liquid chromatography-tandem mass spectrometry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A method where a sample mixture is first separated by liquid chromatography before being ionised and characterised by mass-to-charge ratio and relative abundance using two mass spectrometers in series." .

DUO:0000004 a owl:Class ;
    rdfs:label "DUO:0000004" ;
    dcterms:title "no restriction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUsePermission,
        linkml:PermissibleValue ;
    skos:definition "This data use permission indicates there is no restriction on use." .

DUO:00000044 a owl:Class ;
    rdfs:label "DUO:00000044" ;
    dcterms:title "population origins or ancestry research prohibited" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates use for purposes of population, origin, or ancestry research is prohibited." .

DUO:0000006 a owl:Class ;
    rdfs:label "DUO:0000006" ;
    dcterms:title "health or medical or biomedical research" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUsePermission,
        linkml:PermissibleValue ;
    skos:definition "This data use permission indicates that use is allowed for health/medical/biomedical purposes; does not include the study of population origins or ancestry." .

DUO:0000007 a owl:Class ;
    rdfs:label "DUO:0000007" ;
    dcterms:title "disease specific research" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUsePermission,
        linkml:PermissibleValue ;
    skos:definition """This data use permission indicates that use is allowed provided it is related to the specified disease.
This term should be coupled with a term describing a disease from an ontology to specify the disease the restriction applies to. 

DUO recommends MONDO be used, to provide the basis for automated evaluation. For more information see https://github.com/EBISPOT/DUO/blob/master/MONDO_Overview.md

Other resources, such as the Disease Ontology, HPO, SNOMED-CT or others, can also be used. When those other resources are being used, this may require an extra mapping step to leverage automated matching algorithms.""" .

DUO:0000011 a owl:Class ;
    rdfs:label "DUO:0000011" ;
    dcterms:title "population origins or ancestry research only" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUsePermission,
        linkml:PermissibleValue ;
    skos:definition "This data use permission indicates that use of the data is limited to the study of population origins or ancestry." .

DUO:0000012 a owl:Class ;
    rdfs:label "DUO:0000012" ;
    dcterms:title "research specific restrictions" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use is limited to studies of a certain research type." .

DUO:0000015 a owl:Class ;
    rdfs:label "DUO:0000015" ;
    dcterms:title "no general methods research" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use does not allow methods development research (e.g., development of software or algorithms)." .

DUO:0000016 a owl:Class ;
    rdfs:label "DUO:0000016" ;
    dcterms:title "genetic studies only" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use is limited to genetic studies only (i.e., studies that include genotype research alone or both genotype and phenotype research, but not phenotype research exclusively)" .

DUO:0000018 a owl:Class ;
    rdfs:label "DUO:0000018" ;
    dcterms:title "not for profit, non commercial use only" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations and not-for-profit use, non-commercial use." .

DUO:0000019 a owl:Class ;
    rdfs:label "DUO:0000019" ;
    dcterms:title "publication required" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that requestor agrees to make results of studies using the data available to the larger scientific community." .

DUO:0000020 a owl:Class ;
    rdfs:label "DUO:0000020" ;
    dcterms:title "collaboration required" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """This could be coupled with a string describing the primary study investigator(s).
This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s).""" .

DUO:0000021 a owl:Class ;
    rdfs:label "DUO:0000021" ;
    dcterms:title "ethics approval required" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that the requestor must provide documentation of local IRB/ERB approval." .

DUO:0000022 a owl:Class ;
    rdfs:label "DUO:0000022" ;
    dcterms:title "geographical restriction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """This data use modifier indicates that use is limited to within a specific geographic region.
This should be coupled with an ontology term describing the geographical location the restriction applies to.""" .

DUO:0000024 a owl:Class ;
    rdfs:label "DUO:0000024" ;
    dcterms:title "publication moratorium" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """This data use modifier indicates that requestor agrees not to publish results of studies until a specific date.
This should be coupled with a date specified as ISO8601""" .

DUO:0000025 a owl:Class ;
    rdfs:label "DUO:0000025" ;
    dcterms:title "time limit on use" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """This data use modifier indicates that use is approved for a specific number of months.
This should be coupled with an integer value indicating the number of months.""" .

DUO:0000026 a owl:Class ;
    rdfs:label "DUO:0000026" ;
    dcterms:title "user specific restriction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use is limited to use by approved users." .

DUO:0000027 a owl:Class ;
    rdfs:label "DUO:0000027" ;
    dcterms:title "project specific restriction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved project." .

DUO:0000028 a owl:Class ;
    rdfs:label "DUO:0000028" ;
    dcterms:title "institution specific restriction" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use is limited to use within an approved institution." .

DUO:0000029 a owl:Class ;
    rdfs:label "DUO:0000029" ;
    dcterms:title "return to database or resource" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that the requestor must return derived/enriched data to the database/resource." .

DUO:0000042 a owl:Class ;
    rdfs:label "DUO:0000042" ;
    dcterms:title "general research use" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUsePermission,
        linkml:PermissibleValue ;
    skos:definition """This data use permission indicates that use is allowed for general research use for any research purpose.
This includes but is not limited to: health/medical/biomedical purposes, fundamental biology research, the study of population origins or ancestry, statistical methods and algorithms development, and social-sciences research.""" .

DUO:0000043 a owl:Class ;
    rdfs:label "DUO:0000043" ;
    dcterms:title "clinical care use" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """Clinical Care is defined as Health care or services provided at home, in a healthcare facility or hospital. Data may be used for clinical decision making.
This data use modifier indicates that use is allowed for clinical use and care.""" .

DUO:0000045 a owl:Class ;
    rdfs:label "DUO:0000045" ;
    dcterms:title "not for profit organisation use only" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition "This data use modifier indicates that use of the data is limited to not-for-profit organizations." .

DUO:0000046 a owl:Class ;
    rdfs:label "DUO:0000046" ;
    dcterms:title "non-commercial use only" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataUseModifier,
        linkml:PermissibleValue ;
    skos:definition """This data use modifier indicates that use of the data is limited to not-for-profit use.
This indicates that data can be used by commercial organisations for research purposes, but not commercial purposes.""" .

OBI:0000070 a owl:Class ;
    rdfs:label "OBI:0000070" ;
    dcterms:title "assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "assay" .

OBI:0000117 a owl:Class ;
    rdfs:label "OBI:0000117" ;
    dcterms:title "Bernoulli trial" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay where the output data is a datum with one of two values denoting success and failure." .

OBI:0000182 a owl:Class ;
    rdfs:label "OBI:0000182" ;
    dcterms:title "NMR 3D molecular structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D molecular structure determination assay that uses magnetic properties of atomic nuclei to determine the 3D structure and dynamics of molecules in the input sample." .

OBI:0000185 a owl:Class ;
    rdfs:label "OBI:0000185" ;
    dcterms:title "imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that produces a picture of an entity." .

OBI:0000201 a owl:Class ;
    rdfs:label "OBI:0000201" ;
    dcterms:title "radioactivity detection" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the amount of radiation in the radioactive spectrum (alpha, beta or gamma rays) emitted from an input material." .

OBI:0000288 a owl:Class ;
    rdfs:label "OBI:0000288" ;
    dcterms:title "protein-protein interaction detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines interactions between proteins, such as protein-protein binding." .

OBI:0000291 a owl:Class ;
    rdfs:label "OBI:0000291" ;
    dcterms:title "transcription factor binding site assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay tthat determines DNA regions specifically recognized by proteins that function as transcription factors" .

OBI:0000366 a owl:Class ;
    rdfs:label "OBI:0000366" ;
    dcterms:title "metabolite profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects and identifies chemical entities resulting from biochemical and cellular metabolism" .

OBI:0000418 a owl:Class ;
    rdfs:label "OBI:0000418" ;
    dcterms:title "measuring glucose concentration in blood serum assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the concentration of glucose molecules in a blood serum sample" .

OBI:0000424 a owl:Class ;
    rdfs:label "OBI:0000424" ;
    dcterms:title "transcription profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines gene expression and transcription activity using ribonucleic acids collected from a material entity." .

OBI:0000433 a owl:Class ;
    rdfs:label "OBI:0000433" ;
    dcterms:title "DNA sequence feature detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay with the objective to determine a sequence feature of DNA" .

OBI:0000435 a owl:Class ;
    rdfs:label "OBI:0000435" ;
    dcterms:title "genotyping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay which generates data about a genotype from a specimen of genomic DNA. A variety of techniques and instruments can be used to produce information about sequence variation at particular genomic positions." .

OBI:0000438 a owl:Class ;
    rdfs:label "OBI:0000438" ;
    dcterms:title "DNA sequence variation detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures changes (expansion, amplification, deletion, mutation) in the sequence of a DNA molecule." .

OBI:0000443 a owl:Class ;
    rdfs:label "OBI:0000443" ;
    dcterms:title "analyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay with the objective to capture information about the presence, concentration, or amount of an analyte in an evaluant." .

OBI:0000445 a owl:Class ;
    rdfs:label "OBI:0000445" ;
    dcterms:title "mass measurement assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the mass of an evaluant" .

OBI:0000447 a owl:Class ;
    rdfs:label "OBI:0000447" ;
    dcterms:title "intracellular electrophysiology recording assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An electrophysiology assay where the recording location of the electrode is intracellular." .

OBI:0000454 a owl:Class ;
    rdfs:label "OBI:0000454" ;
    dcterms:title "extracellular electrophysiology recording assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An electrophysiology assay where the recording location of the electrode is extracellular." .

OBI:0000470 a owl:Class ;
    rdfs:label "OBI:0000470" ;
    dcterms:title "mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies the amount and type of material entities present in a sample by fragmenting the sample and measuring the mass-to-charge ratio of the resulting particles." .

OBI:0000520 a owl:Class ;
    rdfs:label "OBI:0000520" ;
    dcterms:title "clinical chemistry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay which uses analytical methods to produce measurements and data on the concentration of chemical parameters (analytes) present in a specimen collected from an organism in order to determine a phenotype of that organism." .

OBI:0000537 a owl:Class ;
    rdfs:label "OBI:0000537" ;
    dcterms:title "copy number variation profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines lost or amplified genomic regions of DNA by comparing genomic DNA originating from tissues from the same or different individuals using specific techniques such as CGH, array CGH, SNP genotyping" .

OBI:0000615 a owl:Class ;
    rdfs:label "OBI:0000615" ;
    dcterms:title "protein expression profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines protein expression and translation activity using protein extracts collected from a material entity." .

OBI:0000623 a owl:Class ;
    rdfs:label "OBI:0000623" ;
    dcterms:title "NMR spectroscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that exploits the magnetic properties of certain nuclei (those with a spin) to resonate when placed in particular magnetic field conditions. Instruments recording NMR spectrum and sets of analysis can be used to deduce identity of chemical as well as composition of complex chemical mixtures." .

OBI:0000626 a owl:Class ;
    rdfs:label "OBI:0000626" ;
    dcterms:title "DNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay which determines information on the sequence of a DNA molecule." .

OBI:0000630 a owl:Class ;
    rdfs:label "OBI:0000630" ;
    dcterms:title "hematology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that studies phenotypes of an organism involving its blood and blood producing organs using a variety of techniques and instruments" .

OBI:0000634 a owl:Class ;
    rdfs:label "OBI:0000634" ;
    dcterms:title "DNA methylation profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the state of methylation of DNA molecules using genomic DNA collected from a material entity using a range of techniques and instrument such as DNA sequencers and often relying on treatment with bisulfites to ensure cytosine conversion." .

OBI:0000661 a owl:Class ;
    rdfs:label "OBI:0000661" ;
    dcterms:title "enzyme-linked immunosorbent assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay where binding of an enzyme linked antibody to a material entity that is immobilized on solid support is detected utilizing a chemiluminescent reaction. Depending on the setup, the enzyme-linked antibody could be binding directly to the analyte, or it serves as a secondary antibody detecting binding of the primary antibody to the analyte." .

OBI:0000664 a owl:Class ;
    rdfs:label "OBI:0000664" ;
    dcterms:title "BrdU incorporation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cell proliferation assay in which cells are cultured in the presence of BrdU which is incorporated into newly synthesized DNA of replicating cells (during the S phase of the cell cycle), substituting for thymidine during DNA replication, which can be quantified by BrdU specific antibodies." .

OBI:0000669 a owl:Class ;
    rdfs:label "OBI:0000669" ;
    dcterms:title "tritiated thymidine incorporation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cell proliferation assay in which cells are cultured in the presence of tritiated thymidine which is incorporated into newly synthesized DNA of replicating cells (during the S phase of the cell cycle). The radioactivity of tritiated thymidine in a cell is a proxy for cells that were actively replicating." .

OBI:0000693 a owl:Class ;
    rdfs:label "OBI:0000693" ;
    dcterms:title "MeDIP-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA methylation profiling assay that identifies methylated sites in genomic DNA and determines the methylation pattern that affect gene transcription using immunoprecipitation of methylated genomic DNA, creation of a library of corresponding DNA fragments (either single or paired-end fragments) and subsequent sequencing using parallelized sequencing methods." .

OBI:0000695 a owl:Class ;
    rdfs:label "OBI:0000695" ;
    dcterms:title "chain termination sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay which rely on the use of dideoxynucleotides used in 4 distinct sequencing reaction on the same DNA sample. The dideoxynucleotides, once incorporated in the complementary DNA strand being synthesized by the DNA polymerase prevent any further chain elongation. The newly generated sequences are resolved on a polyacrylamide gel using electrophoresis and labels (either fluorochrome or radioactivity) are used to determine the nucleotide present at a given position" .

OBI:0000697 a owl:Class ;
    rdfs:label "OBI:0000697" ;
    dcterms:title "Helicos sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing by synthesis assay that identifiies the sequnece of billions of DNA molecules immobilized to a surface using DNA polymerase and fluorescently labeled nucleotides added one at a time. The sequencing process does not require an amplification step and is typically able to produce reads of 25 base pair length." .

OBI:0000699 a owl:Class ;
    rdfs:label "OBI:0000699" ;
    dcterms:title "survival assessment assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the occurrence of death events in one or more organisms over time" .

OBI:0000705 a owl:Class ;
    rdfs:label "OBI:0000705" ;
    dcterms:title "Edman degradation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay in which the amino acid sequence of input peptides or proteins is determined by iteratively cleaving of the amino-terminal (N-terminal) residue without disrupting the peptide bonds and identifying it by e.g. chromatography or electropheresis." .

OBI:0000706 a owl:Class ;
    rdfs:label "OBI:0000706" ;
    dcterms:title "SOLiD sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing by ligation assay that identifies sequence information using primers to hybridize to the P1 adapter sequence within the library template, fluorescently labeled di-base probes to compete for ligation to the sequencing primer, multiple cycles of ligation, detection and cleavage to determine the eventual read length, following a series of ligation cycles, the extension product is removed and the template is reset with a primer complementary to the n-1 position for a second round of ligation cycles." .

OBI:0000716 a owl:Class ;
    rdfs:label "OBI:0000716" ;
    dcterms:title "ChIP-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which chromatin is immunoprecipitated and subsequently analyzed using a DNA sequencing step to identify which parts of DNA are part of the isolated chromatin" .

OBI:0000721 a owl:Class ;
    rdfs:label "OBI:0000721" ;
    dcterms:title "glucose tolerance test" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures glucose clearance from blood over time by repeated glucose measurement in blood serum or plasma after the administration of a glucose bolus in-vivo. This assay can be used to evaluate the severity of insulin resistance or the efficiency of glucose clearance." .

OBI:0000723 a owl:Class ;
    rdfs:label "OBI:0000723" ;
    dcterms:title "DNA sequencing by ligation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that performs chain extension during the sequencing reaction step using DNA ligase" .

OBI:0000724 a owl:Class ;
    rdfs:label "OBI:0000724" ;
    dcterms:title "Solexa sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing by synthesis assay that identifies sequence information using DNA polymerase and reversible terminator, requiring immobilization of genomic DNA fragments onto a surface and a specific clonal amplification step known as bridge PCR. Reliance on a reversible terminator allows cycles of DNA chain extension by DNA polymerase and imaging without the need of electrophoretic separation of newly synthesized DNA fragment as with Sanger sequencing." .

OBI:0000730 a owl:Class ;
    rdfs:label "OBI:0000730" ;
    dcterms:title "pyrosequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing by synthesis assay which sequences a single strand of DNA by synthesizing the complementary strand along it, one base pair at a time, and detecting which base was actually added at each step. The template DNA is immobilized, and solutions of A, C, G, and T nucleotides are added and removed after the reaction, sequentially. Light is produced only when the nucleotide solution complements the first unpaired base of the template. The sequence of solutions which produce chemiluminescent signals allows the determination of the sequence of the template. ssDNA template is hybridized to a sequencing primer and incubated with the enzymes DNA polymerase, ATP sulfurylase, luciferase and apyrase, and with the substrates adenosine 5-prime phosphosulfate (APS) and luciferin." .

OBI:0000734 a owl:Class ;
    rdfs:label "OBI:0000734" ;
    dcterms:title "DNA sequencing by synthesis assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that relies on DNA polymerase activity to perform chain extension during the sequencing reaction step." .

OBI:0000743 a owl:Class ;
    rdfs:label "OBI:0000743" ;
    dcterms:title "immune response assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines information about an immune response" .

OBI:0000748 a owl:Class ;
    rdfs:label "OBI:0000748" ;
    dcterms:title "bisulfite sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA methylation profiling assay which determines the methylation status of genomic DNA using DNA sequencing techniques preceded by a bisulfite based chemical modification of genomic DNA at CpG island location." .

OBI:0000787 a owl:Class ;
    rdfs:label "OBI:0000787" ;
    dcterms:title "human antithrombin-III in blood assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the amount of antithrombin III in blood." .

OBI:0000802 a owl:Class ;
    rdfs:label "OBI:0000802" ;
    dcterms:title "prothrombin time assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the prothrombin ratio, which is the prothrombin time for a patient, divided by the result for control plasma. Most commonly the test is preformed using blood plasma. Blood is drawn into a test tube containing liquid citrate, which acts as an anticoagulant. An excess of calcium is added to enable the blood to clot again.Tissue factor (also known as factor III or thromboplastin) is added, and the time the sample takes to clot is measured optically as the prothrombin time, which is compared to a control sample." .

OBI:0000805 a owl:Class ;
    rdfs:label "OBI:0000805" ;
    dcterms:title "antithrombin-III berichrome assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antithrombin-III (AT-III) assay in which exogenous bovine thrombin and heparin are added to test plasma to form a thrombin-heparin-AT complex. The residual thrombin not bound then hydrolyzes the p-nitroalanine substrate to produce a yellow color, which is read at 405 nm. The intensity of color produced is inversely proportional to the AT present. A calibration is done with standard human plasma reagent and results for a given specimen are reported as a percentage relative to the standard" .

OBI:0000808 a owl:Class ;
    rdfs:label "OBI:0000808" ;
    dcterms:title "spectrolyse heparin antifactor-Xa assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that quantitatively measures heparin in human plasma using Factor Xa and Antithrombin III in excess, where the rate of Factor Xa inhibition is directly proportional to the heparin concentration. The residual Factor Xa activity, measured with a Factor Xa-specific chromogenic substrate, is inversely proportional to the heparin concentration." .

OBI:0000812 a owl:Class ;
    rdfs:label "OBI:0000812" ;
    dcterms:title "measuring neural activity in the caudate nucleus assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures neural activity in the caudate nucleus" .

OBI:0000820 a owl:Class ;
    rdfs:label "OBI:0000820" ;
    dcterms:title "activated partial thromboplastin time assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that evaluates blood coagulation by measuring the time required for the appearance of fibrin strands following the mixing blood or plasma with phospholipid platelet substitute (e.g., crude cephalins, soybean phosphatides). It is a test of the intrinsic pathway (factors VIII, IX, XI, and XII) and the common pathway (fibrinogen, prothrombin, factors V and X) of blood coaguation . It is used as a screening test and to monitor heparin therapy." .

OBI:0000823 a owl:Class ;
    rdfs:label "OBI:0000823" ;
    dcterms:title "thrombin time assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the time between the addition of the thrombin and the clot formation in plasma." .

OBI:0000854 a owl:Class ;
    rdfs:label "OBI:0000854" ;
    dcterms:title "western blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that detects specific peptides in an input material by separating it using gel electrophoresis, transfering the separated molecules to a membrane, and staining them with_ antibodies specific to the analyte molecules." .

OBI:0000860 a owl:Class ;
    rdfs:label "OBI:0000860" ;
    dcterms:title "northern blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the presence of gene transcripts by hybridizing labeled RNA or DNA probes against messenger RNAs isolated from tissue or cell cultures, resolved on denaturing gel, transfered by a blotting procedure to a solid support. Detection of hybridization signals is carried out by immunofluorescence or radioactivity measurements using photographic films or digital imaging devices such as Phosphor Imager." .

OBI:0000865 a owl:Class ;
    rdfs:label "OBI:0000865" ;
    dcterms:title "96-well neutralization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A serum neutralization of viral infectivity assay which is performed in a 96-well plate." .

OBI:0000870 a owl:Class ;
    rdfs:label "OBI:0000870" ;
    dcterms:title "single-nucleotide-resolution nucleic acid structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that provides information about the secondary structure of nucleic acids using chemical or enzymatic probing to establish the extent of base-pairing or solvent accessiblity." .

OBI:0000871 a owl:Class ;
    rdfs:label "OBI:0000871" ;
    dcterms:title "viral hemagglutination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that quantifies viruses by their hemagglutination activity." .

OBI:0000872 a owl:Class ;
    rdfs:label "OBI:0000872" ;
    dcterms:title "serum neutralization of viral infectivity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures virus-neutralizing abilities of different sera. Different dilutions of serum are mixed with virus and used to infect cells. At the lower dilutions, antibodies will block infection, but at higher dilutions, there will be too few antibodies to have an effect.The neutralization titer is expressed as the reciprocal of the highest dilution at which virus infection is blocked." .

OBI:0000874 a owl:Class ;
    rdfs:label "OBI:0000874" ;
    dcterms:title "detection of specific nucleic acid polymers with complementary probes" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay in which a specified input material (the evaluant) is examined for the presence or quantity of specified nucleic acid polymers, which are identified based on the use of complementary nucleic acid probes." .

OBI:0000875 a owl:Class ;
    rdfs:label "OBI:0000875" ;
    dcterms:title "viral hemagglutination inhibition assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the ability of an evaluant to inhibit hemagglutination by a virus. Hemagglutinin is a viral protein which binds to sialic acid receptors on cells or to erythrocytes, causing the cells to clump. Loss of clumping indicates that the evaluant blocks binding of hemagglutinin to sialic acid receptors." .

OBI:0000882 a owl:Class ;
    rdfs:label "OBI:0000882" ;
    dcterms:title "cell-cell killing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that monitors a cell population to track how many are killed by other cells." .

OBI:0000883 a owl:Class ;
    rdfs:label "OBI:0000883" ;
    dcterms:title "in vivo cell killing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cell killing assay that measures if and how many target cells are killed within an organism." .

OBI:0000891 a owl:Class ;
    rdfs:label "OBI:0000891" ;
    dcterms:title "cell proliferation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay which measures the degreee to which input cells are replicating." .

OBI:0000892 a owl:Class ;
    rdfs:label "OBI:0000892" ;
    dcterms:title "Southern blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that detects the presence of a specific sequence in a DNA sample, which has been digested by restriction enzymes, resolved by gel electrophoresis, and blotted to a solid support, followed by hybridization of a probe raised against a specific sequence and detected with fluorescence or radioactivity." .

OBI:0000893 a owl:Class ;
    rdfs:label "OBI:0000893" ;
    dcterms:title "real time polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay, based on the PCR, that amplifies and simultaneously quantifies a specific DNA molecule based on the use of complementary probes/primers. It enables both detection and quantification (as absolute number of copies or relative amount when normalized to DNA input or additional normalizing genes) of one or more specific sequences in a DNA sample." .

OBI:0000897 a owl:Class ;
    rdfs:label "OBI:0000897" ;
    dcterms:title "DEPC structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay which determines nucleic acid secondary structure at a nucleotide resolution scale using DEPC as reagent and chemical probe" .

OBI:0000903 a owl:Class ;
    rdfs:label "OBI:0000903" ;
    dcterms:title "in vitro cell killing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cell killing assay that measures if and how many target cells are actively killed by other cells in a cell culture." .

OBI:0000904 a owl:Class ;
    rdfs:label "OBI:0000904" ;
    dcterms:title "reporter cell line analyte detection bioassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay in which a cell line whose growth is known to be affected by the presence of a specific type of material (the anlyte) is cultured in the presence of an input material (the evaluant) in order to detect presence of the analyte in the evaluant." .

OBI:0000910 a owl:Class ;
    rdfs:label "OBI:0000910" ;
    dcterms:title "radio immuno assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which a radioactive labeled antigen or antibody is used to determine the interaction between an antigen and its receptor. This can be used to detect the presence of an antigen of interest in an input sample or determine the specificity of an input antibody." .

OBI:0000911 a owl:Class ;
    rdfs:label "OBI:0000911" ;
    dcterms:title "real time reverse-transcription polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses a reverse transcription step (an RNA strand is reverse transcribed into its DNA complement using the enzyme reverse transcriptase) before a PCR assay." .

OBI:0000912 a owl:Class ;
    rdfs:label "OBI:0000912" ;
    dcterms:title "X-ray crystallography 3D molecular structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D molecular structure determination assay in which the diffraction of pattern of X-ray beams in a crystal of purified material entities is used to resolve the 3-dimensional structure of the material entity of interest." .

OBI:0000913 a owl:Class ;
    rdfs:label "OBI:0000913" ;
    dcterms:title "promoter activity detection by reporter gene assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which the activity of a promoter in a cell is monitored by using a reporter gene that was inserted in a genomic location under control of the promoter and whose expression can be easily detected based on qualities or functions of the gene." .

OBI:0000916 a owl:Class ;
    rdfs:label "OBI:0000916" ;
    dcterms:title "flow cytometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay in which an input cell population is put in solution, is passed by a laser, and optical sensors are used to detect scattering of the laser light and/or fluorescence of specific markers to count and characterize the particles in solution." .

OBI:0000920 a owl:Class ;
    rdfs:label "OBI:0000920" ;
    dcterms:title "cytometric bead array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay in which a series of beads coated with antibodies, antigens, or other small molecules are used to detect an analyte of interest." .

OBI:0000923 a owl:Class ;
    rdfs:label "OBI:0000923" ;
    dcterms:title "surface plasmon resonance binding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay that uses the detection of electromagnetic waves in a surface to detect material entities adsorbed to the surface, which change the local optical index of refraction." .

OBI:0000944 a owl:Class ;
    rdfs:label "OBI:0000944" ;
    dcterms:title "handedness assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the unequal distribution of fine motor skill between the left and right hands typically in human subjects by means of some questionnaire and scoring procedure." .

OBI:0000957 a owl:Class ;
    rdfs:label "OBI:0000957" ;
    dcterms:title "self reported handedness assessment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay where a person makes a statement that indicates what handedness he has from a choice of different categories." .

OBI:0000964 a owl:Class ;
    rdfs:label "OBI:0000964" ;
    dcterms:title "in live cell assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which a measurement is made by observing entities located in a live cell." .

OBI:0000966 a owl:Class ;
    rdfs:label "OBI:0000966" ;
    dcterms:title "in live organism assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which a measurement is made by observing entities located in an organism." .

OBI:0000975 a owl:Class ;
    rdfs:label "OBI:0000975" ;
    dcterms:title "cell-cell binding detection by flow cytometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay which uses a flow cytometer to detect pairs of cells that are bound to each other by staining them with different fluorescent labels." .

OBI:0000978 a owl:Class ;
    rdfs:label "OBI:0000978" ;
    dcterms:title "in container assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which a measurement is made by observing entities located in a container." .

OBI:0001001 a owl:Class ;
    rdfs:label "OBI:0001001" ;
    dcterms:title "Edinburgh handedness assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses a set of questions (the Edinburgh Handedness inventory) to generate a score that can be used to assess the dominance of a person's right or left hand in everyday activities. The inventory can be used by an observer assessing the person, or by a person self-reporting hand use. The latter method tends to be less reliable due to a person over-attributing tasks to the dominant hand." .

OBI:0001005 a owl:Class ;
    rdfs:label "OBI:0001005" ;
    dcterms:title "RNASE CL3 structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution ribonucleic acid structure mapping assay that determines nucleic acid secondary structure at a nucleotide resolution scale using RNAse CL3 as reagent and enzymatic probe." .

OBI:0001006 a owl:Class ;
    rdfs:label "OBI:0001006" ;
    dcterms:title "CMCT structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay which uses CMCT as reagent and chemical probe to generate data and information at nucleotide resolution scale contributing to the determination of nucleic acid secondary structure" .

OBI:0001008 a owl:Class ;
    rdfs:label "OBI:0001008" ;
    dcterms:title "MPE-Fe(II) structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution ribonucleic acid structure mapping assay that determines nucleic acid secondary structure at the nucleotide resolution scale using Fe-MP as reagent and chemical probe." .

OBI:0001011 a owl:Class ;
    rdfs:label "OBI:0001011" ;
    dcterms:title "ENU structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay that determines the secondary structure of a nucleic acid at the nucleotide resolution scale which uses ENU as reagent and chemical probe" .

OBI:0001012 a owl:Class ;
    rdfs:label "OBI:0001012" ;
    dcterms:title "RNASE V1 structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution ribonucleic acid structure mapping assay that determines nucleic acid secondary structure at a nucleotide resolution scale using RNAse V1 as reagent and enzymatic probe" .

OBI:0001013 a owl:Class ;
    rdfs:label "OBI:0001013" ;
    dcterms:title "kethoxal structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay that determines nucleic acid secondary structure at nucleotide resolution scale using kethoxal as reagent and chemical probe" .

OBI:0001014 a owl:Class ;
    rdfs:label "OBI:0001014" ;
    dcterms:title "single-nucleotide-resolution nucleic acid structure mapping assay using enzymatic probing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay that determines structural information about the RNA species under study using proteins acting as enzymatic probes." .

OBI:0001015 a owl:Class ;
    rdfs:label "OBI:0001015" ;
    dcterms:title "DMS structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
