    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the mass of a material at two or more time points" .

OBI:0600031 a owl:Class ;
    rdfs:label "OBI:0600031" ;
    dcterms:title "enzyme-linked immunospot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay in which cells are cultured on a surface coated with a capture antibody binding a secretory material of interest which subsequently gets stained resulting in a spot for each cell producing the secretory material of interest." .

OBI:0600045 a owl:Class ;
