edam:data_1526 a owl:Class ;
    rdfs:label "edam:data_1526" ;
    dcterms:title "Protein globularity" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
