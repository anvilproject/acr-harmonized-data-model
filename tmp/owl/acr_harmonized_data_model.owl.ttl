OBI:0001994 a owl:Class ;
    rdfs:label "OBI:0001994" ;
    dcterms:title "assay measuring the MHC ligand binding on rate [kon] of a MHC:ligand complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A MHC binding constant determination assay measuring binding on rate (kon)." .

OBI:0001995 a owl:Class ;
    rdfs:label "OBI:0001995" ;
    dcterms:title "chromatography assay measuring the association constant [KA] of a B cell epitope:antibody complex" ;
