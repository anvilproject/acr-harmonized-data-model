cam:Concept a owl:Class ;
    rdfs:label "Concept" ;
    dcterms:title "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cam:concept_curie ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:display ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:display ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:concept_curie ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:concept_curie ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:display ],
        linkml:ClassDefinition ;
    skos:definition "A standardized concept with display information." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

