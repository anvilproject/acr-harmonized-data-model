    rdfs:label "edam:data_3498" ;
    dcterms:title "Sequence variations" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data on gene sequence variations resulting large-scale genotyping and DNA sequencing projects." .

edam:data_3505 a owl:Class ;
    rdfs:label "edam:data_3505" ;
    dcterms:title "Bibliography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A list of publications such as scientic papers or books." .

edam:data_3509 a owl:Class ;
    rdfs:label "edam:data_3509" ;
    dcterms:title "Ontology mapping" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A mapping of supplied textual terms or phrases to ontology concepts (URIs)." .

edam:data_3546 a owl:Class ;
    rdfs:label "edam:data_3546" ;
    dcterms:title "Image metadata" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Any data concerning a specific biological or biomedical image." .

edam:data_3558 a owl:Class ;
    rdfs:label "edam:data_3558" ;
    dcterms:title "Clinical trial report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A human-readable collection of information concerning a clinical trial." .

edam:data_3567 a owl:Class ;
    rdfs:label "edam:data_3567" ;
    dcterms:title "Reference sample report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A report about a biosample." .

edam:data_3568 a owl:Class ;
    rdfs:label "edam:data_3568" ;
    dcterms:title "Gene Expression Atlas Experiment ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Accession number of an entry from the Gene Expression Atlas." .

edam:data_3667 a owl:Class ;
    rdfs:label "edam:data_3667" ;
    dcterms:title "Disease identifier" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier of an entry from a database of disease." .

edam:data_3668 a owl:Class ;
    rdfs:label "edam:data_3668" ;
    dcterms:title "Disease name" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "The name of some disease." .

edam:data_3669 a owl:Class ;
    rdfs:label "edam:data_3669" ;
    dcterms:title "Learning material" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Learning material is a document or another digital object that is designed for learning (educational, training) purposes." .

edam:data_3670 a owl:Class ;
    rdfs:label "edam:data_3670" ;
    dcterms:title "Online course" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A training course available for use on the Web." .

edam:data_3671 a owl:Class ;
    rdfs:label "edam:data_3671" ;
    dcterms:title "Text" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Any free or plain text, typically for human consumption and in English. Can instantiate also as a textual search query." .

edam:data_3707 a owl:Class ;
    rdfs:label "edam:data_3707" ;
    dcterms:title "Biodiversity data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Machine-readable biodiversity data." .

edam:data_3716 a owl:Class ;
    rdfs:label "edam:data_3716" ;
    dcterms:title "Biosafety report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A human-readable collection of information concerning biosafety data." .

edam:data_3717 a owl:Class ;
    rdfs:label "edam:data_3717" ;
    dcterms:title "Isolation report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A report about any kind of isolation of biological material." .

edam:data_3718 a owl:Class ;
    rdfs:label "edam:data_3718" ;
    dcterms:title "Pathogenicity report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Information about the ability of an organism to cause disease in a corresponding host." .

edam:data_3719 a owl:Class ;
    rdfs:label "edam:data_3719" ;
    dcterms:title "Biosafety classification" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Information about the biosafety classification of an organism according to corresponding law." .

edam:data_3720 a owl:Class ;
    rdfs:label "edam:data_3720" ;
    dcterms:title "Geographic location" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A report about localisation of the isolaton of biological material e.g. country or coordinates." .

edam:data_3721 a owl:Class ;
    rdfs:label "edam:data_3721" ;
    dcterms:title "Isolation source" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A report about any kind of isolation source of biological material e.g. blood, water, soil." .

edam:data_3722 a owl:Class ;
    rdfs:label "edam:data_3722" ;
    dcterms:title "Physiology parameter" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Experimentally determined parameter of the physiology of an organism, e.g. substrate spectrum." .

edam:data_3723 a owl:Class ;
    rdfs:label "edam:data_3723" ;
    dcterms:title "Morphology parameter" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Experimentally determined parameter of the morphology of an organism, e.g. size & shape." .

edam:data_3724 a owl:Class ;
    rdfs:label "edam:data_3724" ;
    dcterms:title "Cultivation parameter" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Experimental determined parameter for the cultivation of an organism." .

edam:data_3732 a owl:Class ;
    rdfs:label "edam:data_3732" ;
    dcterms:title "Sequencing metadata name" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data concerning a sequencing experiment, that may be specified as an input to some tool." .

edam:data_3733 a owl:Class ;
    rdfs:label "edam:data_3733" ;
    dcterms:title "Flow cell identifier" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "An identifier of a flow cell of a sequencing machine." .

edam:data_3734 a owl:Class ;
    rdfs:label "edam:data_3734" ;
    dcterms:title "Lane identifier" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "An identifier of a lane within a flow cell of a sequencing machine, within which millions of sequences are immobilised, amplified and sequenced." .

edam:data_3735 a owl:Class ;
    rdfs:label "edam:data_3735" ;
    dcterms:title "Run number" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A number corresponding to the number of an analysis performed by a sequencing machine. For example, if it's the 13th analysis, the run is 13." .

edam:data_3736 a owl:Class ;
    rdfs:label "edam:data_3736" ;
    dcterms:title "Ecological data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data concerning ecology; for example measurements and reports from the study of interactions among organisms and their environment." .

edam:data_3737 a owl:Class ;
    rdfs:label "edam:data_3737" ;
    dcterms:title "Alpha diversity data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "The mean species diversity in sites or habitats at a local scale." .

edam:data_3738 a owl:Class ;
    rdfs:label "edam:data_3738" ;
    dcterms:title "Beta diversity data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "The ratio between regional and local species diversity." .

edam:data_3739 a owl:Class ;
    rdfs:label "edam:data_3739" ;
    dcterms:title "Gamma diversity data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "The total species diversity in a landscape." .

edam:data_3743 a owl:Class ;
    rdfs:label "edam:data_3743" ;
    dcterms:title "Ordination plot" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A plot in which community data (e.g. species abundance data) is summarised. Similar species and samples are plotted close together, and dissimilar species and samples are plotted placed far apart." .

edam:data_3753 a owl:Class ;
    rdfs:label "edam:data_3753" ;
    dcterms:title "Over-representation data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A ranked list of categories (usually ontology concepts), each associated with a statistical metric of over-/under-representation within the studied data." .

edam:data_3754 a owl:Class ;
    rdfs:label "edam:data_3754" ;
    dcterms:title "GO-term enrichment data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A ranked list of Gene Ontology concepts, each associated with a p-value, concerning or derived from the analysis of e.g. a set of genes or proteins." .

edam:data_3756 a owl:Class ;
    rdfs:label "edam:data_3756" ;
    dcterms:title "Localisation score" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Score for localization of one or more post-translational modifications in peptide sequence measured by mass spectrometry." .

edam:data_3757 a owl:Class ;
    rdfs:label "edam:data_3757" ;
    dcterms:title "Unimod ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier of a protein modification catalogued in the Unimod database." .

edam:data_3759 a owl:Class ;
    rdfs:label "edam:data_3759" ;
    dcterms:title "ProteomeXchange ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier for mass spectrometry proteomics data in the proteomexchange.org repository." .

edam:data_3768 a owl:Class ;
    rdfs:label "edam:data_3768" ;
    dcterms:title "Clustered expression profiles" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Groupings of expression profiles according to a clustering algorithm." .

edam:data_3769 a owl:Class ;
    rdfs:label "edam:data_3769" ;
    dcterms:title "BRENDA ontology concept ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "An identifier of a concept from the BRENDA ontology." .

edam:data_3779 a owl:Class ;
    rdfs:label "edam:data_3779" ;
    dcterms:title "Annotated text" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A text (such as a scientific article), annotated with notes, data and metadata, such as recognised entities, concepts, and their relations." .

edam:data_3786 a owl:Class ;
    rdfs:label "edam:data_3786" ;
    dcterms:title "Query script" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A structured query, in form of a script, that defines a database search task." .

edam:data_3805 a owl:Class ;
    rdfs:label "edam:data_3805" ;
    dcterms:title "3D EM Map" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Structural 3D model (volume map) from electron microscopy." .

edam:data_3806 a owl:Class ;
    rdfs:label "edam:data_3806" ;
    dcterms:title "3D EM Mask" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Annotation on a structural 3D EM Map from electron microscopy. This might include one or several locations in the map of the known features of a particular macromolecule." .

edam:data_3807 a owl:Class ;
    rdfs:label "edam:data_3807" ;
    dcterms:title "EM Movie" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Raw DDD movie acquisition from electron microscopy." .

edam:data_3808 a owl:Class ;
    rdfs:label "edam:data_3808" ;
    dcterms:title "EM Micrograph" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Raw acquisition from electron microscopy or average of an aligned DDD movie." .

edam:data_3842 a owl:Class ;
    rdfs:label "edam:data_3842" ;
    dcterms:title "Molecular simulation data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data coming from molecular simulations, computer \"experiments\" on model molecules." .

edam:data_3856 a owl:Class ;
    rdfs:label "edam:data_3856" ;
    dcterms:title "RNA central ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier of an entry from the RNA central database of annotated human miRNAs." .

edam:data_3861 a owl:Class ;
    rdfs:label "edam:data_3861" ;
    dcterms:title "Electronic health record" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A human-readable systematic collection of patient (or population) health information in a digital format." .

edam:data_3869 a owl:Class ;
    rdfs:label "edam:data_3869" ;
    dcterms:title "Simulation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data coming from molecular simulations, computer \"experiments\" on model molecules. Typically formed by two separated but indivisible pieces of information: topology data (static) and trajectory data (dynamic)." .

edam:data_3870 a owl:Class ;
    rdfs:label "edam:data_3870" ;
    dcterms:title "Trajectory data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Dynamic information of a structure molecular system coming from a molecular simulation: XYZ 3D coordinates (sometimes with their associated velocities) for every atom along time." .

edam:data_3871 a owl:Class ;
    rdfs:label "edam:data_3871" ;
    dcterms:title "Forcefield parameters" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Force field parameters: charges, masses, radii, bond lengths, bond dihedrals, etc. define the structural molecular system, and are essential for the proper description and simulation of a molecular system." .

edam:data_3872 a owl:Class ;
    rdfs:label "edam:data_3872" ;
    dcterms:title "Topology data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Static information of a structure molecular system that is needed for a molecular simulation: the list of atoms, their non-bonded parameters for Van der Waals and electrostatic interactions, and the complete connectivity in terms of bonds, angles and dihedrals." .

edam:data_3905 a owl:Class ;
    rdfs:label "edam:data_3905" ;
    dcterms:title "Histogram" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Visualization of distribution of quantitative data, e.g. expression data, by histograms, violin plots and density plots." .

edam:data_3914 a owl:Class ;
    rdfs:label "edam:data_3914" ;
    dcterms:title "Quality control report" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Report of the quality control review that was made of factors involved in a procedure." .

edam:data_3917 a owl:Class ;
    rdfs:label "edam:data_3917" ;
    dcterms:title "Count matrix" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A table of unnormalized values representing summarised read counts per genomic region (e.g. gene, transcript, peak)." .

edam:data_3924 a owl:Class ;
    rdfs:label "edam:data_3924" ;
    dcterms:title "DNA structure alignment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Alignment (superimposition) of DNA tertiary (3D) structures." .

edam:data_3932 a owl:Class ;
    rdfs:label "edam:data_3932" ;
    dcterms:title "Q-value" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A score derived from the P-value to ensure correction for multiple tests. The Q-value provides an estimate of the positive False Discovery Rate (pFDR), i.e. the rate of false positives among all the cases reported positive: pFDR = FP / (FP + TP)." .

edam:data_3949 a owl:Class ;
    rdfs:label "edam:data_3949" ;
    dcterms:title "Profile HMM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A profile HMM is a variant of a Hidden Markov model that is derived specifically from a set of (aligned) biological sequences. Profile HMMs provide the basis for a position-specific scoring system, which can be used to align sequences and search databases for related sequences." .

edam:data_3952 a owl:Class ;
    rdfs:label "edam:data_3952" ;
    dcterms:title "Pathway ID (WikiPathways)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier of a pathway from the WikiPathways pathway database." .

edam:data_3953 a owl:Class ;
    rdfs:label "edam:data_3953" ;
    dcterms:title "Pathway overrepresentation data" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "A ranked list of pathways, each associated with z-score, p-value or similar, concerning or derived from the analysis of e.g. a set of genes or proteins." .

edam:data_4022 a owl:Class ;
    rdfs:label "edam:data_4022" ;
    dcterms:title "ORCID Identifier" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Identifier of a researcher registered with the ORCID database. Used to identify author IDs." .

edam:data_4040 a owl:Class ;
    rdfs:label "edam:data_4040" ;
    dcterms:title "Data management plan" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "Data management plan is a document describing the data management of a project or an organisation, including acquisition, reuse, structure, processing, storage, documentation, sharing, and preservation of data. This may include budgeting for these operations." .

edam:data_4075 a owl:Class ;
    rdfs:label "edam:data_4075" ;
    dcterms:title "RefMet ID" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
    skos:definition "RefMet ID is the unique, persistent identifier used by the RefMet database (A Reference list of Metabolite names), a standardised reference nomenclature for metabolites." .

edam:format_1196 a owl:Class ;
    rdfs:label "edam:format_1196" ;
    dcterms:title "SMILES" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Chemical structure specified in Simplified Molecular Input Line Entry System (SMILES) line notation." .

edam:format_1197 a owl:Class ;
    rdfs:label "edam:format_1197" ;
    dcterms:title "InChI" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Chemical structure specified in IUPAC International Chemical Identifier (InChI) line notation." .

edam:format_1198 a owl:Class ;
    rdfs:label "edam:format_1198" ;
    dcterms:title "mf" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Chemical structure specified by Molecular Formula (MF), including a count of each element in a compound." .

edam:format_1199 a owl:Class ;
    rdfs:label "edam:format_1199" ;
    dcterms:title "InChIKey" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The InChIKey (hashed InChI) is a fixed length (25 character) condensed digital representation of an InChI chemical structure specification. It uniquely identifies a chemical compound." .

edam:format_1200 a owl:Class ;
    rdfs:label "edam:format_1200" ;
    dcterms:title "smarts" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "SMILES ARbitrary Target Specification (SMARTS) format for chemical structure specification, which is a subset of the SMILES line notation." .

edam:format_1206 a owl:Class ;
    rdfs:label "edam:format_1206" ;
    dcterms:title "unambiguous pure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a molecular sequence with possible unknown positions but without ambiguity or non-sequence characters." .

edam:format_1207 a owl:Class ;
    rdfs:label "edam:format_1207" ;
    dcterms:title "nucleotide" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a nucleotide sequence with possible ambiguity, unknown positions and non-sequence characters." .

edam:format_1208 a owl:Class ;
    rdfs:label "edam:format_1208" ;
    dcterms:title "protein" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a protein sequence with possible ambiguity, unknown positions and non-sequence characters." .

edam:format_1209 a owl:Class ;
    rdfs:label "edam:format_1209" ;
    dcterms:title "consensus" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for the consensus of two or more molecular sequences." .

edam:format_1210 a owl:Class ;
    rdfs:label "edam:format_1210" ;
    dcterms:title "pure nucleotide" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
