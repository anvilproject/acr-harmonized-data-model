    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that identifies the organism species in a specimen." .

OBI:0001630 a owl:Class ;
    rdfs:label "OBI:0001630" ;
    dcterms:title "analytical chromatography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that uses a biomaterial's preferential affinity for either the mobile phase or the stationary phase to separate it from other materials and thereby detect its presence in an input material." .

OBI:0001631 a owl:Class ;
    rdfs:label "OBI:0001631" ;
    dcterms:title "electron microscopy imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay in which an electrons are used to probe the density, shape and composition of an input material which are detected in an electron microscope and utilized to produce an image of the material." .

OBI:0001632 a owl:Class ;
    rdfs:label "OBI:0001632" ;
    dcterms:title "immuno staining assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A assay detecting a molecular label assay in which the label is attached to an antibody so that substances are marked based on the antibody's binding specificity." .

OBI:0001634 a owl:Class ;
    rdfs:label "OBI:0001634" ;
    dcterms:title "calorimetric binding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay in which the heat generated or absorbed during a binding event is measured, which allows determination of binding constants, reaction stoichiometry, enthalpy and entropy." .

OBI:0001635 a owl:Class ;
    rdfs:label "OBI:0001635" ;
    dcterms:title "antibody binding detection by fluorescence quenching" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay in which affinity is measured by detecting a change in fluorescence (usually quenching) that occurs upon binding of the antibody to the ligand. The fluorescent signal that is affected by binding is either from an exogenous fluorophore attached to the ligand, or is the intrisic fluorescence of aromatic (tryptophan) residues on the binding site of the antibody (no conjugated fluorophore necessary) or, less commonly, on the ligand binding region (epitope)." .

OBI:0001638 a owl:Class ;
    rdfs:label "OBI:0001638" ;
    dcterms:title "antigen inhibition assay measuring the dissociation constant [KD] of a B cell epitope:antibody complex approximated by IC50" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope equilibrium dissociation constant (KD) assay that provides IC50 values determined under assay conditions where the IC50 approximates a KD value using a B cell epitope antigen inhibition of binding assay." .

OBI:0001639 a owl:Class ;
    rdfs:label "OBI:0001639" ;
    dcterms:title "assay measuring epitope specific Ig-mediated histamine release" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope specific activation of additional immune response assay that detects histamine release in vitro." .

OBI:0001640 a owl:Class ;
    rdfs:label "OBI:0001640" ;
    dcterms:title "assay measuring epitope specific immunoglobulin-mediated antigen activation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope dependent biological activity determination assay that detects antigen activation." .

OBI:0001641 a owl:Class ;
    rdfs:label "OBI:0001641" ;
