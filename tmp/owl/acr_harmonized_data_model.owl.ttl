OBI:0001648 a owl:Class ;
    rdfs:label "OBI:0001648" ;
    dcterms:title "cross blocking assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cross-blocking assay that detects the binding of an antigen with an antibody." .

OBI:0001649 a owl:Class ;
    rdfs:label "OBI:0001649" ;
    dcterms:title "RIA measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A radio immuno assay that detects the binding of an antigen with an antibody." .

OBI:0001650 a owl:Class ;
    rdfs:label "OBI:0001650" ;
