    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for a phylogenetic tree." .

edam:format_2558 a owl:Class ;
    rdfs:label "edam:format_2558" ;
    dcterms:title "EMBL-like (XML)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "An XML format resembling EMBL entry format." .

edam:format_2559 a owl:Class ;
    rdfs:label "edam:format_2559" ;
    dcterms:title "GenBank-like format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A format resembling GenBank entry (plain text) format." .

edam:format_2561 a owl:Class ;
    rdfs:label "edam:format_2561" ;
    dcterms:title "Sequence assembly format (text)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Text format for sequence assembly data." .

edam:format_2566 a owl:Class ;
    rdfs:label "edam:format_2566" ;
    dcterms:title "completely unambiguous" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a molecular sequence without any unknown positions or ambiguity characters." .

edam:format_2567 a owl:Class ;
    rdfs:label "edam:format_2567" ;
    dcterms:title "completely unambiguous pure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a molecular sequence without unknown positions, ambiguity or non-sequence characters." .

edam:format_2568 a owl:Class ;
    rdfs:label "edam:format_2568" ;
    dcterms:title "completely unambiguous pure nucleotide" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a nucleotide sequence (characters ACGTU only) without unknown positions, ambiguity or non-sequence characters ." .

edam:format_2569 a owl:Class ;
    rdfs:label "edam:format_2569" ;
    dcterms:title "completely unambiguous pure dna" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for a DNA sequence (characters ACGT only) without unknown positions, ambiguity or non-sequence characters." .

edam:format_2570 a owl:Class ;
    rdfs:label "edam:format_2570" ;
    dcterms:title "completely unambiguous pure rna sequence" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for an RNA sequence (characters ACGU only) without unknown positions, ambiguity or non-sequence characters." .

edam:format_2571 a owl:Class ;
    rdfs:label "edam:format_2571" ;
    dcterms:title "Raw sequence format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of a raw molecular sequence (i.e. the alphabet used)." .

edam:format_2572 a owl:Class ;
    rdfs:label "edam:format_2572" ;
    dcterms:title "BAM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BAM format, the binary, BGZF-formatted compressed version of SAM format for alignment of nucleotide sequences (e.g. sequencing reads) to (a) reference sequence(s). May contain base-call and alignment qualities and other data." .

edam:format_2573 a owl:Class ;
    rdfs:label "edam:format_2573" ;
    dcterms:title "SAM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Sequence Alignment/Map (SAM) format for alignment of nucleotide sequences (e.g. sequencing reads) to (a) reference sequence(s). May contain base-call and alignment qualities and other data." .

edam:format_2585 a owl:Class ;
    rdfs:label "edam:format_2585" ;
    dcterms:title "SBML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Systems Biology Markup Language (SBML), the standard XML format for models of biological processes such as for example metabolism, cell signaling, and gene regulation." .

edam:format_2607 a owl:Class ;
    rdfs:label "edam:format_2607" ;
    dcterms:title "completely unambiguous pure protein" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Alphabet for any protein sequence without unknown positions, ambiguity or non-sequence characters." .

edam:format_2848 a owl:Class ;
    rdfs:label "edam:format_2848" ;
    dcterms:title "Bibliographic reference format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of a bibliographic reference." .

edam:format_2919 a owl:Class ;
    rdfs:label "edam:format_2919" ;
    dcterms:title "Sequence annotation track format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of a sequence annotation track." .

edam:format_2920 a owl:Class ;
    rdfs:label "edam:format_2920" ;
    dcterms:title "Alignment format (pair only)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for molecular sequence alignment information that can hold sequence alignment(s) of only 2 sequences." .

edam:format_2921 a owl:Class ;
    rdfs:label "edam:format_2921" ;
    dcterms:title "Sequence variation annotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of sequence variation annotation." .

edam:format_2922 a owl:Class ;
    rdfs:label "edam:format_2922" ;
    dcterms:title "markx0 variant" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Some variant of Pearson MARKX alignment format." .

edam:format_2923 a owl:Class ;
    rdfs:label "edam:format_2923" ;
    dcterms:title "mega variant" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Some variant of Mega format for (typically aligned) sequences." .

edam:format_2924 a owl:Class ;
    rdfs:label "edam:format_2924" ;
    dcterms:title "Phylip format variant" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Some variant of Phylip format for (aligned) sequences." .

edam:format_3000 a owl:Class ;
    rdfs:label "edam:format_3000" ;
    dcterms:title "AB1" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "AB1 binary format of raw DNA sequence reads (output of Applied Biosystems' sequencing analysis software). Contains an electropherogram and the DNA base sequence." .

edam:format_3001 a owl:Class ;
    rdfs:label "edam:format_3001" ;
    dcterms:title "ACE" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ACE sequence assembly format including contigs, base-call qualities, and other metadata (version Aug 1998 and onwards)." .

edam:format_3003 a owl:Class ;
    rdfs:label "edam:format_3003" ;
    dcterms:title "BED" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Browser Extensible Data (BED) format of sequence annotation track, typically to be displayed in a genome browser." .

edam:format_3004 a owl:Class ;
    rdfs:label "edam:format_3004" ;
    dcterms:title "bigBed" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "bigBed format for large sequence annotation tracks, similar to textual BED format." .

edam:format_3005 a owl:Class ;
    rdfs:label "edam:format_3005" ;
    dcterms:title "WIG" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Wiggle format (WIG) of a sequence annotation track that consists of a value for each sequence position. Typically to be displayed in a genome browser." .

edam:format_3006 a owl:Class ;
    rdfs:label "edam:format_3006" ;
    dcterms:title "bigWig" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "bigWig format for large sequence annotation tracks that consist of a value for each sequence position. Similar to textual WIG format." .

edam:format_3007 a owl:Class ;
    rdfs:label "edam:format_3007" ;
    dcterms:title "PSL" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PSL format of alignments, typically generated by BLAT or psLayout. Can be displayed in a genome browser like a sequence annotation track." .

edam:format_3008 a owl:Class ;
    rdfs:label "edam:format_3008" ;
    dcterms:title "MAF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Multiple Alignment Format (MAF) supporting alignments of whole genomes with rearrangements, directions, multiple pieces to the alignment, and so forth." .

edam:format_3009 a owl:Class ;
    rdfs:label "edam:format_3009" ;
    dcterms:title "2bit" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "2bit binary format of nucleotide sequences using 2 bits per nucleotide. In addition encodes unknown nucleotides and lower-case 'masking'." .

edam:format_3010 a owl:Class ;
    rdfs:label "edam:format_3010" ;
    dcterms:title ".nib" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition ".nib (nibble) binary format of a nucleotide sequence using 4 bits per nucleotide (including unknown) and its lower-case 'masking'." .

edam:format_3011 a owl:Class ;
    rdfs:label "edam:format_3011" ;
    dcterms:title "genePred" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "genePred table format for gene prediction tracks." .

edam:format_3012 a owl:Class ;
    rdfs:label "edam:format_3012" ;
    dcterms:title "pgSnp" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Personal Genome SNP (pgSnp) format for sequence variation tracks (indels and polymorphisms), supported by the UCSC Genome Browser." .

edam:format_3013 a owl:Class ;
    rdfs:label "edam:format_3013" ;
    dcterms:title "axt" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "axt format of alignments, typically produced from BLASTZ." .

edam:format_3014 a owl:Class ;
    rdfs:label "edam:format_3014" ;
    dcterms:title "LAV" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "LAV format of alignments generated by BLASTZ and LASTZ." .

edam:format_3015 a owl:Class ;
    rdfs:label "edam:format_3015" ;
    dcterms:title "Pileup" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Pileup format of alignment of sequences (e.g. sequencing reads) to (a) reference sequence(s). Contains aligned bases per base of the reference sequence(s)." .

edam:format_3016 a owl:Class ;
    rdfs:label "edam:format_3016" ;
    dcterms:title "VCF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Variant Call Format (VCF) is tabular format for storing genomic sequence variations." .

edam:format_3017 a owl:Class ;
    rdfs:label "edam:format_3017" ;
    dcterms:title "SRF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Sequence Read Format (SRF) of sequence trace data. Supports submission to the NCBI Short Read Archive." .

edam:format_3018 a owl:Class ;
    rdfs:label "edam:format_3018" ;
    dcterms:title "ZTR" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "ZTR format for storing chromatogram data from DNA sequencing instruments." .

edam:format_3019 a owl:Class ;
    rdfs:label "edam:format_3019" ;
    dcterms:title "GVF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Genome Variation Format (GVF). A GFF3-compatible format with defined header and attribute tags for sequence variation." .

edam:format_3020 a owl:Class ;
    rdfs:label "edam:format_3020" ;
    dcterms:title "BCF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BCF is the binary version of Variant Call Format (VCF) for sequence variation (indels, polymorphisms, structural variation)." .

edam:format_3033 a owl:Class ;
    rdfs:label "edam:format_3033" ;
    dcterms:title "Matrix format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of a matrix (array) of numerical values." .

edam:format_3097 a owl:Class ;
    rdfs:label "edam:format_3097" ;
    dcterms:title "Protein domain classification format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of data concerning the classification of the sequences and/or structures of protein structural domain(s)." .

edam:format_3098 a owl:Class ;
    rdfs:label "edam:format_3098" ;
    dcterms:title "Raw SCOP domain classification format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of raw SCOP domain classification data files." .

edam:format_3099 a owl:Class ;
    rdfs:label "edam:format_3099" ;
    dcterms:title "Raw CATH domain classification format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of raw CATH domain classification data files." .

edam:format_3100 a owl:Class ;
    rdfs:label "edam:format_3100" ;
    dcterms:title "CATH domain report format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of summary of domain classification information for a CATH domain." .

edam:format_3155 a owl:Class ;
    rdfs:label "edam:format_3155" ;
    dcterms:title "SBRML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Systems Biology Result Markup Language (SBRML), the standard XML format for simulated or calculated results (e.g. trajectories) of systems biology models." .

edam:format_3156 a owl:Class ;
    rdfs:label "edam:format_3156" ;
    dcterms:title "BioPAX" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "BioPAX is an exchange format for pathway data, with its data model defined in OWL." .

edam:format_3157 a owl:Class ;
    rdfs:label "edam:format_3157" ;
    dcterms:title "EBI Application Result XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "EBI Application Result XML is a format returned by sequence similarity search Web services at EBI." .

edam:format_3158 a owl:Class ;
    rdfs:label "edam:format_3158" ;
    dcterms:title "PSI MI XML (MIF)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML Molecular Interaction Format (MIF), standardised by HUPO PSI MI." .

edam:format_3159 a owl:Class ;
    rdfs:label "edam:format_3159" ;
    dcterms:title "phyloXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "phyloXML is a standardised XML format for phylogenetic trees, networks, and associated data." .

edam:format_3160 a owl:Class ;
    rdfs:label "edam:format_3160" ;
    dcterms:title "NeXML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "NeXML is a standardised XML format for rich phyloinformatic data." .

edam:format_3161 a owl:Class ;
    rdfs:label "edam:format_3161" ;
    dcterms:title "MAGE-ML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MAGE-ML XML format for microarray expression data, standardised by MGED (now FGED)." .

edam:format_3162 a owl:Class ;
    rdfs:label "edam:format_3162" ;
    dcterms:title "MAGE-TAB" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "MAGE-TAB textual format for microarray expression data, standardised by MGED (now FGED)." .

edam:format_3163 a owl:Class ;
    rdfs:label "edam:format_3163" ;
    dcterms:title "GCDML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GCDML XML format for genome and metagenome metadata according to MIGS/MIMS/MIMARKS information standards, standardised by the Genomic Standards Consortium (GSC)." .

edam:format_3164 a owl:Class ;
    rdfs:label "edam:format_3164" ;
    dcterms:title "GTrack" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GTrack is a generic and optimised tabular format for genome or sequence feature tracks. GTrack unifies the power of other track formats (e.g. GFF3, BED, WIG), and while optimised in size, adds more flexibility, customisation, and automation (\"machine understandability\")." .

edam:format_3166 a owl:Class ;
    rdfs:label "edam:format_3166" ;
    dcterms:title "Biological pathway or network report format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for a report of information derived from a biological pathway or network." .

edam:format_3167 a owl:Class ;
    rdfs:label "edam:format_3167" ;
    dcterms:title "Experiment annotation format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for annotation on a laboratory experiment." .

edam:format_3235 a owl:Class ;
    rdfs:label "edam:format_3235" ;
    dcterms:title "Cytoband format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Cytoband format for chromosome cytobands." .

edam:format_3239 a owl:Class ;
    rdfs:label "edam:format_3239" ;
    dcterms:title "CopasiML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "CopasiML, the native format of COPASI." .

edam:format_3240 a owl:Class ;
    rdfs:label "edam:format_3240" ;
    dcterms:title "CellML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "CellML, the format for mathematical models of biological and other networks." .

edam:format_3242 a owl:Class ;
    rdfs:label "edam:format_3242" ;
    dcterms:title "PSI MI TAB (MITAB)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Tabular Molecular Interaction format (MITAB), standardised by HUPO PSI MI." .

edam:format_3243 a owl:Class ;
    rdfs:label "edam:format_3243" ;
    dcterms:title "PSI-PAR" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Protein affinity format (PSI-PAR), standardised by HUPO PSI MI. It is compatible with PSI MI XML (MIF) and uses the same XML Schema." .

edam:format_3244 a owl:Class ;
    rdfs:label "edam:format_3244" ;
    dcterms:title "mzML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzML format for raw spectrometer output data, standardised by HUPO PSI MSS." .

edam:format_3245 a owl:Class ;
    rdfs:label "edam:format_3245" ;
    dcterms:title "Mass spectrometry data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for mass pectra and derived data, include peptide sequences etc." .

edam:format_3246 a owl:Class ;
    rdfs:label "edam:format_3246" ;
    dcterms:title "TraML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "TraML (Transition Markup Language) is the format for mass spectrometry transitions, standardised by HUPO PSI MSS." .

edam:format_3247 a owl:Class ;
    rdfs:label "edam:format_3247" ;
    dcterms:title "mzIdentML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzIdentML is the exchange format for peptides and proteins identified from mass spectra, standardised by HUPO PSI PI. It can be used for outputs of proteomics search engines." .

edam:format_3248 a owl:Class ;
    rdfs:label "edam:format_3248" ;
    dcterms:title "mzQuantML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "mzQuantML is the format for quantitation values associated with peptides, proteins and small molecules from mass spectra, standardised by HUPO PSI PI. It can be used for outputs of quantitation software for proteomics." .

edam:format_3249 a owl:Class ;
    rdfs:label "edam:format_3249" ;
    dcterms:title "GelML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "GelML is the format for describing the process of gel electrophoresis, standardised by HUPO PSI PS." .

edam:format_3250 a owl:Class ;
    rdfs:label "edam:format_3250" ;
    dcterms:title "spML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "spML is the format for describing proteomics sample processing, other than using gels, prior to mass spectrometric protein identification, standardised by HUPO PSI PS. It may also be applicable for metabolomics." .

edam:format_3252 a owl:Class ;
    rdfs:label "edam:format_3252" ;
    dcterms:title "OWL Functional Syntax" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A human-readable encoding for the Web Ontology Language (OWL)." .

edam:format_3253 a owl:Class ;
    rdfs:label "edam:format_3253" ;
    dcterms:title "Manchester OWL Syntax" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A syntax for writing OWL class expressions." .

edam:format_3254 a owl:Class ;
    rdfs:label "edam:format_3254" ;
    dcterms:title "KRSS2 Syntax" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A superset of the \"Description-Logic Knowledge Representation System Specification from the KRSS Group of the ARPA Knowledge Sharing Effort\"." .

edam:format_3255 a owl:Class ;
    rdfs:label "edam:format_3255" ;
    dcterms:title "Turtle" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The Terse RDF Triple Language (Turtle) is a human-friendly serialisation format for RDF (Resource Description Framework) graphs." .

edam:format_3256 a owl:Class ;
    rdfs:label "edam:format_3256" ;
    dcterms:title "N-Triples" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A plain text serialisation format for RDF (Resource Description Framework) graphs, and a subset of the Turtle (Terse RDF Triple Language) format." .

edam:format_3257 a owl:Class ;
    rdfs:label "edam:format_3257" ;
    dcterms:title "Notation3" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A shorthand non-XML serialisation of Resource Description Framework model, designed with human-readability in mind." .

edam:format_3261 a owl:Class ;
    rdfs:label "edam:format_3261" ;
    dcterms:title "RDF/XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Resource Description Framework (RDF) XML format." .

edam:format_3262 a owl:Class ;
    rdfs:label "edam:format_3262" ;
    dcterms:title "OWL/XML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "OWL ontology XML serialisation format." .

edam:format_3281 a owl:Class ;
    rdfs:label "edam:format_3281" ;
    dcterms:title "A2M" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The A2M format is used as the primary format for multiple alignments of protein or nucleic-acid sequences in the SAM suite of tools. It is a small modification of FASTA format for sequences and is compatible with most tools that read FASTA." .

edam:format_3284 a owl:Class ;
    rdfs:label "edam:format_3284" ;
    dcterms:title "SFF" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Standard flowgram format (SFF) is a binary file format used to encode results of pyrosequencing from the 454 Life Sciences platform for high-throughput sequencing." .

edam:format_3285 a owl:Class ;
    rdfs:label "edam:format_3285" ;
    dcterms:title "MAP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The MAP file describes SNPs and is used by the Plink package." .

edam:format_3286 a owl:Class ;
    rdfs:label "edam:format_3286" ;
    dcterms:title "PED" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The PED file describes individuals and genetic data and is used by the Plink package." .

edam:format_3287 a owl:Class ;
    rdfs:label "edam:format_3287" ;
    dcterms:title "Individual genetic data format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Data format for a metadata on an individual and their genetic data." .

edam:format_3288 a owl:Class ;
    rdfs:label "edam:format_3288" ;
    dcterms:title "PED/MAP" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "The PED/MAP file describes data used by the Plink package." .

edam:format_3309 a owl:Class ;
    rdfs:label "edam:format_3309" ;
    dcterms:title "CT" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "File format of a CT (Connectivity Table) file from the RNAstructure package." .

edam:format_3310 a owl:Class ;
    rdfs:label "edam:format_3310" ;
    dcterms:title "SS" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XRNA old input style format." .

edam:format_3311 a owl:Class ;
    rdfs:label "edam:format_3311" ;
    dcterms:title "RNAML" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "RNA Markup Language." .

edam:format_3312 a owl:Class ;
    rdfs:label "edam:format_3312" ;
    dcterms:title "GDE" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format for the Genetic Data Environment (GDE)." .

edam:format_3313 a owl:Class ;
