    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept acr_harmonized_data_model:EnumSite ) ] cam:Concept ) ] ;
    skos:definition "The location of the specimen collection." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:size a owl:DatatypeProperty ;
    rdfs:label "size" ;
    dcterms:title "File Size" ;
    rdfs:range xsd:integer ;
    skos:definition "Size of the file, in Bytes. May require BigInt or similar." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:spatial_qualifier a owl:ObjectProperty ;
    rdfs:label "spatial_qualifier" ;
    dcterms:title "Spatial Qualifier" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cam:Concept <http://hl7.org/fhir/us/mcode/ValueSet/mcode-body-location-qualifier-vs> ) ] cam:Concept ) ] ;
    skos:definition "Qualifier that further refine the specific location of biospecimen collection" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:storage_class a owl:DatatypeProperty ;
    rdfs:label "storage_class" ;
    dcterms:title "Storage Class" ;
    rdfs:range xsd:string ;
    skos:definition "Storage class of the object, reflecting cost and access characteristics." ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:study_code a owl:DatatypeProperty ;
    rdfs:label "study_code" ;
    dcterms:title "Study Code" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for the study (generally a short acronym)" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:study_description a owl:DatatypeProperty ;
    rdfs:label "study_description" ;
    dcterms:title "Study Description" ;
    rdfs:range xsd:string ;
    skos:definition "Brief description of the study (2-4 sentences)" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:study_short_name a owl:DatatypeProperty ;
    rdfs:label "study_short_name" ;
    dcterms:title "Study Code" ;
    rdfs:range xsd:string ;
    skos:definition "Short name for the study" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:study_title a owl:DatatypeProperty ;
    rdfs:label "study_title" ;
    rdfs:range xsd:string ;
    skos:definition "Full Study Title" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

cam:subject_type a owl:ObjectProperty ;
    rdfs:label "subject_type" ;
    dcterms:title "Subject Type" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( acr_harmonized_data_model:EnumSubjectType acr_harmonized_data_model:EnumUnknownOther ) ] cam:Concept ) ] ;
