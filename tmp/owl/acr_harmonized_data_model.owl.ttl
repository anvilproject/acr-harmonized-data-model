    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format for molecular sequence alignment information." .

edam:format_2556 a owl:Class ;
    rdfs:label "edam:format_2556" ;
    dcterms:title "Phylogenetic tree format (text)" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
