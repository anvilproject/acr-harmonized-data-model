    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:spatial_qualifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cam:biospecimen_collection_id ],
        [ a owl:Restriction ;
