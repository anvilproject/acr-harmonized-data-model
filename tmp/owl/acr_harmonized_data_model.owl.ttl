            owl:allValuesFrom cam:Encounter ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:laterality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:laterality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom cam:Record ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:encounter_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cam:site ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:method ],
        [ a owl:Restriction ;
            owl:allValuesFrom acr_harmonized_data_model:EnumSampleCollectionMethod ;
            owl:onProperty cam:method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cam:spatial_qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cam:biospecimen_collection_id ],
