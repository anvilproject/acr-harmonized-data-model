edam:data_1527 a owl:Class ;
    rdfs:label "edam:data_1527" ;
    dcterms:title "Protein titration curve" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMDataTypes,
        linkml:PermissibleValue ;
