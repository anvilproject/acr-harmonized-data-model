acr_harmonized_data_model:EnumParticipantLifespanStage a owl:Class ;
    rdfs:label "EnumParticipantLifespanStage" ;
    dcterms:title "Participant Lifespan Stage" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:definition "Stages of life during which participants may be recruited. From NICHD Pediatric Terminology. https://evs.nci.nih.gov/ftp1/Pediatric_Terminologies/NICHD/About.html" ;
    skos:inScheme <https://includedcc.org/common-access-model> .

<https://w3id.org/anvilproject/acr-harmonized-data-model/EnumProgram#https%3A%2F%2Fcommonfund.nih.gov%2FKidsFirst> a owl:Class ;
    rdfs:label "https://commonfund.nih.gov/KidsFirst" ;
    dcterms:title "Kids First" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumProgram,
        linkml:PermissibleValue ;
    skos:altLabel "kf" ;
    skos:definition "The goal of the Gabriella Miller Kids First Pediatric Research Program (Kids First) is to help researchers uncover new insights into the biology of childhood cancer and congenital anomalies, including the discovery of shared genetic pathways between these disorders. Children with birth defects have an increased risk of developing childhood cancer. This suggests there are shared genetic pathways underlying some types of childhood cancer and congenital anomalies." .

<https://w3id.org/anvilproject/acr-harmonized-data-model/EnumProgram#https%3A%2F%2Fwww.nih.gov%2Finclude-project> a owl:Class ;
    rdfs:label "https://www.nih.gov/include-project" ;
    dcterms:title "INCLUDE" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumProgram,
        linkml:PermissibleValue ;
    skos:altLabel "include" ;
    skos:definition "The INCLUDE (INvestigation of Co-occurring conditions across the Lifespan to Understand Down syndromE) Project was launched in June 2018 in support of a Congressional directive in the fiscal year (FY) 2018 Omnibus Appropriations. The directive called for a new trans-NIH research initiative on critical health and quality-of-life needs for individuals with Down syndrome." .

