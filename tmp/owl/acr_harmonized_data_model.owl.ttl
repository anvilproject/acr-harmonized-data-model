    rdfs:label "OBI:0002018" ;
    dcterms:title "transcription factor binding site identification by ChIP-chip assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription factor binding site assay that utilizes ChIP-chip technology." .

OBI:0002019 a owl:Class ;
    rdfs:label "OBI:0002019" ;
    dcterms:title "transcription factor binding site identification by ChIP-Seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription factor binding site assay that utilizes ChIP-seq technology." .

OBI:0002020 a owl:Class ;
    rdfs:label "OBI:0002020" ;
    dcterms:title "epigenetic modification assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies epigenetic modifications including histone modifications, open chromatin, and DNA methylation." .

OBI:0002029 a owl:Class ;
    rdfs:label "OBI:0002029" ;
    dcterms:title "serial analysis of gene expression assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that quantifies RNA through creating short signature tags of the messages and ligating them into a larger molecule that is then sequenced." .

OBI:0002030 a owl:Class ;
    rdfs:label "OBI:0002030" ;
    dcterms:title "genotyping by tiling array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping by array assay that uses tiling array technology." .

OBI:0002031 a owl:Class ;
    rdfs:label "OBI:0002031" ;
    dcterms:title "genotyping by SNP array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping by array assay that uses SNP array technology." .

OBI:0002032 a owl:Class ;
    rdfs:label "OBI:0002032" ;
    dcterms:title "parallel analysis of RNA structure assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-nucleotide-resolution nucleic acid structure mapping assay that performs simultaneous in vitro profiling of the secondary structure of thousands of RNA species at single nucleotide resolution using enzymatic probing based on deep sequencing fragments of RNAs that were treated with structure-specific enzymes" .

OBI:0002033 a owl:Class ;
    rdfs:label "OBI:0002033" ;
    dcterms:title "translation-associated transcript leader sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A translation profiling assay that combines transcript leader sequencing with polysome fractionation. TATL-seq works by applying TL-seq across fractions of a polysome gradient, generating TL-specific translational measurements to identify how different transcript leader sequences effect translation." .

OBI:0002034 a owl:Class ;
    rdfs:label "OBI:0002034" ;
    dcterms:title "transcript leader sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that combines enzymatic capture of m(7)G-capped mRNA 5' ends with high-throughput sequencing." .

OBI:0002035 a owl:Class ;
    rdfs:label "OBI:0002035" ;
    dcterms:title "peptide mass fingerprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A mass spectrometry assay that measures the absolute mass of the cleaved peptides derived from an unknown protein of interest. These masses are then compared to values for known protein sequences to identify the unknown protein." .

OBI:0002036 a owl:Class ;
    rdfs:label "OBI:0002036" ;
    dcterms:title "array based nucleic acid structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay which aims to provide information about the in vivo organization/structure of nucleic acids using chemical or enzymatic probes using a microarray." .

OBI:0002037 a owl:Class ;
    rdfs:label "OBI:0002037" ;
    dcterms:title "micrococcal nuclease digestion followed by tiling array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An array based nucleic acid structure mapping assay that identifies nucleosome positions genome wide, by detection of regions protected by nucleosomes from digestion by micrococal nuclease using tiling array assays" .

OBI:0002038 a owl:Class ;
    rdfs:label "OBI:0002038" ;
    dcterms:title "ribosomal profiling by sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A translation profiling assay that sequences only mRNA protected by the ribosome during translation and thus provides information on which transcipts are undergoing active translation." .

OBI:0002039 a owl:Class ;
    rdfs:label "OBI:0002039" ;
    dcterms:title "assay for transposase-accessible chromatin using sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to capture the location of open chromatin, DNA-binding proteins, individual nucleosomes and chromatin compaction at nucleotide resolution by Tn5 transposase insertion." .

OBI:0002040 a owl:Class ;
    rdfs:label "OBI:0002040" ;
    dcterms:title "chromatin isolation by RNA purification sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A detection of specific nucleic acids with complementary probes assay that measures regions of the genome which are bound by a specific RNA (or a by a ribonucleoprotein containing the RNA of interest) using high-throughput sequencing." .

OBI:0002041 a owl:Class ;
    rdfs:label "OBI:0002041" ;
    dcterms:title "self-transcribing active regulatory region sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies the sequences that act as transcriptional enhancers in a direct, quantitative, and genome-wide manner from sheared genomic DNA." .

OBI:0002042 a owl:Class ;
    rdfs:label "OBI:0002042" ;
    dcterms:title "carbon-copy chromosome conformation capture assay followed by sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A carbon-copy chromosome conformation capture assay to analyze the organization of chromosomes in an unbiased, genome-wide manner using high throughput sequening following carbon-copy chromosome conformation capture." .

OBI:0002043 a owl:Class ;
    rdfs:label "OBI:0002043" ;
    dcterms:title "individual-nucleotide resolution cross-linking and immunoprecipitation sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cross-linking immunoprecipitation high-throughput sequencing assay that identifies protein-RNA interactions using UV light to covalently bind proteins and RNA molecules, allowing for a very stringent purification of the linked protein-RNA complexes." .

OBI:0002044 a owl:Class ;
    rdfs:label "OBI:0002044" ;
    dcterms:title "RNA Bind-n-Seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that comprehensively characterizes sequence and structural specificity of RNA binding proteins (RBPs)." .

OBI:0002045 a owl:Class ;
    rdfs:label "OBI:0002045" ;
    dcterms:title "polyA-site sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that quantitatively profiles RNA polyadenylation at the transcriptome level." .

OBI:0002050 a owl:Class ;
    rdfs:label "OBI:0002050" ;
    dcterms:title "3D molecular structure determination assay of a MHC:ligand complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D structure determination of bound molecular complex assay that characterizes the 3-dimensional structure of a MHC:ligand complex." .

OBI:0002051 a owl:Class ;
    rdfs:label "OBI:0002051" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection from infectious challenge based on pathogen burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring B cell epitope specific protection from pathogen challenge using pathogen burden." .

OBI:0002052 a owl:Class ;
    rdfs:label "OBI:0002052" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection after tumor burden challenge" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring B cell epitope specific protection from tumor challenge using tumor burden." .

OBI:0002053 a owl:Class ;
    rdfs:label "OBI:0002053" ;
    dcterms:title "microarray assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A microarray assay that detects the binding of an antigen with an antibody." .

OBI:0002054 a owl:Class ;
    rdfs:label "OBI:0002054" ;
    dcterms:title "NMR assay measuring the dissociation constant [KD] of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope equilibrium dissociation constant (KD) determination assay that uses a nuclear magnetic resonance assay." .

OBI:0002055 a owl:Class ;
    rdfs:label "OBI:0002055" ;
    dcterms:title "assay measuring biological activity resulting from T cell epitope:MHC:TCR binding" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope recognition assay that measures the immune response process resulting from the binding of a T cell receptor to epitope or the recongition of the epitope." .

OBI:0002056 a owl:Class ;
    rdfs:label "OBI:0002056" ;
    dcterms:title "assay measuring epitope specific chemokine (C-C motif) ligand 17 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects production of chemokine (C-C motif) ligand 17 production by T cells." .

OBI:0002057 a owl:Class ;
    rdfs:label "OBI:0002057" ;
    dcterms:title "assay measuring epitope specific macrophage migration inhibitory factor (MIF) production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects macrophage migration inhibitory factor (MIF) production by T cells." .

OBI:0002058 a owl:Class ;
    rdfs:label "OBI:0002058" ;
    dcterms:title "assay measuring epitope specific oncostatin M production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects oncostatin M production by T cells." .

OBI:0002059 a owl:Class ;
    rdfs:label "OBI:0002059" ;
    dcterms:title "assay measuring a binding constant of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope recognition assay that quantitavely characterizes the binding of a TCR with a ligand by determining a binding constant." .

OBI:0002060 a owl:Class ;
    rdfs:label "OBI:0002060" ;
    dcterms:title "detection of specific nucleic acids with complementary probes assay measuring epitope specific chemokine (C-C motif) ligand 17 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A detection of specific nucleic acid polymers with complementary probes that detects chemokine (C-C motif) ligand 17 production by T cells." .

OBI:0002061 a owl:Class ;
    rdfs:label "OBI:0002061" ;
    dcterms:title "cytometric bead array assay measuring epitope specific chemokine (C-C motif) ligand 22 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects chemokine (C-C motif) ligand 22 production by T cells." .

OBI:0002062 a owl:Class ;
    rdfs:label "OBI:0002062" ;
    dcterms:title "in vitro assay measuring epitope specific T cell killing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vitro cell killing assay that measures the killing of antigen presenting cells (APC) by T cells whose TCR recognizes an epitope presented by the APC." .

OBI:0002063 a owl:Class ;
    rdfs:label "OBI:0002063" ;
    dcterms:title "cytometric bead array assay measuring epitope specific granzyme A release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects epitope specific granzyme A release by T cells." .

OBI:0002064 a owl:Class ;
    rdfs:label "OBI:0002064" ;
    dcterms:title "detection of specific nucleic acids with complementary probes assay measuring epitope specific granzyme A release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A detection of specific nucleic acids with complementary probes assay that detects epitope specific granzyme A release by T cells." .

OBI:0002065 a owl:Class ;
    rdfs:label "OBI:0002065" ;
    dcterms:title "cytometric bead array assay measuring epitope specific granzyme B release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects epitope specific granzyme B release by T cells." .

OBI:0002066 a owl:Class ;
    rdfs:label "OBI:0002066" ;
    dcterms:title "detection of specific nucleic acids with complementary probes assay measuring epitope specific granzyme B release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A detection of specific nucleic acids with complementary probes assay that detects epitope specific granzyme B release by T cells" .

OBI:0002067 a owl:Class ;
    rdfs:label "OBI:0002067" ;
    dcterms:title "cytometric bead array assay measuring epitope specific macrophage migration inhibitory factor (MIF) production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects macrophage migration inhibitory factor (MIF) production by T cells." .

OBI:0002068 a owl:Class ;
    rdfs:label "OBI:0002068" ;
    dcterms:title "cytometric bead array assay measuring epitope specific oncostatin M production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects oncostatin M production by T cells." .

OBI:0002069 a owl:Class ;
    rdfs:label "OBI:0002069" ;
    dcterms:title "ELISPOT assay measuring epitope specific perforin release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzyme-linked immunospot assay that detects epitope specific perforin release by T cells." .

OBI:0002070 a owl:Class ;
    rdfs:label "OBI:0002070" ;
    dcterms:title "in vivo assay measuring epitope specific proliferation of T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific proliferation assay that is performed in vivo." .

OBI:0002071 a owl:Class ;
    rdfs:label "OBI:0002071" ;
    dcterms:title "in vitro assay measuring epitope specific proliferation of T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific proliferation assay that is performed on cells in vitro." .

OBI:0002072 a owl:Class ;
    rdfs:label "OBI:0002072" ;
    dcterms:title "assay measuring qualitative binding of a MHC:ligand complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the binding of a MHC molecule with a ligand, and produces a qualitative measurement of the binding as an output." .

OBI:0002073 a owl:Class ;
    rdfs:label "OBI:0002073" ;
    dcterms:title "in vivo assay measuring T cell epitope specific protection from challenge" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that uses a epitope protection experiment." .

OBI:0002074 a owl:Class ;
    rdfs:label "OBI:0002074" ;
    dcterms:title "assay measuring T cell epitope specific suppression in vitro" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "T cell epitope dependent biological activity assay that detects suppression of an in vitro response." .

OBI:0002075 a owl:Class ;
    rdfs:label "OBI:0002075" ;
    dcterms:title "MHC ligand assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An immune epitope assay that characterizes the structrue of a MHC-ligand complex, or detects the processing and presentation of a ligand by an antigen presenting cell, or the binding of a ligand to an MHC molecule." .

OBI:0002082 a owl:Class ;
    rdfs:label "OBI:0002082" ;
    dcterms:title "reporter gene assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects expression of a reporter gene that was inserted under the control of a regulatory sequence of interest." .

OBI:0002083 a owl:Class ;
    rdfs:label "OBI:0002083" ;
    dcterms:title "enhancer activity detection by reporter gene assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A reporter gene assay that detects expression of a reporter gene that was inserted under the control of an enhancer of interest." .

OBI:0002084 a owl:Class ;
    rdfs:label "OBI:0002084" ;
    dcterms:title "transcription cofactor activity region identification by ChIP-Seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A ChIP-seq assay that identifies regions of chromatin bound to a chromatin modifying protein, e.g. a histone acetyltransferase." .

OBI:0002085 a owl:Class ;
    rdfs:label "OBI:0002085" ;
    dcterms:title "transcript expression location detection by hybridization chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in situ hybridization assay in which the location (e.g. anatomical/tissue) of a transcript is detected by a multiplexed fluorescent in situ hybridization, based on orthogonal amplification with hybridization chain reactions (HCR). RNA probes complementary to mRNA targets trigger chain reactions in which fluorophore-labeled RNA hairpins self-assemble into tethered fluorescent amplification polymers." .

OBI:0002086 a owl:Class ;
    rdfs:label "OBI:0002086" ;
    dcterms:title "Tet-assisted bisulfite sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bisulfite sequencing assay that identifies genomic methylation patterns by using a bisulfite based protocol with the Tet enzyme to differentiate 5-hydroxylmethylcytosine (5hmC) from 5-methylcytosine (5mC) through a step-wise oxidative demethylation of 5mC, converting it to 5-carboxylcytosine (5caC) while keeping 5hmC protected." .

OBI:0002094 a owl:Class ;
    rdfs:label "OBI:0002094" ;
    dcterms:title "MethylC-Capture sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bisulfite sequencing assay in which a whole-genome sequencing library is prepared, bisulfite converted and amplified, followed by a capture enriching for targeted bisulfite-converted DNA fragments that are are subsequently identified by DNA sequencing." .

OBI:0002096 a owl:Class ;
    rdfs:label "OBI:0002096" ;
    dcterms:title "carboxyfluorescein succinimidyl ester staining assay measuring epitope specific proliferation of T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A CFSE assay that detects T cell epitope specific proliferation in vitro." .

OBI:0002097 a owl:Class ;
    rdfs:label "OBI:0002097" ;
    dcterms:title "assay measuring the dissociation constant [KD] of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope binding constant determination assay that measures the dissociation constant KD." .

OBI:0002098 a owl:Class ;
    rdfs:label "OBI:0002098" ;
    dcterms:title "assay measuring the on rate [kon] of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope binding constant determination assay that measures the on rate." .

OBI:0002099 a owl:Class ;
    rdfs:label "OBI:0002099" ;
    dcterms:title "assay measuring the off rate [koff] of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope binding constant determination assay that measures the off rate." .

OBI:0002100 a owl:Class ;
    rdfs:label "OBI:0002100" ;
    dcterms:title "assay measuring the association constant [KA] of a T cell epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope binding constant determination assay that measures the association constant KA." .

OBI:0002101 a owl:Class ;
    rdfs:label "OBI:0002101" ;
    dcterms:title "small-angle scattering assay determining the 3D structure of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A small-angle scattering 3D molecular structure determination assay that characterizes the 3-dimensional molecular structure of a B cell epitope:antibody complex" .

OBI:0002102 a owl:Class ;
    rdfs:label "OBI:0002102" ;
    dcterms:title "bio-layer interferometry assay measuring the on rate [kon] of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bio-layer interferometry assay that measures the on rate of an antigen with an antibody." .

OBI:0002103 a owl:Class ;
    rdfs:label "OBI:0002103" ;
    dcterms:title "bio-layer interferometry assay measuring the off rate [koff] of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bio-layer interferometry assay that measures the off rate of an antigen with an antibody." .

OBI:0002104 a owl:Class ;
    rdfs:label "OBI:0002104" ;
    dcterms:title "bio-layer interferometry assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bio-layer interferometry assay that detects the binding of an antigen with an antibody." .

OBI:0002105 a owl:Class ;
    rdfs:label "OBI:0002105" ;
    dcterms:title "bio-layer interferometry assay measuring the dissociation constant [KD] of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bio-layer interferometry assay that measures the dissociation constant [KD] of an antigen with an antibody." .

OBI:0002106 a owl:Class ;
    rdfs:label "OBI:0002106" ;
    dcterms:title "carboxyfluorescein succinimidyl ester staining assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay using carboxyfluorescein succinimidyl ester staining." .

OBI:0002107 a owl:Class ;
    rdfs:label "OBI:0002107" ;
    dcterms:title "bio-layer interferometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay that detects a shift in the interference pattern reflected from a layer of immobilized material on the biosensor tip to measure binding to- or dissociating from the material on the biosensor." .

OBI:0002108 a owl:Class ;
    rdfs:label "OBI:0002108" ;
    dcterms:title "small-angle scattering 3D molecular structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D molecular structure determination assay in which the scattering pattern of a neutron or x-ray beam targeted at a material entity is recorded at small angles relative to the incident beam to determine the size, shape and structure of the material entity examined." .

OBI:0002111 a owl:Class ;
    rdfs:label "OBI:0002111" ;
    dcterms:title "enhanced cross-linking immunoprecipitation high-throughput sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An iCLIP assay that is enhanced to robustly identify protein-RNA interactions with high efficiency through improvements in library preparation of RNA fragments." .

OBI:0002112 a owl:Class ;
    rdfs:label "OBI:0002112" ;
    dcterms:title "small RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay which is targeting small RNA (< 200 bp) sequences such as, but not exclusive to, miRNAs using, for example, small RNA library preparation kits." .

OBI:0002113 a owl:Class ;
    rdfs:label "OBI:0002113" ;
    dcterms:title "bromouridine labeling and sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay used to identify spans of nascent transcription in the genome through isolation of recent bromouridine (Bru) labelled RNAs." .

OBI:0002114 a owl:Class ;
    rdfs:label "OBI:0002114" ;
    dcterms:title "bromouridine pulse-chase and sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay used to identify RNA populations of specific ages through isolation of RNAs first labelled with bromouridine (Bru) followed by chasing in uridine for different periods of time." .

OBI:0002115 a owl:Class ;
    rdfs:label "OBI:0002115" ;
    dcterms:title "cytometry time of flight assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay in which the presence of molecules of interest on or in cells is indicated by binding of antibodies labeled with rare earth element tags which are detected by time-of-flight mass spectrometry." .

OBI:0002116 a owl:Class ;
    rdfs:label "OBI:0002116" ;
    dcterms:title "high performance liquid chromatography assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analytical chromatography assay that utilizes a high performance liquid chromatography instrument for separation of compounts in a solution." .

OBI:0002117 a owl:Class ;
    rdfs:label "OBI:0002117" ;
    dcterms:title "whole genome sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that intends to provide information about the sequence of an entire genome of an organism." .

OBI:0002118 a owl:Class ;
    rdfs:label "OBI:0002118" ;
    dcterms:title "exome sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that intends to provide information about the sequence of the protein coding components of a genome (exons)." .

OBI:0002119 a owl:Class ;
    rdfs:label "OBI:0002119" ;
    dcterms:title "microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay that utilizes a microscope to magnify features of the visualized material of interest that are not visible to naked eye." .

OBI:0002120 a owl:Class ;
    rdfs:label "OBI:0002120" ;
    dcterms:title "mixed lymphocyte reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay where lymphocytes from two individuals are co-cultured with the lymphocytes from one of the allogeneic individuals (Responders) being labeled (with 3H Thymidine or BrdU) and the proliferation of the labeled cells is measured, which is thought to reflect recognition of histocompatibility antigens on the unlabeled cells (stimulators)." .

OBI:0002121 a owl:Class ;
    rdfs:label "OBI:0002121" ;
    dcterms:title "killer cell immunoglobulin-like receptor typing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping assay in which the alleles of genes encoding for killer cell immunoglobulin-like receptors are determined." .

OBI:0002122 a owl:Class ;
    rdfs:label "OBI:0002122" ;
    dcterms:title "major histocompatibility typing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping assay in which the alleles of genes encoding for major histocompatibility complex molecules are determined." .

OBI:0002132 a owl:Class ;
    rdfs:label "OBI:0002132" ;
    dcterms:title "pulse stable isotope labeling by amino acids in cell culture" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects differences in protein abundance using samples that have been metabolically labeled in vivo with a stable non-radioactive heavy isotope containing amino acid for a short period of time. After diluting the pulsed cells into growth media without label, high resolution mass spectrometry-based proteomics is used to analyze the time-dependent decay and determine protein stability." .

OBI:0002133 a owl:Class ;
    rdfs:label "OBI:0002133" ;
    dcterms:title "cytometric bead array assay measuring  epitope specific chemokine (C-C motif) ligand 20 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects chemokine (C-C motif) ligand 20 production by T cells." .

OBI:0002134 a owl:Class ;
    rdfs:label "OBI:0002134" ;
    dcterms:title "assay measuring epitope specific chemokine (C-C motif) ligand 20 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects chemokine (C-C motif) ligand 20 production by T cells." .

OBI:0002140 a owl:Class ;
    rdfs:label "OBI:0002140" ;
    dcterms:title "temperature measurement assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to determine the temperature of an evaluant." .

OBI:0002141 a owl:Class ;
    rdfs:label "OBI:0002141" ;
    dcterms:title "volume measurement assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to determine the volume of an evaluant." .

OBI:0002142 a owl:Class ;
    rdfs:label "OBI:0002142" ;
    dcterms:title "Nanostring nCounter miRNA expression assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A microRNA profiling assay using digital molecular barcoding technology to quantify target microRNA molecules without the need for amplification." .

OBI:0002143 a owl:Class ;
    rdfs:label "OBI:0002143" ;
    dcterms:title "bromouride labeling and sequencing after UV exposure" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay used to identify transcription start sites and active enhancer elements through isolation of bromouridine (Bru) labelled RNAs after UV light exposure introduces transcription-blocking lesions." .

OBI:0002144 a owl:Class ;
    rdfs:label "OBI:0002144" ;
    dcterms:title "extrachromosomal circular DNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay which aims at identifying the endogenous population of extrachromosomal circular DNA originating from a subset of genomic loci and potentially having profound consequences on the regulatory and coding capabilities of these regions. The assay includes creation of a library out of the circular DNA molecules and subsequent sequencing using parallelized sequencing methods." .

OBI:0002145 a owl:Class ;
    rdfs:label "OBI:0002145" ;
    dcterms:title "antigen specific antibodies assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the presence or amount of antibodies to a specified antigen." .

OBI:0002146 a owl:Class ;
    rdfs:label "OBI:0002146" ;
    dcterms:title "HIV antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to human immunodeficiency virus (HIV) antigens." .

OBI:0002147 a owl:Class ;
    rdfs:label "OBI:0002147" ;
    dcterms:title "HIV group O antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to human immunodeficiency virus (HIV) group O antigens." .

OBI:0002148 a owl:Class ;
    rdfs:label "OBI:0002148" ;
    dcterms:title "surface HBV antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to hepatitis B virus (HBV) surface antigens." .

OBI:0002149 a owl:Class ;
    rdfs:label "OBI:0002149" ;
    dcterms:title "core HBV antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to hepatitis B virus (HBV) core antigens." .

OBI:0002150 a owl:Class ;
    rdfs:label "OBI:0002150" ;
    dcterms:title "core HBV IgM antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detectimmunoglobulin M (IgM) antibodies that bind to hepatitis B virus (HBV) core antigens." .

OBI:0002151 a owl:Class ;
    rdfs:label "OBI:0002151" ;
    dcterms:title "HCV antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to Hepacivirus C (HCV) antigens." .

OBI:0002152 a owl:Class ;
    rdfs:label "OBI:0002152" ;
    dcterms:title "EBV IgG antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect immunoglobulin G (IgG) antibodies that bind to Epstein-Barr virus (EBV) antigens." .

OBI:0002153 a owl:Class ;
    rdfs:label "OBI:0002153" ;
    dcterms:title "EBV IgM antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect immunoglobulin M (IgM) antibodies that bind to Epstein-Barr virus (EBV) antigens." .

OBI:0002154 a owl:Class ;
    rdfs:label "OBI:0002154" ;
    dcterms:title "CMV antibody assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An antigen specific antibodies assay that is meant to detect antibodies that bind to cytomegalovirus (CMV) antigens." .

OBI:0002155 a owl:Class ;
    rdfs:label "OBI:0002155" ;
    dcterms:title "venereal disease research laboratory test" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that is meant to detect general antibodies that react with substances that are produced by cellular damage caused by Treponema pallidum indicating a syphilis infection. VDRL tests require a microscope and can be done on cerebrospinal fluid as well as blood." .

OBI:0002156 a owl:Class ;
    rdfs:label "OBI:0002156" ;
    dcterms:title "rapid plasma reagin test" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that is meant to detect with the aid of carbon or charcoal particles general antibodies that react with substances that are produced by cellular damage caused by Treponema pallidum indicating a syphilis infection. RPR tests can be done without a microscope." .

OBI:0002157 a owl:Class ;
    rdfs:label "OBI:0002157" ;
    dcterms:title "HBV surface antigen assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that is meant to detect hepatitis B virus (HBV) surface antigens." .

OBI:0002158 a owl:Class ;
    rdfs:label "OBI:0002158" ;
    dcterms:title "HIV-1 nucleic acid testing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that is meant to detect human immunodeficiency virus (HIV-1) nucleic acids." .

OBI:0002159 a owl:Class ;
    rdfs:label "OBI:0002159" ;
    dcterms:title "HCV nucleic acid testing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that is meant to detect hepatitis C virus (HCV) nucleic acids." .

OBI:0002160 a owl:Class ;
    rdfs:label "OBI:0002160" ;
    dcterms:title "multiplexed indexed T7 ChIP-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A ChIP-seq assay which leverages T7 promoter amplification to allow low sample input and chromatin barcoding and pool-and-split multiplexing for high-throughput, quantitative profiling of chromatin states." .

OBI:0002161 a owl:Class ;
    rdfs:label "OBI:0002161" ;
    dcterms:title "systematic evolution of ligands by exponential enrichment assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay that identifies protein-binding sites on nucleic acids by selecting high-affinity target ligands from a randomized pool. The process is repeated in rounds, then the bound nucleic acids are separated from the unbound nucleic acids and amplified by PCR._" .

OBI:0002162 a owl:Class ;
    rdfs:label "OBI:0002162" ;
    dcterms:title "footprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures ligand binding and conformational changes by the solvent accessibility of the backbone, bases, or side-chain structures of macromolecules through their sensitivity to chemical or enzymatic cleavage or modification reactions." .

OBI:0002163 a owl:Class ;
    rdfs:label "OBI:0002163" ;
    dcterms:title "DNAse footprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzymatic footprinting assay that determines protein-binding sites on DNA by identifying bound fragments that are protected from DNAse I-catalyzed hydrolysis" .

OBI:0002164 a owl:Class ;
    rdfs:label "OBI:0002164" ;
    dcterms:title "mammalian 2-hybrid assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay that increases the expression of a reporter gene in mammalian cells by proteins of interest attached to two portions of the transcriptional activator, bringing those portions closer together." .

OBI:0002165 a owl:Class ;
    rdfs:label "OBI:0002165" ;
    dcterms:title "protein localization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the specific location of a protein. Subcellular localization is distinguished from tissue-based localization based on the type of microscopy applied." .

OBI:0002166 a owl:Class ;
    rdfs:label "OBI:0002166" ;
    dcterms:title "tissue-based protein localization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A protein localization assay that determines the specific location of a protein in a living tissue sample." .

OBI:0002167 a owl:Class ;
    rdfs:label "OBI:0002167" ;
    dcterms:title "subcellular protein localization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A protein localization assay that determines the specific subcellular location of a protein. The location is visualized through electron microscopy." .

OBI:0002168 a owl:Class ;
    rdfs:label "OBI:0002168" ;
    dcterms:title "subcellular protein immunohistochemistry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An immunohistochemistry assay that uses antibodies to display the specific subcellular location of proteins." .

OBI:0002169 a owl:Class ;
    rdfs:label "OBI:0002169" ;
    dcterms:title "ChIP-qPCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A ChIP assay that uses quantitative PCR to determine levels of specific DNA in immunoprecipitated samples." .

OBI:0002170 a owl:Class ;
    rdfs:label "OBI:0002170" ;
    dcterms:title "genomic SELEX" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A systematic evolution of ligands by exponential enrichment assay that starts with a library derived from genomic DNA instead of synthetically derived random DNA molecules." .

OBI:0002171 a owl:Class ;
    rdfs:label "OBI:0002171" ;
    dcterms:title "dot blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that detects molecules in a mixture dotted on a membrane using DNA probes or antibodies." .

OBI:0002172 a owl:Class ;
    rdfs:label "OBI:0002172" ;
    dcterms:title "Northwestern blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct binding assay that detects interactions of labeled RNA with immobilized protein on a membrane." .

OBI:0002173 a owl:Class ;
    rdfs:label "OBI:0002173" ;
    dcterms:title "Southwestern blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct binding assay that detects interactions of labeled DNA with immobilized protein on a membrane." .

OBI:0002174 a owl:Class ;
    rdfs:label "OBI:0002174" ;
    dcterms:title "immunocytochemistry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An immuno staining assay in which samples of intact cells are examined that have had most, if not all, of their surrounding extracellular matrix removed" .

OBI:0002175 a owl:Class ;
    rdfs:label "OBI:0002175" ;
    dcterms:title "ATP bioluminescence assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that detects ATP concentration through light intensity when luciferase catalyzes the oxidation of luciferin in the presence of ATP, magnesium ions, and molecular oxygen." .

OBI:0002176 a owl:Class ;
    rdfs:label "OBI:0002176" ;
    dcterms:title "electrophysiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the electrical properties of biological cells or tissues. Typically, this assay will generate measurements of voltage changes or electric current (or other associated variables such as impedence or capacitance)." .

OBI:0002177 a owl:Class ;
    rdfs:label "OBI:0002177" ;
    dcterms:title "patch clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An intracellular electrophysiology assay where a glass micropipette is sealed to the surface of the cell membrane as a recording electrode to study ion channel activity. The key distinction of this technique is the electrical resistance of the seal between the cell membrane and the pipette is of the order 10-100 gigaohms, permitting high-resolution current measurements over the cell membrane in several different standard configurations." .

OBI:0002178 a owl:Class ;
    rdfs:label "OBI:0002178" ;
    dcterms:title "whole-cell patch clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A patch-clamp assay where the electrode is left in place on the cell, as in cell-attached recordings, but the membrane patch has been perforated, providing access from the interior of the pipette to the intracellular space of the cell. Measurements made with this technique involve recording currents through multiple channels simultaneously, over the membrane of the entire cell." .

OBI:0002179 a owl:Class ;
    rdfs:label "OBI:0002179" ;
    dcterms:title "cell-attached patch clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A patch-clamp assay where the electrode is left in place on the cell, and the membrane patch has been left intact been perforated. This maintains the separation of the interior of the pipette to the intracellular space of the cell. Measurements made with this technique involve recording currents through multiple channels simultaneously, over the membrane of the entire cell." .

OBI:0002180 a owl:Class ;
    rdfs:label "OBI:0002180" ;
    dcterms:title "inside-out patch clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A patch-clamp assay where a patch of the membrane is attached to the patch pipette, detached from the rest of the cell, and the cytosolic surface of the membrane is exposed to the external media, or bath. This provides the experimenter has access to the intracellular surface of the membrane via the bath and can manipulate the environment at the intracellular surface of single ion channels. For example, channels that are activated by intracellular ligands can then be studied through a range of ligand concentrations." .

OBI:0002181 a owl:Class ;
    rdfs:label "OBI:0002181" ;
    dcterms:title "outside-out patch clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A patch-clamp assay where a patch of the membrane is attached to the patch pipette. In this configuration, the external surface of the cell membrane is exposed as the outside of the membrane patch relative to the patch electrode. An outside-out patch starts with a gigaohm seal in a whole-cell recording configuration. The electrode is slowly withdrawn from the cell, until a fragment of membrane bulges away from the cell, which detaches and reforms as a convex membrane on the end of the electrode, with the original external surface of the membrane facing outward from the electrode. This provides the experimenter with access to the extracellular surface of the membrane via the bath and can manipulate the environment at the extracellular surface of single ion channels." .

OBI:0002182 a owl:Class ;
    rdfs:label "OBI:0002182" ;
    dcterms:title "voltage clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An cellular electrophysiology assay where the membrane potential of a cell is controlled by the experimentalist. This is accomplished through a feedback mechanism where any change in membrane potential is countered by permitting electrical current to flow into or out of the cell." .

OBI:0002183 a owl:Class ;
    rdfs:label "OBI:0002183" ;
    dcterms:title "two electrode voltage clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "The two electrode voltage clamp (TEVC) method utilizes two low-resistance pipettes, one sensing voltage and the other injecting current. The microelectrodes are filled with conductive solution and inserted into the cell to artificially control membrane potential. The membrane acts as a dielectric as well as a resistor, while the fluids on either side of the membrane function as capacitors.[9] The microelectrodes compare the membrane potential against a command voltage, giving an accurate reproduction of the currents flowing across the membrane. Current readings can be used to analyze the electrical response of the cell to different applications. This technique is mainly used in the Oocyte preparation." .

OBI:0002184 a owl:Class ;
    rdfs:label "OBI:0002184" ;
    dcterms:title "cut open oocyte voltage clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "The cut-open oocyte Vaseline gap (COVG) voltage-clamp technique is designed to solve weaknesses in the two elextrode voltage clamp by maximizing the benefits of the Xenopus oocyte expression system by improving on clamp speed, signal-to-noise ratio, and ability to effectively perfuse the oocyte. In this way, it was possible to combine the most popular transient expression system, and the associated benefits of molecular cloning and site-directed mutagenesis, with the superior voltage-clamp properties of cut-open cell techniques." .

OBI:0002185 a owl:Class ;
    rdfs:label "OBI:0002185" ;
    dcterms:title "current clamp assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "The current clamp technique records the membrane potential by injecting current into a cell through the recording electrode. Unlike in the voltage clamp mode, where the membrane potential is held at a level determined by the experimenter, in \"current clamp\" mode the membrane potential is free to vary, and the amplifier records whatever voltage the cell generates on its own or as a result of stimulation. This technique is used to study how a cell responds when electric current enters a cell; this is important for instance for understanding how neurons respond to neurotransmitters that act by opening membrane ion channels." .

OBI:0002186 a owl:Class ;
    rdfs:label "OBI:0002186" ;
    dcterms:title "electroencephalography" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An extracellular electrophysiology assay where electrodes are mounted outside the brain (either on the surface of the scalp on onto the brain surface itself during surgery) to measure the electrical field over the external surface." .

OBI:0002187 a owl:Class ;
    rdfs:label "OBI:0002187" ;
    dcterms:title "single-unit recording" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An extracellular electrophysiology assay where a single microelectrode is placed in close proximity to a single neuron to measure voltage and current changes over time. This is the technicque used by Hubel and Wiesel to measure firing properties of primary visual cortex neurons in the 1950s in their original Nobel-prize winning study. A classic, old technique." .

OBI:0002188 a owl:Class ;
    rdfs:label "OBI:0002188" ;
    dcterms:title "multi-unit recording" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An extracellular electrophysiology assay where a collection of microelectrodes (often in an 'array' configuration) is placed into neural tissue to measure the distribution of voltage and current changes for a population of cells over time." .

OBI:0002189 a owl:Class ;
    rdfs:label "OBI:0002189" ;
    dcterms:title "local field potential recording" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An extracellular electrophysiology assay where a microelectrode is placed in the extracellular space of brain tissue to measure action potential and compared to an electrode either outside or inside that tissue." .

OBI:0002436 a owl:Class ;
    rdfs:label "OBI:0002436" ;
    dcterms:title "RNA interactome capture" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies RNA binding proteins by cross-linking RNA and proteins with UV light, then purifying the bound complexes by oligo(dT) capture. Finally, the complexes are analyzed by mass spectrometry." .

OBI:0002437 a owl:Class ;
    rdfs:label "OBI:0002437" ;
    dcterms:title "widefield microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A fluorescence microscopy technique where the specimen under investigation is fully bathed in light, as opposed to confocal microscopy in which only a small portion of the specimen is illuminated." .

OBI:0002438 a owl:Class ;
    rdfs:label "OBI:0002438" ;
    dcterms:title "nuclear ligation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the proximity of chromosomal DNA through the use of a ligation reaction in isolated nuclei." .

OBI:0002439 a owl:Class ;
    rdfs:label "OBI:0002439" ;
    dcterms:title "chromosome conformation capture assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A nuclear ligation assay that detects chromosomal interactions between any two genomic loci. Chromatin segments are cross-linked, cut by restriction enzymes, ligated, and finally analyzed by PCR." .

OBI:0002440 a owl:Class ;
    rdfs:label "OBI:0002440" ;
    dcterms:title "Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A chromosome conformation capture assay that detects genome-wide chromosomal interactions. High-throughput techniques are used to sequence the ligated fragments after cross-linking and cutting with restriction enzymes." .

OBI:0002441 a owl:Class ;
    rdfs:label "OBI:0002441" ;
    dcterms:title "physical examination of an organism" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that produces a description of the qualities of an organism that has not been transformed, through observation and physical, non-invasive techniques." .

OBI:0002442 a owl:Class ;
    rdfs:label "OBI:0002442" ;
    dcterms:title "hydroxyl-radical footprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A footprinting assay that uses the reaction of hydroxyl radicals with side-chain sites in molecules (proteins, DNA, etc)_ with the resultant mass shift demonstrating the site of modification, used to_ to asses the accessibility of that site." .

OBI:0002443 a owl:Class ;
    rdfs:label "OBI:0002443" ;
    dcterms:title "methidiumpropyl-EDTA-iron(II) footprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A footprinting assay that determines protein-binding sites on DNA by partial cleavage of ligand-protected DNA restriction fragments with methidium-propyl-EDTA (MPE). MPE-Fe(II) in the presence of oxygen efficiently catalyzes the non-specific clevage of DNA." .

OBI:0002445 a owl:Class ;
    rdfs:label "OBI:0002445" ;
    dcterms:title "transcription start site mapping by primer extension assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling assay in which the transcription start site for a gene is determined by identifying the 5' end of mRNA. A radio-labeled primer is annealed to a complementary mRNA sequence near the 3' end, then cDNA is synthesized until the 5' end is reached." .

OBI:0002449 a owl:Class ;
    rdfs:label "OBI:0002449" ;
    dcterms:title "footprinting assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A footprinting assay that detects the binding of an antigen with an antibody." .

OBI:0002450 a owl:Class ;
    rdfs:label "OBI:0002450" ;
    dcterms:title "hydroxyl-radical footprinting assay measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A hydroxyl-radical footprinting assay that detects the binding of an antigen with an antibody." .

OBI:0002451 a owl:Class ;
    rdfs:label "OBI:0002451" ;
    dcterms:title "ELISA measuring epitope specific interferon-alpha production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzyme-linked immunosorbent assay that detects interferon-alpha production by T cells." .

OBI:0002452 a owl:Class ;
    rdfs:label "OBI:0002452" ;
    dcterms:title "assay measuring epitope specific interferon-alpha production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific cytokine production assay that detects interferon-alpha production by T cells." .

OBI:0002457 a owl:Class ;
    rdfs:label "OBI:0002457" ;
    dcterms:title "precision nuclear run-on sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that maps the genome-wide distribution of transcriptionally-engaged Pol II at base-pair resolution by using biotin-labeled ribonucleotide triphosphate analogs (biotin-NTP) for nuclear run-on reactions, allowing the efficient affinity purification of nascent RNAs for high throughput sequencing from their 3' ends." .

OBI:0002458 a owl:Class ;
    rdfs:label "OBI:0002458" ;
    dcterms:title "chromosome conformation capture-on-chip assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A nuclear ligation assay which uses cross-linking of proteins to proteins and DNA, followed by two rounds of digestion and ligation, inverse PCR, and characterization by microarray or DNA sequencing. This enables unbiased genome-wide screens for DNA contacts made by single genomic sites of interest." .

OBI:0002459 a owl:Class ;
    rdfs:label "OBI:0002459" ;
    dcterms:title "genotype phasing by Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping assay in which carbon-copy chromosome conformation is used to detect polymorphism in DNA samples." .

OBI:0002485 a owl:Class ;
    rdfs:label "OBI:0002485" ;
    dcterms:title "transcript analysis by single-end sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay that incorporates single-end reads and sequencing technology to determine transcripts, gene structures, and gene expressions." .

OBI:0002489 a owl:Class ;
    rdfs:label "OBI:0002489" ;
    dcterms:title "differential medium assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that uses a differential medium to achieve its objective." .

OBI:0002564 a owl:Class ;
    rdfs:label "OBI:0002564" ;
    dcterms:title "histopathology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A histological assay that is intended to check for the presence or level of a specific disease." .

OBI:0002571 a owl:Class ;
    rdfs:label "OBI:0002571" ;
    dcterms:title "polyA-selected RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay to study transcriptomes through the enrichment of polyadenylated transcripts or removal of ribosomal RNA prior to high-throughput sequencing." .

OBI:0002572 a owl:Class ;
    rdfs:label "OBI:0002572" ;
    dcterms:title "polyA-depleted RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay to study non-polyadenylated transcripts, such as, but not exclusive to unspliced and circular isoforms, through the depletion of polyadenylated transcripts prior to high-throughput sequencing." .

OBI:0002575 a owl:Class ;
    rdfs:label "OBI:0002575" ;
    dcterms:title "isoform sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay for sequencing isoforms by enriching a cDNA library for full-length reads spanning entire transcript isoforms." .

OBI:0002597 a owl:Class ;
    rdfs:label "OBI:0002597" ;
    dcterms:title "chromosome conformation capture sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A chromosome conformation capture-on-chip assay quantitates the products with multiplexed high-throughput sequencing." .

OBI:0002621 a owl:Class ;
    rdfs:label "OBI:0002621" ;
    dcterms:title "reconstitution assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which a cellular process is replicated from the bottom-up using isolated components in order to observe how the components work together." .

OBI:0002622 a owl:Class ;
    rdfs:label "OBI:0002622" ;
    dcterms:title "in vitro transcription reconstitution assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A reconstitution assay in which RNA synthesis is investigated using RNA polymerase II transcription systems replicated in vitro from their base components." .

OBI:0002623 a owl:Class ;
    rdfs:label "OBI:0002623" ;
    dcterms:title "whole metagenome sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA sequencing assay that intends to provide information on the DNA sequences of multiple genomes (a metagenome) from different organisms present in the same input sample." .

OBI:0002628 a owl:Class ;
    rdfs:label "OBI:0002628" ;
    dcterms:title "RNAi knockdown assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A gene knockdown assay in which RNAi gene knockdown is used to disrupt gene transcripts." .

OBI:0002629 a owl:Class ;
    rdfs:label "OBI:0002629" ;
    dcterms:title "direct RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to study transcription through direct RNA sequence determination, without prior conversion of RNA molecules to cDNA." .

OBI:0002631 a owl:Class ;
    rdfs:label "OBI:0002631" ;
    dcterms:title "single-cell transcription profiling by RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that uses as input RNA extracts that can be traced to a single cell of origin. These extracts may come from the entire cell or only a part of the cell such as the nucleus or the cytoplasm." .

OBI:0002634 a owl:Class ;
    rdfs:label "OBI:0002634" ;
    dcterms:title "in vivo assay measuring B cell epitope specific disease exacerbation resulting from the adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that uses a disease exacerbation in vivo intervention experiment after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002635 a owl:Class ;
    rdfs:label "OBI:0002635" ;
    dcterms:title "in vivo assay measuring T cell epitope specific disease reduction resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that detects a decrease in disease after adoptive transfer of epitope specfic T cells." .

OBI:0002636 a owl:Class ;
    rdfs:label "OBI:0002636" ;
    dcterms:title "in vivo assay measuring B cell epitope specific disease reduction resulting from adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that detects a decrease in disease after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002637 a owl:Class ;
    rdfs:label "OBI:0002637" ;
    dcterms:title "in vivo assay measuring T cell epitope specific protection from challenge resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that uses a epitope protection experiment after adoptive transfer of epitope specfic T cells." .

OBI:0002638 a owl:Class ;
    rdfs:label "OBI:0002638" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection from challenge resulting from adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that uses a epitope protection experiment after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002639 a owl:Class ;
    rdfs:label "OBI:0002639" ;
    dcterms:title "in vivo assay measuring T cell epitope specific protection from challenge resulting from the adoptive transfer of epitope specific T cells based on pathogen burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring T cell epitope specific protection from pathogen challenge resulting from the adoptive transfer of epitope specific antibodies or B cells using pathogen burden." .

OBI:0002640 a owl:Class ;
    rdfs:label "OBI:0002640" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection from challenge resulting from the adoptive transfer of epitope specific antibodies or B cells based on pathogen burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring B cell epitope specific protection from pathogen challenge resulting from the adoptive transfer of epitope specific antibodies or B cells using pathogen burden." .

OBI:0002641 a owl:Class ;
    rdfs:label "OBI:0002641" ;
    dcterms:title "in vivo assay measuring T cell epitope specific protection from other challenge resulting from the adoptive transfer of epitope specific T cells based on survival" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring T cell epitope specific protection from other challenge resulting from the adoptive transfer of epitope specific T cells using survival." .

OBI:0002642 a owl:Class ;
    rdfs:label "OBI:0002642" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection from other challenge resulting from the adoptive transfer of epitope specific antibodies or B cells based on survival" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring B cell epitope specific protection from other challenge resulting from the adoptive transfer of epitope specific antibodies or B cells using survival." .

OBI:0002643 a owl:Class ;
    rdfs:label "OBI:0002643" ;
    dcterms:title "in vivo assay measuring T cell epitope specific protection from challenge resulting from the adoptive transfer of epitope specific T cells based on tumor burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring T cell epitope specific protection from tumor challenge resulting from the adoptive transfer of epitope specific T cells using tumor burden." .

OBI:0002644 a owl:Class ;
    rdfs:label "OBI:0002644" ;
    dcterms:title "in vivo assay measuring B cell epitope specific protection from challenge resulting from the adoptive transfer of epitope specific antibodies or B cells based on tumor burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo assay measuring B cell epitope specific protection from tumor challenge resulting from the adoptive transfer of epitope specific antibodies or B cells using tumor burden." .

OBI:0002645 a owl:Class ;
    rdfs:label "OBI:0002645" ;
    dcterms:title "in vivo assay measuring T cell epitope specific tolerance induction resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that uses a tolerance induction intervention experiment after adoptive transfer of epitope specfic T cells." .

OBI:0002646 a owl:Class ;
    rdfs:label "OBI:0002646" ;
    dcterms:title "in vivo assay measuring B cell epitope specific tolerance induction resulting from the adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that uses a tolerance induction intervention experiment after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002647 a owl:Class ;
    rdfs:label "OBI:0002647" ;
    dcterms:title "Giemsa stain assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses a Giemsa stain to characterize cells." .

OBI:0002649 a owl:Class ;
    rdfs:label "OBI:0002649" ;
    dcterms:title "blood microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a blood specimen." .

OBI:0002664 a owl:Class ;
    rdfs:label "OBI:0002664" ;
    dcterms:title "cytometric bead array assay measuring epitope specific interleukin-15 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects interleukin-15 production by T cells." .

OBI:0002665 a owl:Class ;
    rdfs:label "OBI:0002665" ;
    dcterms:title "cytometric bead array assay measuring epitope specific interleukin-16 production by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects interleukin-16 production by T cells." .

OBI:0002666 a owl:Class ;
    rdfs:label "OBI:0002666" ;
    dcterms:title "in vivo assay measuring B cell epitope specific induction of hypersensitivity resulting from the adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that detects a hypersensitivity response by monitoring skin reactions after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002667 a owl:Class ;
    rdfs:label "OBI:0002667" ;
    dcterms:title "in vivo skin test assay measuring T cell epitope specific type IV hypersensitivity resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that detects epitope specific type IV hypersensitivity after adoptive transfer of epitope specfic T cells." .

OBI:0002668 a owl:Class ;
    rdfs:label "OBI:0002668" ;
    dcterms:title "in vivo assay measuring epitope specific proliferation of T cells resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific proliferation assay that is performed in vivo after adoptive transfer of epitope specfic T cells." .

OBI:0002669 a owl:Class ;
    rdfs:label "OBI:0002669" ;
    dcterms:title "assay measuring epitope specific helper T cell enhancement of a B cell mediated immune response resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific helper activity assay that detects the ability of a T cell epitope to enhance an antibody response after adoptive transfer of epitope specfic T cells." .

OBI:0002670 a owl:Class ;
    rdfs:label "OBI:0002670" ;
    dcterms:title "assay measuring epitope specific helper T cell enhancement of a T cell mediated immune response resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A T cell epitope specific helper activity assay that detects the ability of a T cell epitope to enhance a T cell response after adoptive transfer of epitope specfic T cells." .

OBI:0002671 a owl:Class ;
    rdfs:label "OBI:0002671" ;
    dcterms:title "in vivo assay measuring epitope specific T cell killing resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo cell killing assay that detects the killing of an antigen presenting cell (APC) by a T cell whose TCR recognizes an epitope presented by the APC after adoptive transfer of epitope specific T cells." .

OBI:0002672 a owl:Class ;
    rdfs:label "OBI:0002672" ;
    dcterms:title "ELISA measuring epitope specific perforin release by T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An enzyme-linked immunosorbent assay that detects epitope specific perforin release by T cells." .

OBI:0002675 a owl:Class ;
    rdfs:label "OBI:0002675" ;
    dcterms:title "massively parallel reporter assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which multiplexing the construction and interrogation of larger libraries of reporter constructs allows measurement of the transcriptional regulatory activities of thousands to hundreds of thousands of DNA sequences." .

OBI:0002676 a owl:Class ;
    rdfs:label "OBI:0002676" ;
    dcterms:title "in vivo assay measuring a T cell epitope specific response after adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that is performed after adoptive transfer of epitope specfic T cells." .

OBI:0002677 a owl:Class ;
    rdfs:label "OBI:0002677" ;
    dcterms:title "in vivo assay measuring a B cell epitope specific response after adoptive transfer of epitope specific antibodies or B cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of B cell epitope intervention experiment that is performed after adoptive transfer of epitope specific antibodies or B cells." .

OBI:0002678 a owl:Class ;
    rdfs:label "OBI:0002678" ;
    dcterms:title "in vivo assay measuring T cell epitope specific disease exacerbation resulting from the adoptive transfer of epitope specific T cells" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of T cell epitope intervention experiment that uses a disease exacerbation in vivo intervention experiment after adoptive transfer of epitope specfic T cells." .

OBI:0002680 a owl:Class ;
    rdfs:label "OBI:0002680" ;
    dcterms:title "pseudovirus entry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the entry in target cells of reporter viral particles that express an envelope protein of a different virus of interest." .

OBI:0002692 a owl:Class ;
    rdfs:label "OBI:0002692" ;
    dcterms:title "polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses polymerase chain reaction technique to amplify DNA." .

OBI:0002693 a owl:Class ;
    rdfs:label "OBI:0002693" ;
    dcterms:title "restriction fragment length polymorphism assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses digestion of DNA with specific restriction enzymes followed by gel electropheresis to detect differences in the sizes of the generated fragments that are due to genetic differences (polymorphisms) in homologous sequences." .

OBI:0002694 a owl:Class ;
    rdfs:label "OBI:0002694" ;
    dcterms:title "DNA fingerprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to identify a specific individual organism from a DNA specimen by looking at unique patterns in their DNA." .

OBI:0002695 a owl:Class ;
    rdfs:label "OBI:0002695" ;
    dcterms:title "insecticide resistance assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that aims to detect the presence and/or frequency of resistance to insecticides in an organism or organism population." .

OBI:0002696 a owl:Class ;
    rdfs:label "OBI:0002696" ;
    dcterms:title "insecticide resistance by monitoring known mutations assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that detects, in a population, presence and frequency of mutant alleles for previously characterized mutations with insecticide resistance phenotypes." .

OBI:0002697 a owl:Class ;
    rdfs:label "OBI:0002697" ;
    dcterms:title "insecticide resistance by detecting enzyme activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is based on determination the catalytic activity of an enzyme associated with insecticide resistance phenotypes." .

OBI:0002698 a owl:Class ;
    rdfs:label "OBI:0002698" ;
    dcterms:title "insecticide resistance bioassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is typically conducted to measure the effects of a substance on a living organism." .

OBI:0002699 a owl:Class ;
    rdfs:label "OBI:0002699" ;
    dcterms:title "insecticide resistance by detecting alpha esterase activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures activity of alpha esterase." .

OBI:0002700 a owl:Class ;
    rdfs:label "OBI:0002700" ;
    dcterms:title "insecticide resistance by detecting beta esterase activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures activity of beta esterase." .

OBI:0002701 a owl:Class ;
    rdfs:label "OBI:0002701" ;
    dcterms:title "insecticide resistance by detecting acetylcholinesterase activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures activity of acetylcholinesterase." .

OBI:0002702 a owl:Class ;
    rdfs:label "OBI:0002702" ;
    dcterms:title "insecticide resistance by detecting glutathione S-transferase activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures activity of glutathione S-transferase (GST)." .

OBI:0002703 a owl:Class ;
    rdfs:label "OBI:0002703" ;
    dcterms:title "insecticide resistance by detecting carboxylic ester hydrolase activity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures activity of carboxylic ester hydrolase using p-nitrophenyl acetate as a substrate." .

OBI:0002704 a owl:Class ;
    rdfs:label "OBI:0002704" ;
    dcterms:title "insecticide resistance by detecting mixed-function oxidase assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by detecting enzyme activity assay that measures whether mixed-function oxidase activity present." .

OBI:0002705 a owl:Class ;
    rdfs:label "OBI:0002705" ;
    dcterms:title "direct insecticide resistance bioassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance bioassay without the use of any synergist." .

OBI:0002706 a owl:Class ;
    rdfs:label "OBI:0002706" ;
    dcterms:title "topical application insecticide resistance bioassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance bioassay by adding insecticide directly to the thorax of the insect." .

OBI:0002707 a owl:Class ;
    rdfs:label "OBI:0002707" ;
    dcterms:title "direct insecticide resistance diagnostic assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance assay that at preset insecticide dosage scoring mortality to determine resistance of a population." .

OBI:0002708 a owl:Class ;
    rdfs:label "OBI:0002708" ;
    dcterms:title "insecticide resistance dose response assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance assay in which an insect population is exposed to a range of insecticide dosage scoring mortality to determine resistance." .

OBI:0002709 a owl:Class ;
    rdfs:label "OBI:0002709" ;
    dcterms:title "insecticide resistance time response assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance assay to determine resistance as a consequence of the time of exposure to insecticide." .

OBI:0002710 a owl:Class ;
    rdfs:label "OBI:0002710" ;
    dcterms:title "Centre for Disease Control and Prevention bottle bioassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance diagnostic assay performs in a glass bottle coated with insecticides for detecting resistance to insecticides in vector populations." .

OBI:0002711 a owl:Class ;
    rdfs:label "OBI:0002711" ;
    dcterms:title "WHO cone kit diagnostic assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance diagnostic assay uses WHO cone kit." .

OBI:0002712 a owl:Class ;
    rdfs:label "OBI:0002712" ;
    dcterms:title "WHO paper kit diagnostic assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance diagnostic assay uses WHO paper kit." .

OBI:0002713 a owl:Class ;
    rdfs:label "OBI:0002713" ;
    dcterms:title "WHO larvicide diagnostic assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A direct insecticide resistance diagnostic assay tests survival of larvae in a medium supplemented with insecticide." .

OBI:0002714 a owl:Class ;
    rdfs:label "OBI:0002714" ;
    dcterms:title "insecticide resistance dose response by bottle assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance dose response assay that performs in a glass bottle coated with insecticides." .

OBI:0002715 a owl:Class ;
    rdfs:label "OBI:0002715" ;
    dcterms:title "insecticide resistance dose response by survival of larvae assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance dose response assay that tests survival of larvae in a medium supplemented with insecticide." .

OBI:0002716 a owl:Class ;
    rdfs:label "OBI:0002716" ;
    dcterms:title "insecticide resistance dose response by WHO paper kit assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance dose response assay using WHO paper kit." .

OBI:0002717 a owl:Class ;
    rdfs:label "OBI:0002717" ;
    dcterms:title "insecticide resistance time response by bottle assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance time response assay that is performed in a glass bottle coated with insecticides, with the presence of a synergist." .

OBI:0002718 a owl:Class ;
    rdfs:label "OBI:0002718" ;
    dcterms:title "insecticide resistance time response by WHO paper kit assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance time response assay using WHO paper kit, with the presence of a synergist." .

OBI:0002719 a owl:Class ;
    rdfs:label "OBI:0002719" ;
    dcterms:title "insecticide resistance by amplification refractory mutation system assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by monitoring known mutations assay that detects any mutation involving single base changes or small deletions using amplification refractory mutation system (ARMS). The ARMS is based on the use of sequence-specific PCR primers that allow amplification of test DNA only when the target allele is contained within the sample. Following an ARMS reaction the presence or absence of a PCR product is diagnostic for the presence or absence of the target allele. It can be used to analyze human genomic DNA for one or more mutations." .

OBI:0002720 a owl:Class ;
    rdfs:label "OBI:0002720" ;
    dcterms:title "insecticide resistance by primer introduced restriction analysis PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by monitoring known mutations assay that detects Single Nucleotide Polymorphisms (SNPs) using PCR technique and mismatched primers that is close to the mutation of interest and digested the PCR productions using restriction enzymes." .

OBI:0002721 a owl:Class ;
    rdfs:label "OBI:0002721" ;
    dcterms:title "insecticide resistance by nested polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by monitoring known mutations assay that detects gene mutation based on nested polymerase chain reaction technique." .

OBI:0002722 a owl:Class ;
    rdfs:label "OBI:0002722" ;
    dcterms:title "insecticide resistance by ligase detection reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is based on monitoring known mutations using ligase detection reaction exquisitely discriminate between a mismatched and complementary DNA helix." .

OBI:0002723 a owl:Class ;
    rdfs:label "OBI:0002723" ;
    dcterms:title "insecticide resistance by ligase detection reaction-fluorescent microsphere assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by ligase detection reaction assay that uses fluorescently labeled conserved probes in ligase detection reaction." .

OBI:0002724 a owl:Class ;
    rdfs:label "OBI:0002724" ;
    dcterms:title "insecticide resistance by PCR amplification of specific alleles assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is based on monitoring known mutations by PCR amplification of specific alleles to detect polymorphic or mutant alleles." .

OBI:0002725 a owl:Class ;
    rdfs:label "OBI:0002725" ;
    dcterms:title "insecticide resistance by fluorogenic PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is based on monitoring known mutations by PCR technique that uses target specific probes labeled with fluorogenic chromophores to detect gene mutation." .

OBI:0002726 a owl:Class ;
    rdfs:label "OBI:0002726" ;
    dcterms:title "insecticide resistance by PCR-RFLP assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance by monitoring known mutations assay based on restriction fragment length polymorphism assay." .

OBI:0002727 a owl:Class ;
    rdfs:label "OBI:0002727" ;
    dcterms:title "insecticide resistance by short interspersed elements PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An insecticide resistance assay that is based on monitoring known mutations by PCR amplification of short interspersed elements (SINEs)." .

OBI:0002728 a owl:Class ;
    rdfs:label "OBI:0002728" ;
    dcterms:title "pathogen detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects pathogens." .

OBI:0002729 a owl:Class ;
    rdfs:label "OBI:0002729" ;
    dcterms:title "VectorTest assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A pathogen detection assay that identifies the presence or absence of specific peptide epitopes of circumsporozoite (CS) protein of the most important Plasmodium falciparum and two strains (variants 210 and 247) of the more widespread Plasmodium vivax using a dipstick wicking test strip." .

OBI:0002730 a owl:Class ;
    rdfs:label "OBI:0002730" ;
    dcterms:title "pathogen detection by Rapid Analyte Measurement Platform assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A pathogen detection assay that is based on Rapid Analyte Measurement Platform (RAMP) technology to quantify immunologically active substances." .

OBI:0002731 a owl:Class ;
    rdfs:label "OBI:0002731" ;
    dcterms:title "pathogen detection by loop-mediated isothermal amplification assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A pathogen detection assay that is based on loop-mediated isothermal amplification." .

OBI:0002732 a owl:Class ;
    rdfs:label "OBI:0002732" ;
    dcterms:title "blood meal assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that analyzes the specimen taken from blood meal fed organism, such as insect." .

OBI:0002733 a owl:Class ;
    rdfs:label "OBI:0002733" ;
    dcterms:title "blood meal by counter current immunoelectrophoresis assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A blood meal assay that uses a counter current immunoelectrophoresis technique." .

OBI:0002734 a owl:Class ;
    rdfs:label "OBI:0002734" ;
    dcterms:title "DNA based blood meal finger printing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A DNA fingerprinting assay that uses DNA extracted from blood meal fed organism, such as insect." .

OBI:0002735 a owl:Class ;
    rdfs:label "OBI:0002735" ;
    dcterms:title "organism detection by size assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on the size of organism." .

OBI:0002736 a owl:Class ;
    rdfs:label "OBI:0002736" ;
    dcterms:title "organism detection by cross mating assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on genetic crossings between specimens collected in the field to determine whether fertile progeny is produced." .

OBI:0002737 a owl:Class ;
    rdfs:label "OBI:0002737" ;
    dcterms:title "organism detection by cytological chromosome examination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on analysis of polytene chromosomes through cytological examination of the banding pattern of the species." .

OBI:0002738 a owl:Class ;
    rdfs:label "OBI:0002738" ;
    dcterms:title "organism detection by isoenzyme electrophoresis assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on electrophoresis to determine the isozymes that are present in a specific population to determine the species." .

OBI:0002739 a owl:Class ;
    rdfs:label "OBI:0002739" ;
    dcterms:title "organism detection by morphological examination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on examination of morphology and the use of specific taxonomic keys to determine the species of the specimen." .

OBI:0002740 a owl:Class ;
    rdfs:label "OBI:0002740" ;
    dcterms:title "organism detection by PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on PCR." .

OBI:0002741 a owl:Class ;
    rdfs:label "OBI:0002741" ;
    dcterms:title "organism detection by specific DNA hybridization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that is based on DNA hybrdization." .

OBI:0002742 a owl:Class ;
    rdfs:label "OBI:0002742" ;
    dcterms:title "organism detection by salinity tolerance assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay of mosquito species that is on the basis of mosquito survival depending on the salt concentration in the water used to lay their eggs to differentiate between morphologically very similar species." .

OBI:0002753 a owl:Class ;
    rdfs:label "OBI:0002753" ;
    dcterms:title "PRO-cap" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "Precision nuclear run-on and sequencing to detect Pol II initiation sites" .

OBI:0002759 a owl:Class ;
    rdfs:label "OBI:0002759" ;
    dcterms:title "ribosomal RNA-depleted RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay in which highly abundant ribosomal RNAs are removed from total RNA before sequencing, resulting in more efficient transcript/gene detection." .

OBI:0002760 a owl:Class ;
    rdfs:label "OBI:0002760" ;
    dcterms:title "metatranscriptome profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that determines the RNA sequence of microbial transcripts from a microbioal community of mixed species from a given microbiome." .

OBI:0002761 a owl:Class ;
    rdfs:label "OBI:0002761" ;
    dcterms:title "lipid profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay assay that detects and identifies lipids resulting from biochemical and cellular metabolism." .

OBI:0002762 a owl:Class ;
    rdfs:label "OBI:0002762" ;
    dcterms:title "single-nucleus ATAC-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An ATAC-seq assay in which single nuclei are isolated from frozen tissue samples, through a protocol designed to maximally preserve nucleus integrity during sample processing and optimize transposase-mediated fragmentation of chromatin in individual nuclei." .

OBI:0002763 a owl:Class ;
    rdfs:label "OBI:0002763" ;
    dcterms:title "16s ribosomal gene sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An amplicon sequencing assay in which the amplicon is derived from universal primers used to amplify the 16S ribosomal RNA gene from isolate bacterial genomic DNA or metagenomic DNA from a microbioal community. Resulting sequences are compared to reference 16S sequence databases to identify or classify bacteria present within a given sample." .

OBI:0002764 a owl:Class ;
    rdfs:label "OBI:0002764" ;
    dcterms:title "single-cell ATAC-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An ATAC assay designed to robustly map the accessible genome of individual cells, using sequencing integrated into a programmable microfluidics platform, in order to provide insights into cell-to-cell variation in accessibility profiles." .

OBI:0002765 a owl:Class ;
    rdfs:label "OBI:0002765" ;
    dcterms:title "microbiome protein expression profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A protein expression profiling assay of microbial proteins extracted from a microbioal community of mixed species from a given microbiome." .

OBI:0002766 a owl:Class ;
    rdfs:label "OBI:0002766" ;
    dcterms:title "cytokine assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay to study presence, concentration, or amount of cytokines." .

OBI:0002767 a owl:Class ;
    rdfs:label "OBI:0002767" ;
    dcterms:title "amplicon sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay in which a DNA or RNA input molecule is amplified by PCR and the product sequenced." .

OBI:0002768 a owl:Class ;
    rdfs:label "OBI:0002768" ;
    dcterms:title "whole virome sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A whole metagenome sequencing assay that intends to provide information on multiple genome sequences from different viruses present in the same input sample." .

OBI:0002773 a owl:Class ;
    rdfs:label "OBI:0002773" ;
    dcterms:title "single-value binding of antibody with reporter to antigen assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the linking of antigens and antibodies via special signaling mechanisms, such as EIA, ELISA, chemiluminescence, etc. that produces one measure (quantitative or qualitative) of the analyte of interest" .

OBI:0002946 a owl:Class ;
    rdfs:label "OBI:0002946" ;
    dcterms:title "fluorescence imaging-based apoptosis assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to label and detect proteins or structures associated with molecular processes of apoptosis." .

OBI:0002947 a owl:Class ;
    rdfs:label "OBI:0002947" ;
    dcterms:title "fluorescence imaging-based cell proliferation assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cell proliferation assay in which fluorescent dyes are ued to label and detect proteins or structures that can be used to count cells." .

OBI:0002948 a owl:Class ;
    rdfs:label "OBI:0002948" ;
    dcterms:title "fluorescence imaging-based cell cycle state assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to label and detect proteins or structures associated with particular cell cycle states." .

OBI:0002949 a owl:Class ;
    rdfs:label "OBI:0002949" ;
    dcterms:title "fluorescence imaging-based cell viability assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to label and detect proteins or structures associated with cell viability." .

OBI:0002950 a owl:Class ;
    rdfs:label "OBI:0002950" ;
    dcterms:title "fluorescence imaging-based drug synergy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to label and detect proteins or structures to determine if drugs applied to cells in combination have a greater effect together than the sum of their separate effects." .

OBI:0002951 a owl:Class ;
    rdfs:label "OBI:0002951" ;
    dcterms:title "fluorescence imaging-based cell morphology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to label and detect proteins or structures in order to determine cell morphology." .

OBI:0002952 a owl:Class ;
    rdfs:label "OBI:0002952" ;
    dcterms:title "fluorescence imaging multiplex cytological profiling" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay in which fluorescent dyes are used to stain seven major cellular components followed by automatic image capture and analysis which extracts shape, texture, and intensity parameters." .

OBI:0002953 a owl:Class ;
    rdfs:label "OBI:0002953" ;
    dcterms:title "protein state assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of assay that measures the quantity and/or identity of proteins in their modficied and unmodified states where modifications include phosphorylation, methylation, acetylation, etc." .

OBI:0002954 a owl:Class ;
    rdfs:label "OBI:0002954" ;
    dcterms:title "fluorescence imaging-based protein phosphorylation state assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of protein state assay that employs high-throughput microscopy to measure levels of proteins in different phosphorylation states." .

OBI:0002955 a owl:Class ;
    rdfs:label "OBI:0002955" ;
    dcterms:title "mass spectrometry-based protein state assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of protein state assay that employs mass spectrometry to measure levels of proteins in different phosphorylation states." .

OBI:0002956 a owl:Class ;
    rdfs:label "OBI:0002956" ;
    dcterms:title "targeted, drug-modulated, mass spectrometry-based protein phoshporylation-state assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of mass spectrometry protein state assay that measures levels of a targeted set of proteins in different phosphorylation states in response to drug perturbations." .

OBI:0002957 a owl:Class ;
    rdfs:label "OBI:0002957" ;
    dcterms:title "reverse phase protein array profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of protein state assay where tissue or cell samples are lysed and then spotted onto a slide which is probed with antibodies specific to proteins with and without post-translational modifications." .

OBI:0002958 a owl:Class ;
    rdfs:label "OBI:0002958" ;
    dcterms:title "SWATH-MS protein profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of mass spectrometry assay using a data-independent acquisition method to identify target peptides." .

OBI:0002959 a owl:Class ;
    rdfs:label "OBI:0002959" ;
    dcterms:title "tandem mass tag mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of tandem mass spectrometry where isotopomer labels are employed for accurate quantification and identification of specific proteins." .

OBI:0002960 a owl:Class ;
    rdfs:label "OBI:0002960" ;
    dcterms:title "fluorescence imaging-based reporter gene assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of reporter gene assay that employs fluorescence imaging to detect a reporter gene's expression." .

OBI:0002961 a owl:Class ;
    rdfs:label "OBI:0002961" ;
    dcterms:title "global chromatin profiling by mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of epigenetic modification assay that employs targeted quantitative mass spectrometry to profile modifications of the core histones of chromatin." .

OBI:0002962 a owl:Class ;
    rdfs:label "OBI:0002962" ;
    dcterms:title "kinase inhibitor assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of assay that identifies compounds that inhibit the activity of kinases." .

OBI:0002963 a owl:Class ;
    rdfs:label "OBI:0002963" ;
    dcterms:title "KINOMEscan assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of proprietary kinase inhibitor assay that and employs a panel of kinases against which one can test compounds for their selectivity and potency in interactions with kinases, without the need to add ATP to the reactions." .

OBI:0002964 a owl:Class ;
    rdfs:label "OBI:0002964" ;
    dcterms:title "KiNativ assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of proprietary in situ kinase inhibitor assay that employs biotinylated acyl phosphates of ATP and ADP." .

OBI:0002965 a owl:Class ;
    rdfs:label "OBI:0002965" ;
    dcterms:title "landmark transcript profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of transcription profiling assay in which a set of landmark transcripts that have been determined to provide a comprehensive profile of cell activity, plus numerous steady-state controls, are assayed via ligation-mediated amplification followed by capture on fluorescently labeled microspheres followed by detection of fluorescence." .

OBI:0002966 a owl:Class ;
    rdfs:label "OBI:0002966" ;
    dcterms:title "microenvironment microarray assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of cytometry assay where cells are incubated for three days with a standardized set of extracellular matrix proteins in combination with various ligands creating varying microenvironment perterbations for the cells. Immunofluorescent imaging of cells is used to measure features such as morphology, metabolism, cell cycle, and nuclear activity." .

OBI:0002967 a owl:Class ;
    rdfs:label "OBI:0002967" ;
    dcterms:title "microwestern meso-scale quantitative western blot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A western blot assay that provides a high-throughput, sensitive, and quantitative measurement of proteins from numerous samples via an array of small western blots on a single sheet of nitrocellulose." .

OBI:0002968 a owl:Class ;
    rdfs:label "OBI:0002968" ;
    dcterms:title "positive/negative ion switching metabolite profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of metabolic profiling assay which employs a hybrid dual quadrupole linear ion trap mass spectrometer for steady-state profiling of endogenous polar metabolites from organic extractions from biological samples." .

OBI:0002969 a owl:Class ;
    rdfs:label "OBI:0002969" ;
    dcterms:title "cyclic immunofluoroescence assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of microscopy assay resulting in highly multiplexed immunofluorescence imaging through sequential rounds of imaging followed by fluorophore inactivation." .

OBI:0002970 a owl:Class ;
    rdfs:label "OBI:0002970" ;
    dcterms:title "multiplex bead-based protein state immunoassay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of protein state assay in which antibodies attached to different colored beads and fluorescent reporter dye labels are used in a multiplexed mixture to assay for proteins in specific states." .

OBI:0002984 a owl:Class ;
    rdfs:label "OBI:0002984" ;
    dcterms:title "capture Hi-C assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A Hi-C assay in which a selection step is performed on ligated fragments in order to enrich for ligation products containing specific regions of interest." .

OBI:0002985 a owl:Class ;
    rdfs:label "OBI:0002985" ;
    dcterms:title "magnetic resonance imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay in which nuclear magnetic resonance is used to produce information about the interior structure and composition of an input material entity." .

OBI:0002986 a owl:Class ;
    rdfs:label "OBI:0002986" ;
    dcterms:title "computed tomography imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay that uses a series of X-ray images to produce information about the interior structure and composition of an input material entity." .

OBI:0002987 a owl:Class ;
    rdfs:label "OBI:0002987" ;
    dcterms:title "positron emission tomography imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay in which positron-emitting radionuclides are used to visualize functional processes of an input material entity." .

OBI:0002990 a owl:Class ;
    rdfs:label "OBI:0002990" ;
    dcterms:title "T cell receptor repertoire sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay that determines the sequences of DNA or RNA molecules that encode the repertoire of T cell receptors within an input sample." .

OBI:0002991 a owl:Class ;
    rdfs:label "OBI:0002991" ;
    dcterms:title "B cell receptor repertoire sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay that determines the sequence of a DNA or RNA molecules that encode the repertoire of B cell receptors within an input sample." .

OBI:0003009 a owl:Class ;
    rdfs:label "OBI:0003009" ;
    dcterms:title "ferritin assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures ferritin" .

OBI:0003010 a owl:Class ;
    rdfs:label "OBI:0003010" ;
    dcterms:title "fibrinogen assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures fibrinogen" .

OBI:0003011 a owl:Class ;
    rdfs:label "OBI:0003011" ;
    dcterms:title "iron assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of iron" .

OBI:0003012 a owl:Class ;
    rdfs:label "OBI:0003012" ;
    dcterms:title "ionized calcium assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of ionized calcium" .

OBI:0003013 a owl:Class ;
    rdfs:label "OBI:0003013" ;
    dcterms:title "transferrin assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of transferrin" .

OBI:0003014 a owl:Class ;
    rdfs:label "OBI:0003014" ;
    dcterms:title "uric acid assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of uric acid" .

OBI:0003015 a owl:Class ;
    rdfs:label "OBI:0003015" ;
    dcterms:title "globulin assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of globulin" .

OBI:0003016 a owl:Class ;
    rdfs:label "OBI:0003016" ;
    dcterms:title "myelocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of myelocytes" .

OBI:0003017 a owl:Class ;
    rdfs:label "OBI:0003017" ;
    dcterms:title "metamyelocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of metamyelocytes" .

OBI:0003018 a owl:Class ;
    rdfs:label "OBI:0003018" ;
    dcterms:title "hematocrit assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the proportion of red blood cells" .

OBI:0003019 a owl:Class ;
    rdfs:label "OBI:0003019" ;
    dcterms:title "promyelocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of promyelocytes" .

OBI:0003021 a owl:Class ;
    rdfs:label "OBI:0003021" ;
    dcterms:title "basophil assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of basophils" .

OBI:0003022 a owl:Class ;
    rdfs:label "OBI:0003022" ;
    dcterms:title "neutrophil assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of neutrophils" .

OBI:0003023 a owl:Class ;
    rdfs:label "OBI:0003023" ;
    dcterms:title "eosinophil assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of eosinophils" .

OBI:0003024 a owl:Class ;
    rdfs:label "OBI:0003024" ;
    dcterms:title "lymphocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of lymphocytes" .

OBI:0003025 a owl:Class ;
    rdfs:label "OBI:0003025" ;
    dcterms:title "monocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of monocytes" .

OBI:0003026 a owl:Class ;
    rdfs:label "OBI:0003026" ;
    dcterms:title "reticulocyte assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of reticulocytes" .

OBI:0003027 a owl:Class ;
    rdfs:label "OBI:0003027" ;
    dcterms:title "macrophage assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of macrophages" .

OBI:0003028 a owl:Class ;
    rdfs:label "OBI:0003028" ;
    dcterms:title "platelet assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry assay that measures the abundance and/or characteristics of platelets" .

OBI:0003031 a owl:Class ;
    rdfs:label "OBI:0003031" ;
    dcterms:title "fluorogenic PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A polymerase chain reaction assay that uses target specific probes labeled with fluorogenic chromophores." .

OBI:0003032 a owl:Class ;
    rdfs:label "OBI:0003032" ;
    dcterms:title "genotyping by PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A genotyping assay that uses polymerase chain reaction." .

OBI:0003033 a owl:Class ;
    rdfs:label "OBI:0003033" ;
    dcterms:title "cleavage under targets and release using nuclease assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of DNA sequencing assay employing in situ chromatin profiling in which antibody-targeted controlled cleavage by micrococcal nuclease releases specific protein-DNA complexes into the the supernatant for sequencing." .

OBI:0003034 a owl:Class ;
    rdfs:label "OBI:0003034" ;
    dcterms:title "cleavage under targets and tagmentation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A type of DNA sequencing assay employing in situ chromatin profiling in which a chromatin protein is bound in situ by a specific antibody, which then tethers to a protein A-Tn5 hyperactive transposase fusion protein (pA-Tn5) loaded with sequence adapters. Activation of pA-Tn5 results in factor-targeted tagmentation, generating fragments ready for PCR enrichment and DNA sequencing." .

OBI:0003035 a owl:Class ;
    rdfs:label "OBI:0003035" ;
    dcterms:title "coma severity assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A physical examination of an organism that has the objective to determine the severity of coma in a patient." .

OBI:0003036 a owl:Class ;
    rdfs:label "OBI:0003036" ;
    dcterms:title "Plasmodium gametocyte detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects Plasmodium gametocytes in a specimen." .

OBI:0003037 a owl:Class ;
    rdfs:label "OBI:0003037" ;
    dcterms:title "malaria rapid diagnosis assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that is quick and easy in the diagnosis of malaria by detecting evidence of malaria parasites (antigens) in human blood." .

OBI:0003038 a owl:Class ;
    rdfs:label "OBI:0003038" ;
    dcterms:title "parasite detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects parasite in a specimen." .

OBI:0003039 a owl:Class ;
    rdfs:label "OBI:0003039" ;
    dcterms:title "feces microbiology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An organism detection assay that detects microorganisms in a feces specimen." .

OBI:0003040 a owl:Class ;
    rdfs:label "OBI:0003040" ;
    dcterms:title "blood assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a blood specimen as evaulant." .

OBI:0003041 a owl:Class ;
    rdfs:label "OBI:0003041" ;
    dcterms:title "falcivax rapid diagnostic test" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A parasite detection assay that can quickly establish the diagnosis of P. falciparum or P. vivax malaria infection by detecting the antigens in a person's blood." .

OBI:0003042 a owl:Class ;
    rdfs:label "OBI:0003042" ;
    dcterms:title "optimal-IT rapid diagnostic test" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A parasite detection assay that is rapid, sensitive, and able to differentiate between P. falciparum and other malaria parasites." .

OBI:0003043 a owl:Class ;
    rdfs:label "OBI:0003043" ;
    dcterms:title "urine assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that has a urine specimen as evaluant." .

OBI:0003044 a owl:Class ;
    rdfs:label "OBI:0003044" ;
    dcterms:title "parasite species identification by PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A parasite detection by PCR assay that identifies the species of parasite." .

OBI:0003045 a owl:Class ;
    rdfs:label "OBI:0003045" ;
    dcterms:title "parasite detection by PCR assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A parasite detection assay that uses PCR." .

OBI:0003080 a owl:Class ;
    rdfs:label "OBI:0003080" ;
    dcterms:title "organismal body temperature measurement assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects body temperature of an organism." .

OBI:0003087 a owl:Class ;
    rdfs:label "OBI:0003087" ;
    dcterms:title "autofluorescence assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A fluorescence detection assay in which the light that is naturally emitted by a sample is visualized after excitation of the sample with light at a suitable wavelength." .

OBI:0003088 a owl:Class ;
    rdfs:label "OBI:0003088" ;
    dcterms:title "autofluorescence microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An autofluorescence assay in which the light that is naturally emitted by a sample is visualized via microscopy after excitation of the sample with light at a suitable wavelength." .

OBI:0003089 a owl:Class ;
    rdfs:label "OBI:0003089" ;
    dcterms:title "bulk assay for transposase-accessible chromatin using sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay for transposase-accessible chromatin using sequencing in which the sample that is sequenced is derived from a collection of cells, such as a tissue sample or entire cell culture, and therefore provides results representative of the aggregate of sample cells." .

OBI:0003090 a owl:Class ;
    rdfs:label "OBI:0003090" ;
    dcterms:title "bulk RNA-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay in which the sample that is sequenced is derived from a collection of cells, such as a tissue sample or entire cell culture, and therefore provides results representative of the aggregate of sample cells." .

OBI:0003091 a owl:Class ;
    rdfs:label "OBI:0003091" ;
    dcterms:title "multiplexed fluorescent antibody imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An imaging assay in which multiple cycles consisting of fluorescent labeling, imaging, and fluorophor deactivation are used to detect multiple proteins and their locations in a given sample of tissues or cells." .

OBI:0003092 a owl:Class ;
    rdfs:label "OBI:0003092" ;
    dcterms:title "Cell DIVE multiplexed imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A multiplexed fluorescent antibody imaging assay that involves an iterative staining, imaging and dye inactivation workflow for over 60 biomarkers on a single fixed tissue section." .

OBI:0003093 a owl:Class ;
    rdfs:label "OBI:0003093" ;
    dcterms:title "co-detection by indexing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A multiplexed fluorescent antibody imaging assay that involves a highly multiplexed analysis of up to 40 proteins in a tissue using cyclic detection of DNA-indexed antibody panels." .

OBI:0003094 a owl:Class ;
    rdfs:label "OBI:0003094" ;
    dcterms:title "fluorescence in-situ hybridization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in-situ hybridization assay in which fluorescently labeled molecules are used to localize specific DNA or RNA sequences." .

OBI:0003095 a owl:Class ;
    rdfs:label "OBI:0003095" ;
    dcterms:title "decoding amplified targeted transcripts with fluorescence in situ hybridization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A fluorescence in-situ hybridization assay which involves multiplex in situ digital quantification of targeted RNA transcripts in fresh or frozen tissue providing an understanding of the spatial organization of different cell types." .

OBI:0003096 a owl:Class ;
    rdfs:label "OBI:0003096" ;
    dcterms:title "imaging mass cytometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry time of flight assay in which molecules of interest on or in cells are imaged through a system in which samples are labeled with multiple different rare-earth tagged antibodies. The sample is then ablated with a laser and the labeled material is detected by cytometry time of flight mass spectrometry." .

OBI:0003097 a owl:Class ;
    rdfs:label "OBI:0003097" ;
    dcterms:title "liquid chromatography mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A mass spectrometry assay where a sample mixture is first separated by liquid chromatography before being converted into ions which are characterized by using mass spectrometry based on their mass-to-charge ratio and relative abundance." .

OBI:0003098 a owl:Class ;
    rdfs:label "OBI:0003098" ;
    dcterms:title "lightsheet fluorescence microscopy assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A fluorescence microscopy that involves capturing of photons emitted by fluorophores excited with a thin sheet of laser light in a sample only in a relatively narrow plane by a detection objective oriented perpendicularly to the light sheet and imaged onto a detection device such as a CCD camera." .

OBI:0003099 a owl:Class ;
    rdfs:label "OBI:0003099" ;
    dcterms:title "matrix assisted laser desorption ionization imaging mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A mass spectrometry assay that involves collection of spatially resolved mass spectra of a sample during microscopy where a pulse laser is used to produce both ionisation and vaporization. The sample is held in a matrix (such as dihydrobenzoic acid) to protect it from direct laser illumination and to separate the sample molecules. The spectra are used to visualise the spatial distribution of biomolecules by their molecular masses." .

OBI:0003100 a owl:Class ;
    rdfs:label "OBI:0003100" ;
    dcterms:title "multiplexed ion beam imaging assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometry time of flight assay in which molecules of interest on or in cells are imaged through a system in which samples are labeled with multiple different rare-earth tagged antibodies. A primary ion beam is ued to rasterize sections under vacuum, releasing showers of secondary ions detected by cytometry time of flight mass spectrometry." .

OBI:0003101 a owl:Class ;
    rdfs:label "OBI:0003101" ;
    dcterms:title "nanospray desorption electrospray ionization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A mass spectrometry assay that analyzes organic and biological molecules on a substrate by desorption of an analyte into a solvent bridge formed between two capillaries and the analysis surface. One capillary supplies solvent to create and maintain the bridge, while the second capillary transports the dissolved analyte from the bridge to the mass spectrometer. A high voltage applied between the inlet of mass spectrometer and the primary capillary creates a self-aspirating nanospray." .

OBI:0003102 a owl:Class ;
    rdfs:label "OBI:0003102" ;
    dcterms:title "nanodroplet processing in one pot for trace samples assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A protein expression profiling assay in which proteomics sample processing is performed in nanoliter volumes. Flow cytometry or laser microdissection is employed to isolate a small population or single cells into a nanoPOTS chip. Then, liquid chromatography mass spectrometry is used to measure the global protein expression." .

OBI:0003103 a owl:Class ;
    rdfs:label "OBI:0003103" ;
    dcterms:title "periodic acid-Schiff staining assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A histological assay which is used on tissue samples to demonstrate the presence of carbohydrates and carbohydrate compounds such as polysaccharides, mucin, glycogen, or fungal cell wall components." .

OBI:0003104 a owl:Class ;
    rdfs:label "OBI:0003104" ;
    dcterms:title "single cell combinatorial indexing assay for transposase-accessessable chromatin using sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay for transposase-accessible chromatin that uses sequencing which involves single cell combinatorial indexing ('sci-') strategy where nucleic acids from each of many cells are uniquely tagged through several rounds of split-pool barcoding which enables identification of single cells without single cell isolation." .

OBI:0003105 a owl:Class ;
    rdfs:label "OBI:0003105" ;
    dcterms:title "single-cell combinatorial indexing RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-cell transcription profiling by RNA sequencing assay that involves single cell combinatorial indexing ('sci-') strategy to profile the transcriptomes of single cells or nuclei without single cell isolation." .

OBI:0003106 a owl:Class ;
    rdfs:label "OBI:0003106" ;
    dcterms:title "sequential fluorescence in-situ hybridization assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A fluorescence in-situ hybridization assay that involves ultra-resolution imaging of cell activity by targetting thousands of single molecules with fluorescent probes which find and hybridize with complementary DNA or RNA sequences in the tissue sample, thus enabling identification of those molecules directly in single cells with their spatial context preserved." .

OBI:0003107 a owl:Class ;
    rdfs:label "OBI:0003107" ;
    dcterms:title "slide-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that involves transfer of RNA from tissue sections onto a surface covered in DNA-barcoded beads with known positions, allowing the locations of the RNA to be inferred by sequencing." .

OBI:0003108 a owl:Class ;
    rdfs:label "OBI:0003108" ;
    dcterms:title "single-nucleus chromatin accessibility and mRNA expression sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that involves joint profiling of accessible chromatin and RNA within the same cells which enables direct matching of transcriptional regulation to its outputs." .

OBI:0003110 a owl:Class ;
    rdfs:label "OBI:0003110" ;
    dcterms:title "gas chromatography mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A mass spectrometry assay combining mass spectrometry and gas chromatography for the qualitative as well as quantitative determination of compounds." .

OBI:0003111 a owl:Class ;
    rdfs:label "OBI:0003111" ;
    dcterms:title "SOMAscan assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that uses aptamers to detect protein analytes in serum." .

OBI:0003112 a owl:Class ;
    rdfs:label "OBI:0003112" ;
    dcterms:title "Olink assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A proximity extension assay that uses quantitative polymerase chain reaction (qPCR) technology to determine the concentration/presence of proteins using a high-multiplex, high-throughput protein biomarker platform. The assay utilizes two distinct oligonucleotide-labeled antibodies (‘probes’) that bind at different sites for each detected protein. When the two probes are in close proximity, a new PCR target sequence is formed by a proximity-dependent DNA polymerization event. The resulting sequence is subsequently detected and quantified using standard real-time PCR." .

OBI:0003113 a owl:Class ;
    rdfs:label "OBI:0003113" ;
    dcterms:title "proximity extension assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that uses quantitative polymerase chain reaction (qPCR) technology to determine the concentration/presence of an analyte or analyte complex." .

OBI:0003115 a owl:Class ;
    rdfs:label "OBI:0003115" ;
    dcterms:title "antigen detection by cytometric bead array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay in which a series of beads are coated with antibodies specific to antigens of interest. Antigens of interest attach to antibodies on the beads. Fluorescent labeled secondary antibodies are used to detect the antigens of interest." .

OBI:0003116 a owl:Class ;
    rdfs:label "OBI:0003116" ;
    dcterms:title "antibody detection by cytometric bead array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cytometric bead array assay that detects antigen-specific antibodies. In the assay a series of beads are coated with antigens which capture antibodies specific to the antigens. Fluorescent labeled secondary antibodies are used to detect the antibodies of interest." .

OBI:0003117 a owl:Class ;
    rdfs:label "OBI:0003117" ;
    dcterms:title "3D molecular structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the 3-dimensional configuration of a molecular entity or molecular complex." .

OBI:0003118 a owl:Class ;
    rdfs:label "OBI:0003118" ;
    dcterms:title "electron-microscopy 3D molecular structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D molecular structure determination assay that uses electron microscopy imaging." .

OBI:0003122 a owl:Class ;
    rdfs:label "OBI:0003122" ;
    dcterms:title "3D cell structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D structure determination assay that determines the 3-dimensional configuration of a cell." .

OBI:0003123 a owl:Class ;
    rdfs:label "OBI:0003123" ;
    dcterms:title "3D neural cell structure determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D cell structure determination assay that determines the 3-dimensional configuration of a neural cell." .

OBI:0003124 a owl:Class ;
    rdfs:label "OBI:0003124" ;
    dcterms:title "neuron morphology assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D neural cell structure determination assay that determines the 3-dimensional configuration of a neuron." .

OBI:0003125 a owl:Class ;
    rdfs:label "OBI:0003125" ;
    dcterms:title "mosaicism with repeat frameshift genetic sparse labeling" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D neural cell structure determination assay where sparse and stochastic methods are used to label genetically-defined neurons." .

OBI:0003126 a owl:Class ;
    rdfs:label "OBI:0003126" ;
    dcterms:title "neuron morphology reconstruction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A neuron morphology assay where the morphology or structure of a neuron is represented. Often, this assay is a combination of different assays (sparse labelling, fluorescent labeling, fMOST)." .

OBI:0003127 a owl:Class ;
    rdfs:label "OBI:0003127" ;
    dcterms:title "B cell epitope assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An immune epitope assay that characterizes the structrue of an antibody-epitope complex, or measures the binding of an antibody receptor to epitope, or the immune response process resulting from such a binding event or the recognition of the epitope." .

OBI:0003128 a owl:Class ;
    rdfs:label "OBI:0003128" ;
    dcterms:title "T cell epitope assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An immune epitope assay that characterizes the structrue of an epitope-T cell receptor complex, or measures the binding of a T cell receptor to epitope, or the immune response process resulting from such a binding event or the recognition of the epitope." .

OBI:0003145 a owl:Class ;
    rdfs:label "OBI:0003145" ;
    dcterms:title "assay measuring quantitative binding of a MHC:ligand complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the binding of a MHC molecule with a ligand, and produces a quantitative measurement of the binding as an output." .

OBI:0003146 a owl:Class ;
    rdfs:label "OBI:0003146" ;
    dcterms:title "assay measuring quantitative binding of an antigen:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the binding of an antigen with an antibody, and produces a quantitative measurement of the binding as an output." .

OBI:0003147 a owl:Class ;
    rdfs:label "OBI:0003147" ;
    dcterms:title "assay measuring quantitative binding of an epitope:MHC:TCR complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the binding of a MHC:epitope complex with a T cell receptor, and produces a quantitative measurement of the binding as an output." .

OBI:0003148 a owl:Class ;
    rdfs:label "OBI:0003148" ;
    dcterms:title "albumin concentration assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An albumin assay that measures the concentration of albumin in a specimen." .

