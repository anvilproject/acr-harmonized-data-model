    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope specific activation of additional immune response assay that detects complement-dependent cytotoxicity in vitro ." .

OBI:0001642 a owl:Class ;
    rdfs:label "OBI:0001642" ;
