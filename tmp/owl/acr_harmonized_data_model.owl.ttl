    dcterms:title "BLC" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "A multiple alignment in vertical format, as used in the AMPS (Alignment of Multiple Protein Sequences) package." .

edam:format_3326 a owl:Class ;
    rdfs:label "edam:format_3326" ;
    dcterms:title "Data index format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Format of a data index of some type." .

edam:format_3327 a owl:Class ;
    rdfs:label "edam:format_3327" ;
    dcterms:title "BAI" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
