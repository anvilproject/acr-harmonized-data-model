OBI:0001848 a owl:Class ;
    rdfs:label "OBI:0001848" ;
    dcterms:title "chromatin interaction analysis by paired-end tag sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that incorporates chromatin immunoprecipitation (ChIP)-based enrichment, chromatin proximity ligation, Paired-End Tags, and high-throughput sequencing to determine de novo long-range chromatin interactions genome-wide." .

OBI:0001849 a owl:Class ;
    rdfs:label "OBI:0001849" ;
    dcterms:title "structural analysis by paired-end tag sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that incorporates Paired-End Tags and sequencing technology to determine structural variants." .

OBI:0001850 a owl:Class ;
    rdfs:label "OBI:0001850" ;
    dcterms:title "transcript analysis by paired-end tag sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that employs paired-end sequencing of RNA transcripts to determine things such as gene expression, gene structure, and alternative transcript structure." .

OBI:0001853 a owl:Class ;
    rdfs:label "OBI:0001853" ;
    dcterms:title "DNase I hypersensitive sites sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies the location of regulatory regions, based on the genome-wide sequencing of regions super sensitive to cleavage by DNase I." .

OBI:0001857 a owl:Class ;
    rdfs:label "OBI:0001857" ;
    dcterms:title "RNP (ribonuclear particle) immunoprecipitation high- throughput sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that combines immunoprecipitation of an RNA-binding protein and RNA-seq to identify mRNAs associated with selected RNA binding proteins (RBPs)." .

OBI:0001858 a owl:Class ;
    rdfs:label "OBI:0001858" ;
    dcterms:title "cross-linking immunoprecipitation high-throughput sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that employs UV-crosslinking between RNA and a protein, followed by immunoprecipitation with antibodies for the protein, fragmentation, and high-throughput screening for RNA sequences that interact with a particular RNA-binding protein." .

OBI:0001859 a owl:Class ;
    rdfs:label "OBI:0001859" ;
    dcterms:title "formaldehyde-assisted isolation of regulatory elements assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay to determine the sequences of those DNA regions in the genome associated with regulatory activity." .

OBI:0001861 a owl:Class ;
    rdfs:label "OBI:0001861" ;
    dcterms:title "methylation-sensitive restriction enzyme sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies unmethylated CpGs using methylation sensitive restriction enzymes to fragment DNA." .

OBI:0001862 a owl:Class ;
    rdfs:label "OBI:0001862" ;
    dcterms:title "reduced representation bisulfite sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bisulfite sequencing assay that identifies genomic methylation patterns using a bisulfite based protocol that enriches CG-rich parts of the genome." .

OBI:0001863 a owl:Class ;
    rdfs:label "OBI:0001863" ;
    dcterms:title "shotgun bisulfite-seq assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A bisulfite sequencing assay that identifies methylated cytosines across the genome using high throughput sequencing." .

OBI:0001864 a owl:Class ;
    rdfs:label "OBI:0001864" ;
    dcterms:title "RNA Annotation and Mapping of Promoters for the Analysis of Gene Expression assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling by RNA sequencing assay that identifies transcription start sites (TSS), the quantification of their expression and the characterization of their transcripts using high throughput sequencing." .

OBI:0001915 a owl:Class ;
    rdfs:label "OBI:0001915" ;
    dcterms:title "DNA replication timing by array assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay which quantifies the timing of DNA replication as a function of genome position using array technology." .

OBI:0001918 a owl:Class ;
    rdfs:label "OBI:0001918" ;
    dcterms:title "RNA-binding protein immunoprecipitation array profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that combines immunoprecipitation of an RNA-binding protein and array technology to identify mRNAs associated with selected RNA binding proteins (RBPs)." .

OBI:0001919 a owl:Class ;
    rdfs:label "OBI:0001919" ;
    dcterms:title "Carbon-copy chromosome conformation capture assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the organization of chromosomes at the genome-wide scale." .

OBI:0001920 a owl:Class ;
    rdfs:label "OBI:0001920" ;
    dcterms:title "DNA replication timing by sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which timing of DNA replication is quantified as a function of genome position based on genome-wide sequencing." .

OBI:0001921 a owl:Class ;
    rdfs:label "OBI:0001921" ;
    dcterms:title "RNA-binding protein immunoprecipitation tiling array profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An RNA-binding protein immunoprecipitation array profiling assay that combines immunoprecipitation of an RNA-binding protein and RNA tiling array to identify mRNAs associated with selected RNA binding proteins (RBPs)." .

OBI:0001922 a owl:Class ;
    rdfs:label "OBI:0001922" ;
    dcterms:title "microRNA profiling by high throughput sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A microRNA profiling assay that analyzes the microRNA component of the transcriptome using high throughput sequencing technology." .

OBI:0001923 a owl:Class ;
    rdfs:label "OBI:0001923" ;
    dcterms:title "protein sequencing by tandem mass spectrometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A sequencing assay that detremines amino acid sequences of proteins using multiple rounds of mass spectrometry and molecule fragmentation." .

OBI:0001924 a owl:Class ;
    rdfs:label "OBI:0001924" ;
    dcterms:title "micrococcal nuclease digestion followed by high throughput sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies nucleosome positioning by genome wide sequencing of regions sensitive to digestion by micrococal nuclease" .

OBI:0001925 a owl:Class ;
    rdfs:label "OBI:0001925" ;
    dcterms:title "chromatin immunoprecipitation with exonuclease sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A ChIP-seq assay which uses immunoprecipitation to isolate protein bound DNA followed by an exonuclease step to degrade DNA that is not protein bound to provide greater resolution of the DNA binding site" .

OBI:0001926 a owl:Class ;
    rdfs:label "OBI:0001926" ;
    dcterms:title "microRNA profiling assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A transcription profiling assay that quantifies the microRNA species within a biological sample." .

OBI:0001954 a owl:Class ;
    rdfs:label "OBI:0001954" ;
    dcterms:title "ChIP assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which portions of chromatin, the ordered and organized complex of DNA and its interaction partners that make up a chormosome, is extracted and purified by immunoprecipitation with antibodies or tags, and subsequently analyzed" .

OBI:0001956 a owl:Class ;
    rdfs:label "OBI:0001956" ;
    dcterms:title "assay using chromatin immunoprecipitation" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that produces data about protein-DNA interaction or DNA epigenetic modification using immunoprecipitation" .

OBI:0001960 a owl:Class ;
    rdfs:label "OBI:0001960" ;
    dcterms:title "taxonomic diversity assessment by targeted gene survey" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that dteremines taxonomic and community diversity information by sequencing specific genomic regions used as marker of identity or diversity." .

OBI:0001976 a owl:Class ;
    rdfs:label "OBI:0001976" ;
    dcterms:title "hydrogen/deuterium exchange footprinting assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A footprinting assay that uses a chemical reaction whereby a covalently bonded hydrogen atom is replaced by a deuterium atom, or vice versa in order to gather information about the solvent accessibility of parts of a molecule and thus its tertiary structure." .

OBI:0001977 a owl:Class ;
    rdfs:label "OBI:0001977" ;
    dcterms:title "cytometry assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that counts and/or measures characteristics of cells." .

OBI:0001978 a owl:Class ;
    rdfs:label "OBI:0001978" ;
    dcterms:title "immunoblot assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that detects specific molecules in an input material by separating it using gel electrophoresis, transfering the separated molecules to a membrane, and staining them with_ antibodies specific to the analyte molecules." .

OBI:0001979 a owl:Class ;
    rdfs:label "OBI:0001979" ;
    dcterms:title "fluorescence quenching binding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A binding assay in which the proximity of two entities is monitored by measuring a fluorescent signal of one of the entities that gets reduced if the two entities are cliose to each other." .

OBI:0001980 a owl:Class ;
    rdfs:label "OBI:0001980" ;
    dcterms:title "in vivo intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay in which the effect of a targeted process (the intervention) on an organism is tested." .

OBI:0001981 a owl:Class ;
    rdfs:label "OBI:0001981" ;
    dcterms:title "disease exacerbation in vivo intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo intervention experiment that tests the ability of the intervention to increase the severity of a disease in the host." .

OBI:0001982 a owl:Class ;
    rdfs:label "OBI:0001982" ;
    dcterms:title "protection from challenge in vivo intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo intervention experiment that tests the ability of the intervention to prevent occurrence of a disease in a host." .

OBI:0001983 a owl:Class ;
    rdfs:label "OBI:0001983" ;
    dcterms:title "tolerance induction intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo intervention experiment that tests the ability of the intervention to decrease an immune response." .

OBI:0001984 a owl:Class ;
    rdfs:label "OBI:0001984" ;
    dcterms:title "treatment intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vivo intervention experiment in which the ability of the intervention to reduce or cure the effects of a disease are tested." .

OBI:0001985 a owl:Class ;
    rdfs:label "OBI:0001985" ;
    dcterms:title "microarray assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay where binding of the analyte to immobilized matrix is measured." .

OBI:0001986 a owl:Class ;
    rdfs:label "OBI:0001986" ;
    dcterms:title "immunohistochemistry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
