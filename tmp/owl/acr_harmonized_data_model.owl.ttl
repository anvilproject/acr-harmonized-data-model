    dcterms:title "HMMER2" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "HMMER profile HMM file for HMMER versions 2.x." .

edam:format_3329 a owl:Class ;
    rdfs:label "edam:format_3329" ;
    dcterms:title "HMMER3" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "HMMER profile HMM file for HMMER versions 3.x." .

edam:format_3330 a owl:Class ;
    rdfs:label "edam:format_3330" ;
    dcterms:title "PO" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "PO is the output format of Partial Order Alignment program (POA) performing Multiple Sequence Alignment (MSA)." .

edam:format_3331 a owl:Class ;
    rdfs:label "edam:format_3331" ;
    dcterms:title "BLAST XML results format" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "XML format as produced by the NCBI Blast package." .

edam:format_3462 a owl:Class ;
    rdfs:label "edam:format_3462" ;
    dcterms:title "CRAM" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "Reference-based compression of alignment format." .

edam:format_3464 a owl:Class ;
    rdfs:label "edam:format_3464" ;
    dcterms:title "JSON" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
    skos:definition "JavaScript Object Notation format; a lightweight, text-based format to represent tree-structured data using key-value pairs." .

edam:format_3466 a owl:Class ;
    rdfs:label "edam:format_3466" ;
    dcterms:title "EPS" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumEDAMFormats,
        linkml:PermissibleValue ;
