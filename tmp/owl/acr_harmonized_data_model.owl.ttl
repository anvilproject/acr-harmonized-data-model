OBI:0001657 a owl:Class ;
    rdfs:label "OBI:0001657" ;
    dcterms:title "ELISA measuring binding of a B cell epitope:antibody complex" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
