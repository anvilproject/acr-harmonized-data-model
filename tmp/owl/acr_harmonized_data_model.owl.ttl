edam:topic_3292 a owl:Class ;
    rdfs:label "edam:topic_3292" ;
    dcterms:title "Biochemistry" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Chemical substances and physico-chemical processes and that occur within living organisms." .

edam:topic_3293 a owl:Class ;
    rdfs:label "edam:topic_3293" ;
    dcterms:title "Phylogenetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The study of evolutionary relationships amongst organisms from analysis of genetic information (typically gene or protein sequences)." .

edam:topic_3295 a owl:Class ;
    rdfs:label "edam:topic_3295" ;
    dcterms:title "Epigenetics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Topic concerning the study of heritable changes, for example in gene expression or phenotype, caused by mechanisms other than changes in the DNA sequence." .

edam:topic_3297 a owl:Class ;
    rdfs:label "edam:topic_3297" ;
    dcterms:title "Biotechnology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "The exploitation of biological process, structure and function for industrial purposes, for example the genetic manipulation of microorganisms for the antibody production." .

edam:topic_3298 a owl:Class ;
    rdfs:label "edam:topic_3298" ;
    dcterms:title "Phenomics" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
    skos:definition "Phenomes, or the study of the change in phenotype (the physical and biochemical traits of organisms) in response to genetic and environmental factors." .

edam:topic_3299 a owl:Class ;
    rdfs:label "edam:topic_3299" ;
    dcterms:title "Evolutionary biology" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumDataCategory,
        linkml:PermissibleValue ;
