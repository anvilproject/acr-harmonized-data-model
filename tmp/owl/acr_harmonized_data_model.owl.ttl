OBI:0001145 a owl:Class ;
    rdfs:label "OBI:0001145" ;
    dcterms:title "3D structure determination of bound molecular complex assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A 3D molecular structure determination assay in which a complex of 2 or more molecular enties is characterized which provides information on their binding configuration." .

OBI:0001146 a owl:Class ;
    rdfs:label "OBI:0001146" ;
    dcterms:title "binding assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay with the objective to characterize the disposition of two or more material entities to form a complex." .

OBI:0001158 a owl:Class ;
    rdfs:label "OBI:0001158" ;
    dcterms:title "age determination assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the duration of part of the life of an organism, where the initial time point is the beginning of some transitional state (such as birth or when planted)." .

OBI:0001170 a owl:Class ;
    rdfs:label "OBI:0001170" ;
    dcterms:title "reverse transcription polymerase chain reaction assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the concentration of RNA in a sample in which an RNA strand is first reverse transcribed into its DNA complement (complementary DNA, or cDNA) using the enzyme reverse transcriptase, and the resulting cDNA is amplified using traditional or real-time PCR." .

OBI:0001177 a owl:Class ;
    rdfs:label "OBI:0001177" ;
    dcterms:title "RNA sequencing assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the sequence of an RNA molecule." .

OBI:0001178 a owl:Class ;
    rdfs:label "OBI:0001178" ;
    dcterms:title "efficacy of epitope intervention experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that tests  if inducing an epitope specific immune response in an organism has an effect, such as the ability to prevent, treat or exacerbate diseases in the organism." .

OBI:0001179 a owl:Class ;
    rdfs:label "OBI:0001179" ;
    dcterms:title "epitope protection from infectious challenge experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An epitope protection experiment in which the ability of the epitope to protect the host from an infection is assessed." .

OBI:0001183 a owl:Class ;
    rdfs:label "OBI:0001183" ;
    dcterms:title "epitope protection from tumor challenge experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An epitope protection experiment in which the ability of the epitope to protect the host from developing tumors is assessed." .

OBI:0001184 a owl:Class ;
    rdfs:label "OBI:0001184" ;
    dcterms:title "epitope protection experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of epitope intervention experiment that tests the efficacy of inducing an immune epitope response to prevent disease in a host." .

OBI:0001186 a owl:Class ;
    rdfs:label "OBI:0001186" ;
    dcterms:title "epitope protection from infectious challenge experiment based on pathogen burden" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An epitope protection from infectious challenge experiment in which the readout is a reduction in the presence of pathogens in the host compared to controls." .

OBI:0001187 a owl:Class ;
    rdfs:label "OBI:0001187" ;
    dcterms:title "infectious agent detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that measures the presence or amount of an infectious agent in an evaluant" .

OBI:0001188 a owl:Class ;
    rdfs:label "OBI:0001188" ;
    dcterms:title "epitope disease exacerbation experiment" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An efficacy of epitope intervention experiment that tests the ability of inducing an epitope immune response to increase the severity of an existing disease in the host." .

OBI:0001189 a owl:Class ;
    rdfs:label "OBI:0001189" ;
    dcterms:title "epitope protection experiment based on survival" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
