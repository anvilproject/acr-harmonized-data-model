    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An analyte assay that measures the abundance of urea nitrogen." .

OBI:0003911 a owl:Class ;
    rdfs:label "OBI:0003911" ;
    dcterms:title "urea nitrogen concentration assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A urea nitrogen assay that measures the abundance of urea nitrogen in a specimen" .

OBI:0003912 a owl:Class ;
    rdfs:label "OBI:0003912" ;
    dcterms:title "in vitro CRISPR screen using single-cell ATAC-seq" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An in vitro CRISPR screen assay that uses single-cell ATAC-Seq to detect induced changes in chromatin accessibility" .

OBI:0003913 a owl:Class ;
    rdfs:label "OBI:0003913" ;
    dcterms:title "single-cell metabolically labeled new RNA tagging sequencing" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-cell transcription profiling by RNA sequencing assay in which mRNA transcripts are metabolically labeled with 4-thiouridine to investigate temporal RNA dynamics." .

OBI:0003914 a owl:Class ;
    rdfs:label "OBI:0003914" ;
    dcterms:title "single cell massively parallel reporter assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A massively parallel reporter assay in which libraries of reporter constructs are transfected into samples and then measured via single cell transcriptomic methods to enable discovery of cell-specific transcriptional regulatory activity" .

OBI:0003915 a owl:Class ;
    rdfs:label "OBI:0003915" ;
    dcterms:title "ultra high throughput single-cell combinatorial indexing RNA sequencing 3 assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A single-cell transcription profiling by RNA sequencing assay that involves single cell combinatorial indexing ('sci-') to profile the transcriptomes of single cells or nuclei in an ultra high-throughput manor via changes to the method, as compared to sci-RNA-seq, that include extraction of nuclei directly from fresh tissue, use of hairpin ligation for the third level of indexing, optimization of enxymatic reactions, and use of dilution instead of FACS sorting." .

OBI:0302736 a owl:Class ;
    rdfs:label "OBI:0302736" ;
    dcterms:title "DNA damage comet assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A cell based DNA damage assay that measures DNA damage (DNA breakage) in eucaryotic cells exposed to a challenge by determining the size and shape of DNA migration by detecting fluorescently labeled DNA from a cell placed in an electric field using gel electrophoresis" .

OBI:0302737 a owl:Class ;
    rdfs:label "OBI:0302737" ;
    dcterms:title "PCR-SSCP assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that identifies DNA sequence variation (mutation, deletion, insertions) in target DNA sequences amplified using polymerase chain reaction using gel electrophoresis and denaturating conditions" .

OBI:0600002 a owl:Class ;
    rdfs:label "OBI:0600002" ;
    dcterms:title "tumor grading" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that determines the grade (severity/stage) of a tumor sample, used in cancer biology to describe abnormalities/qualities of tumor cells or tissues. Values can be described by terms from NCI Thesaurus." .

OBI:0600017 a owl:Class ;
    rdfs:label "OBI:0600017" ;
    dcterms:title "assay detecting a molecular label" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects the presence or a quality of a molecular label which is a proxy for the detection of the molecular target to which the label is attached" .

OBI:0600020 a owl:Class ;
    rdfs:label "OBI:0600020" ;
    dcterms:title "histological assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that uses visual examination of cells or tissue (or images of them) to make an assessment regarding a quality of the cells or tissue. This assay can include steps of staining, imaging, and judgement." .

OBI:0600025 a owl:Class ;
    rdfs:label "OBI:0600025" ;
    dcterms:title "substance detection assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "An assay that detects a specified substance" .

OBI:0600026 a owl:Class ;
