OBI:0001016 a owl:Class ;
    rdfs:label "OBI:0001016" ;
    dcterms:title "DNASE 1 structure mapping assay" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
