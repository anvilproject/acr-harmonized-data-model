OBI:0001643 a owl:Class ;
    rdfs:label "OBI:0001643" ;
    dcterms:title "assay measuring epitope specific immunoglobulin-mediated neutralization" ;
    rdfs:subClassOf acr_harmonized_data_model:EnumAssayType,
        linkml:PermissibleValue ;
    skos:definition "A B cell epitope dependent biological activity determination assay that detects neutralization of the antigen." .

OBI:0001644 a owl:Class ;
    rdfs:label "OBI:0001644" ;
    dcterms:title "assay measuring epitope specific opsonization" ;
